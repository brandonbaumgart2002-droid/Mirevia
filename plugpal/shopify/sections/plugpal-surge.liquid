{%- comment -%}
  Plug-Pal page, surge protection. Styles: assets/plugpal-pdp.css (loaded by the Plug-Pal fold section). Every word is editable in the theme editor.
{%- endcomment -%}
<div class="pp-scope">
<section class="pp-section pp-section--{{ section.settings.style }} pp-surge" id="surge">
<div class="pp-wrap">
<div class="pp-section-head">
{%- if section.settings.eyebrow != blank -%}<p class="pp-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
{%- if section.settings.heading != blank -%}<h2 class="pp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
{%- if section.settings.text != blank -%}<p class="pp-lede">{{ section.settings.text }}</p>{%- endif -%}
</div>
{%- liquid
  assign cur = cart.currency.iso_code
  assign items = section.blocks | where: 'type', 'item'
  assign total = ''
  assign note = section.settings.note
  if cur == 'USD'
    assign total = section.settings.total_amount
  elsif cur == 'CAD'
    assign total = section.settings.total_amount_cad
    assign note = section.settings.note_cad
  endif
-%}
{%- assign specs = section.blocks | where: 'type', 'spec' -%}
{%- if items.size > 0 -%}
<div class="pp-surge__grid">
{%- for block in items -%}
{%- liquid
  assign dp = ''
  if cur == 'USD'
    assign dp = block.settings.price
  elsif cur == 'CAD'
    assign dp = block.settings.price_cad
  endif
-%}
<div class="pp-surge__item" {{ block.shopify_attributes }}><svg class="pp-icon"><use href="#i-{{ block.settings.icon }}"/></svg><b>{{ block.settings.name | escape }}</b>{%- if dp != blank -%}<span>{{ dp | escape }} <small class="pp-cur">{{ cur }}</small></span>{%- endif -%}</div>
{%- endfor -%}
</div>
{%- endif -%}
{%- if total != blank -%}<div class="pp-surge__total"><span>{{ section.settings.total_before | escape }}</span><b>{{ total | escape }} <small class="pp-cur">{{ cur }}</small></b><span>{{ section.settings.total_after | escape }}</span></div>{%- endif -%}
{%- if specs.size > 0 -%}
<ul class="pp-surge__specs">
{%- for block in specs -%}
<li {{ block.shopify_attributes }}><svg class="pp-icon"><use href="#i-{{ block.settings.icon }}"/></svg><span>{{ block.settings.text | escape }}</span></li>
{%- endfor -%}
</ul>
{%- endif -%}
{%- if section.settings.button_label != blank -%}
{%- capture po -%}{%- render 'plugpal-per-outlet' -%}{%- endcapture -%}
<div class="pp-surge__cta"><a class="pp-btn pp-btn--sm" href="#plugpal-top" data-pick="{{ section.settings.button_pack }}">{{ section.settings.button_label | escape | replace: '[per_outlet]', po }}</a></div>
{%- endif -%}
{%- if note != blank -%}<p class="pp-surge__note">{{ note }}</p>{%- endif -%}
</div>
</section>
</div>
{% schema %}
