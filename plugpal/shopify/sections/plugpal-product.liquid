l":"Key"},{"value":"cart","label":"Cart"},{"value":"list","label":"List"}]},{"type":"text","id":"text","label":"Text","default":"9 ports from 1 outlet"}]},{"type":"accordion","name":"Drop-down","settings":[{"type":"text","id":"title","label":"Title","default":"Details"},{"type":"textarea","id":"specs","label":"Spec table (optional)","info":"One per line, as Label: value"},{"type":"richtext","id":"content","label":"Text"}]}],"enabled_on":{"templates":["product"]}}
