{%- comment -%}
  Plug-Pal page, fold: gallery, buy box and sticky bar. The other Plug-Pal sections need this one on the page (it loads the styles, icons and script). Styles: assets/plugpal-pdp.css (loaded by the Plug-Pal fold section). Every word is editable in the theme editor.
{%- endcomment -%}
{{ 'plugpal-pdp.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,800&family=Poppins:ital,wght@0,700;0,800;1,800&display=swap">
{%- style -%}
:is(#plugpal,.pp-scope) .pp-rate{gap:6px;padding:3px 7px;font-size:12.5px;line-height:1.3;white-space:nowrap;max-width:100%}
:is(#plugpal,.pp-scope) .pp-rate__stars i{width:14px;height:14px;font-size:9.5px}
:is(#plugpal,.pp-scope) .pp-guarantee .pp-pay{list-style:none;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:6px}
:is(#plugpal,.pp-scope) .pp-guarantee .pp-pay li{display:block;line-height:0}
:is(#plugpal,.pp-scope) .pp-guarantee .pp-pay svg{width:38px;height:24px;display:block}
@media (max-width:600px){:is(#plugpal,.pp-scope) .pp-rate{font-size:12px}:is(#plugpal,.pp-scope) .pp-guarantee .pp-pay svg{width:34px;height:22px}}
{%- endstyle -%}
<div id="plugpal" class="pp-scope">
<div class="pp-root{% if section.settings.draft_mode %} pp-draft{% endif %}">
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
<symbol id="i-outlet" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M9 8v3M15 8v3M10.5 17v-1.5a1.5 1.5 0 0 1 3 0V17z"/></symbol>
<symbol id="i-usb" viewBox="0 0 24 24"><path d="M12 3v14M12 13l-4-3V7.5M12 11l4-3V6"/><circle cx="12" cy="19" r="2"/><circle cx="8" cy="6" r="1.5"/><path d="M14.8 3.8h2.5v2.5h-2.5z"/></symbol>
<symbol id="i-screw" viewBox="0 0 24 24"><circle cx="12" cy="6.5" r="3.5"/><path d="M10.3 6.5h3.4M10.5 10v8.5l1.5 2.5 1.5-2.5V10M10.5 13.5h3M10.5 16.5h3"/></symbol>
<symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></symbol>
<symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></symbol>
<symbol id="i-tool" viewBox="0 0 24 24"><path d="M14.5 3.5l6 6-2.5 2.5-6-6zM12 6L4.5 13.5a2.1 2.1 0 0 0 0 3l3 3a2.1 2.1 0 0 0 3 0L18 12"/></symbol>
