{%- comment -%}
Plug-Pal product page (template: product.plugpal). One self-contained section, laid out like Blomar in the Plug-Pal palette:
fold (gallery + buy box with a review card), UGC videos, How it works, surge protection, rooms, comparison, reviews, FAQ, email signup.
Styles: assets/plugpal-pdp.css plus the block below (scoped to #plugpal). Behaviour: assets/plugpal-pdp.js and the review-card script near the end.
Packs: the buy button adds the variant whose options match the colour and the pack size (1 / 3 / 6).
The heading is the product title: first word plain, the rest in amber italics.
{%- endcomment -%}
{{ 'plugpal-pdp.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,800&family=Poppins:ital,wght@0,700;0,800;1,800&display=swap">
{%- style -%}
#plugpal{--poppins:"Poppins","Inter",system-ui,sans-serif}
#plugpal .pp-buy{gap:12px}
#plugpal .pp-fold-left{text-align:left}
#plugpal .pp-rate{align-self:flex-start;display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:4px;padding:4px 8px;font-size:14px;color:var(--navy);text-decoration:none;background:#fff}
#plugpal .pp-rate__stars{display:inline-flex;gap:2px}
#plugpal .pp-rate__stars i{width:16px;height:16px;background:var(--gold);color:#fff;display:grid;place-items:center;font-style:normal;font-size:11px;line-height:1}
#plugpal .pp-rate b{font-weight:800 !important}
#plugpal .pp-rating{justify-content:flex-start}
#plugpal .pp-title{margin:0;font-family:var(--poppins) !important;font-weight:800 !important;font-size:clamp(30px,3vw,38px);line-height:1.1;letter-spacing:-.02em;color:var(--navy) !important;text-align:left;text-transform:none}
#plugpal .pp-title em{font-family:var(--poppins) !important;font-style:italic;color:var(--gold)}
#plugpal .pp-buy__sub{margin:0;max-width:none;text-align:left;font-size:15.5px;line-height:1.5;color:var(--ink);font-weight:400 !important}
#plugpal .pp-buy__sub b{color:var(--amber-ink);font-weight:800 !important}
#plugpal .pp-perks{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 14px}
#plugpal .pp-perk{display:flex;align-items:center;gap:10px;text-align:left;min-width:0}
#plugpal .pp-perk__ico{flex:none;width:36px;height:36px;border-radius:50%;background:var(--navy);color:var(--glow);display:grid;place-items:center;font-size:18px;box-shadow:0 3px 10px var(--glow-soft)}
#plugpal .pp-perk b{font-size:13px;line-height:1.25;color:var(--navy);font-weight:700 !important}
#plugpal .pp-offer{border:2px solid var(--navy);border-radius:8px;padding:12px 14px 14px;text-align:center;background:#fff}
#plugpal .pp-offer__title{margin:0;font-size:16px;font-weight:800 !important;letter-spacing:.01em;text-transform:uppercase;color:var(--amber-ink)}
#plugpal .pp-offer__text{margin:6px auto 0;font-size:14.5px;line-height:1.45;color:var(--ink);max-width:40ch}
#plugpal .pp-offer__bar{margin:12px 0 0;height:10px;border-radius:99px;background:#ebe8e2;overflow:hidden}
#plugpal .pp-offer__bar i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--gold),var(--amber-ink))}
#plugpal .pp-offer__sold{margin:8px 0 0;font-weight:800 !important;font-size:15px;color:var(--amber-ink)}
#plugpal .pp-colour-head{margin:2px 0 0;font-family:var(--poppins) !important;font-size:18px;font-weight:800 !important;color:var(--navy);text-align:left}
#plugpal .pp-swatches--circles{justify-content:flex-start;gap:18px;margin-top:-2px}
#plugpal .pp-swatches--circles .pp-swatch{flex-direction:column;gap:6px;padding:0;border:0;background:none;border-radius:0;box-shadow:none;font-size:13.5px;font-weight:700 !important;color:var(--navy);cursor:pointer}
#plugpal .pp-swatch__dot{width:56px;height:56px;border-radius:50%;display:grid;place-items:center;overflow:hidden;background:var(--sw);border:1.5px solid #d8d3cb;box-shadow:0 0 0 3px #fff,0 0 0 4.5px transparent;transition:box-shadow .15s}
#plugpal .pp-swatch__dot img{width:100%;height:100%;object-fit:cover;transform:scale(1.25);border-radius:0}
#plugpal .pp-swatches--circles .pp-swatch[aria-checked="true"]{border:0;box-shadow:none;color:var(--amber-ink)}
#plugpal .pp-swatches--circles .pp-swatch[aria-checked="true"] .pp-swatch__dot{border-color:var(--gold);box-shadow:0 0 0 3px #fff,0 0 0 5px var(--gold),0 0 18px 6px var(--glow-soft)}
#plugpal .pp-swatches--circles .pp-swatch:focus-visible .pp-swatch__dot{outline:2px solid var(--navy);outline-offset:6px}
#plugpal .pp-bundle__img{overflow:hidden;background:#fff;border:1px solid var(--line)}
#plugpal .pp-bundle__img img{width:100%;height:100%;object-fit:contain;border-radius:0}
#plugpal .pp-bundle__name{font-family:var(--poppins) !important;font-weight:700 !important}
#plugpal .pp-btn.pp-btn--buy{text-transform:none;font-size:18px;letter-spacing:0;padding:17px 20px}
#plugpal .pp-guarantee{border-width:2px;padding:14px 16px 12px}
#plugpal .pp-guarantee .pp-guarantee__lead{font:800 21px/1.15 var(--poppins) !important;text-transform:none;color:var(--amber-ink) !important}
#plugpal .pp-guarantee p{margin:4px 0 0;font-size:14px}
#plugpal .pp-guarantee .pp-trust{gap:8px;padding-block:10px;margin-top:10px}
#plugpal .pp-guarantee .pp-trust div{font-size:12.5px;gap:4px}
#plugpal .pp-guarantee .pp-trust .pp-icon{font-size:20px;color:var(--amber-ink)}
#plugpal .pp-guarantee .pp-pay{margin-top:10px;gap:4px}
#plugpal .pp-guarantee .pp-pay span{font-size:9.5px !important;padding:5px 6px;min-width:34px}
#plugpal .pp-buy .pp-acc__btn{justify-content:flex-start;text-align:left;padding:13px 30px 13px 2px;font-weight:600 !important;font-size:15px}
#plugpal .pp-buy .pp-acc__btn .pp-chev{color:var(--amber-ink)}
#plugpal .pp-buy .pp-acc__panel{text-align:left;padding:0 2px 14px}
#plugpal .pp-buy .pp-acc__panel ul,#plugpal .pp-buy .pp-acc__panel ol{list-style-position:outside;padding-left:18px}
#plugpal .pp-buy .pp-spec{text-align:left}
#plugpal .pp-rv{border:2px solid var(--gold);border-radius:var(--r);padding:16px 18px;text-align:left;background:#fff}
#plugpal .pp-rv__top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
#plugpal .pp-rv__name{display:block;font-family:var(--poppins) !important;font-weight:800 !important;font-size:16px;color:var(--navy)}
#plugpal .pp-rv__stars{display:inline-flex;gap:2px;margin-top:4px}
#plugpal .pp-rv__stars i{width:18px;height:18px;background:var(--gold);color:#fff;display:grid;place-items:center;font-style:normal;font-size:12px;line-height:1}
#plugpal .pp-rv__stars i.pp-off{background:#e3ded6}
#plugpal .pp-rv__nav{display:flex;gap:8px}
#plugpal .pp-rv__nav button{width:34px;height:34px;border-radius:50%;border:0;background:var(--gold);color:var(--navy);display:grid;place-items:center;font-size:16px}
#plugpal .pp-rv__quote{margin:12px 0 0;padding:0;border:0;font-size:15px;line-height:1.5;color:var(--ink)}
#plugpal .pp-rv__foot{display:flex;align-items:center;gap:6px;margin-top:10px;font-size:13px;color:var(--muted)}
#plugpal .pp-rv__foot .pp-icon{color:var(--amber-ink);font-size:16px}
#plugpal .pp-band{height:12px;background:var(--gold)}
#plugpal .pp-h2{margin:0;font-family:var(--poppins) !important;font-weight:800 !important;font-size:clamp(28px,4vw,44px);line-height:1.12;letter-spacing:-.02em;color:var(--navy) !important;text-align:center;text-transform:none;text-wrap:balance}
#plugpal .pp-h2 em{font-family:var(--poppins) !important;font-style:italic;color:var(--amber-ink)}
#plugpal .pp-section--navy .pp-h2{color:#fff !important}
#plugpal .pp-section--navy .pp-h2 em{color:var(--gold)}
#plugpal .pp-feats{list-style:none;padding:0;margin:0 auto;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:26px 20px;max-width:620px}
#plugpal .pp-feat{display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center;min-width:0}
#plugpal .pp-feat__ico{width:62px;height:62px;border-radius:50%;background:var(--gold);color:var(--navy);display:grid;place-items:center;font-size:28px;box-shadow:0 6px 20px var(--glow-soft);margin-bottom:6px}
#plugpal .pp-feat h3{margin:0;font-family:var(--poppins) !important;font-weight:800 !important;font-size:19px;color:var(--navy) !important}
#plugpal .pp-feat p{margin:0;font-size:14.5px;line-height:1.5;color:var(--muted);max-width:30ch}
#plugpal .pp-cmp{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(20px,4vw,48px);align-items:center;max-width:980px;margin:0 auto}
#plugpal .pp-cmp__head .pp-lede{margin-top:10px}
#plugpal .pp-cmp__table{width:100%;border-collapse:separate;border-spacing:0;font-size:14px}
#plugpal .pp-cmp__table th,#plugpal .pp-cmp__table td{padding:14px 12px;text-align:center;vertical-align:middle;border-bottom:1px solid var(--line);background:#fff}
#plugpal .pp-cmp__table thead th{background:transparent;border:0;font-size:13px;font-weight:600 !important;color:var(--muted);padding-bottom:10px}
#plugpal .pp-cmp__table thead th.pp-cmp__us{background:var(--navy);color:var(--gold);font:800 italic 18px/1.1 var(--poppins) !important;border-radius:12px 12px 0 0;padding-top:16px}
#plugpal .pp-cmp__table tbody th{text-align:left;font-weight:400 !important;width:56%}
#plugpal .pp-cmp__table tbody th b{display:block;font-size:12.5px;font-weight:800 !important;letter-spacing:.04em;text-transform:uppercase;color:var(--navy)}
#plugpal .pp-cmp__table tbody th span{display:block;margin-top:2px;color:var(--muted);font-size:13.5px;line-height:1.35}
#plugpal .pp-cmp__table td.pp-cmp__us{background:var(--navy);color:var(--gold);width:22%}
#plugpal .pp-cmp__table tbody tr:last-child td.pp-cmp__us{border-radius:0 0 12px 12px}
#plugpal .pp-cmp__table td{color:#9b968d;font-size:22px;width:22%}
#plugpal .pp-cmp__table td .pp-icon{width:24px;height:24px}
#plugpal .pp-cmp__note{text-align:center;font-size:12.5px;color:var(--muted);margin:12px 0 0}
#plugpal .pp-faq .pp-acc__item{background:#fff;border:1px solid var(--line);border-radius:10px;margin-bottom:10px}
#plugpal .pp-faq.pp-acc{border-top:0}
#plugpal .pp-faq .pp-acc__btn{justify-content:flex-start;text-align:left;font-weight:700 !important;font-size:15.5px;padding:18px 44px 18px 18px}
#plugpal .pp-faq .pp-acc__btn .pp-chev{right:16px;color:var(--amber-ink)}
#plugpal .pp-faq .pp-acc__panel{text-align:left;padding:0 18px 16px}
#plugpal .pp-sub__form{max-width:560px;margin:20px auto 0}
#plugpal .pp-sub__row{display:flex;align-items:center;border:1px solid var(--line);border-radius:8px;padding:5px 5px 5px 16px;background:#fff}
#plugpal .pp-sub__row input{flex:1;min-width:0;border:0;height:40px;font-size:15px;background:transparent;color:var(--ink);outline:none}
#plugpal .pp-sub__row button{flex:none;width:42px;height:40px;border:0;border-radius:6px;background:var(--navy);color:#fff;display:grid;place-items:center;font-size:20px}
#plugpal .pp-reviews .pp-tm__all{margin-top:8px}
#plugpal .pp-rating .jdgm-preview-badge{display:flex;justify-content:flex-start}
@media (max-width:860px){#plugpal .pp-cmp{grid-template-columns:minmax(0,1fr)}}
@media (max-width:600px){#plugpal .pp-title{font-size:30px}
#plugpal .pp-buy__sub{font-size:15px}
#plugpal .pp-perk b{font-size:12.5px}
#plugpal .pp-offer__title{font-size:14.5px}
#plugpal .pp-offer__text{font-size:13.5px}
#plugpal .pp-feats{gap:22px 12px}
#plugpal .pp-feat__ico{width:54px;height:54px;font-size:24px}
#plugpal .pp-feat h3{font-size:16.5px}
#plugpal .pp-feat p{font-size:13.5px}
#plugpal .pp-cmp__table th,#plugpal .pp-cmp__table td{padding:12px 8px}
#plugpal .pp-cmp__table thead th.pp-cmp__us{font-size:15px}
#plugpal .pp-faq .pp-acc__btn{font-size:14.5px;padding:15px 40px 15px 14px}}
{%- endstyle -%}
