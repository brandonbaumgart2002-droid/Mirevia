<script>
(function () {
  var root = document.getElementById('plugpal');
  if (!root) return;
  var box = root.querySelector('[data-tm]'), track = root.querySelector('[data-tm-track]'), area = root.querySelector('#reviews');
  if (!box || !track || !area) return;
  var MAX = 12, built = false;
  function txt(el, sel) { var n = el.querySelector(sel); return n ? n.textContent.trim() : ''; }
  function build() {
    if (built) return true;
    var revs = area.querySelectorAll('.jdgm-rev');
    if (!revs.length) return false;
    built = true;
    Array.prototype.slice.call(revs, 0, MAX).forEach(function (r) {
      var body = txt(r, '.jdgm-rev__body');
      if (!body) return;
      var card = document.createElement('figure');
      card.className = 'pp-tm__card';
      var img = r.querySelector('.jdgm-rev__pics img, img.jdgm-rev__pic-img');
      if (img) {
        var src = img.getAttribute('data-src') || img.getAttribute('src');
        if (src) { var i = document.createElement('img'); i.src = src; i.alt = ''; i.loading = 'lazy'; card.appendChild(i); }
      }
      var scoreEl = r.querySelector('[data-score]');
      var score = scoreEl ? Math.round(parseFloat(scoreEl.getAttribute('data-score'))) : 0;
      if (score > 0) {
        var s = document.createElement('span');
        s.className = 'pp-stars';
        s.setAttribute('aria-label', score + ' out of 5 stars');
        s.textContent = '★★★★★'.slice(0, score) + '☆☆☆☆☆'.slice(0, 5 - score);
        card.appendChild(s);
      }
      var head = txt(r, '.jdgm-rev__title');
      if (head) { var t = document.createElement('b'); t.className = 'pp-tm__head'; t.textContent = head; card.appendChild(t); }
      var q = document.createElement('blockquote');
      q.className = 'pp-tm__body';
      q.textContent = body.length > 280 ? body.slice(0, 277).replace(/\s+\S*$/, '') + '…' : body;
      card.appendChild(q);
      var who = document.createElement('figcaption');
      who.className = 'pp-tm__who';
      var nb = document.createElement('b');
      nb.textContent = txt(r, '.jdgm-rev__author') || 'Customer';
      who.appendChild(nb);
      var ts = r.querySelector('.jdgm-rev__timestamp');
      var d = ts ? (ts.getAttribute('data-content') || ts.textContent || '').trim() : '';
      if (/^\d{4}-\d{2}-\d{2}/.test(d)) { var dt = new Date(d.slice(0, 10) + 'T12:00:00'); if (!isNaN(dt)) d = dt.toLocaleDateString(undefined, { day: 'numeric', month: 'long', year: 'numeric' }); }
      if (d) who.appendChild(document.createTextNode(' · ' + d));
      card.appendChild(who);
      if (r.getAttribute('data-verified-buyer') === 'true') {
        var v = document.createElement('span'); v.className = 'pp-tm__ver'; v.textContent = '✓ Verified buyer'; card.appendChild(v);
      }
      // Keep Judge.me's disclosure for reviews imported from another provider.
      if (r.querySelector('.jdgm-rev__transparency-badge[data-badge-type="review_collected_from_another_provider"]')) {
        var src2 = document.createElement('span'); src2.className = 'pp-tm__src'; src2.textContent = 'Collected by our previous review provider'; card.appendChild(src2);
      }
      track.appendChild(card);
    });
    if (track.children.length) box.hidden = false;
    return true;
  }
  function step(dir) {
    var c = track.querySelector('.pp-tm__card');
    if (c) track.scrollBy({ left: dir * (c.getBoundingClientRect().width + 16), behavior: 'smooth' });
  }
  var prev = root.querySelector('[data-tm-prev]'), next = root.querySelector('[data-tm-next]');
  if (prev) prev.addEventListener('click', function () { step(-1); });
  if (next) next.addEventListener('click', function () { step(1); });
  if (!build()) {
    // Judge.me often renders its widget only when it scrolls into view, so keep watching until it does.
    var mo = new MutationObserver(function () { if (build()) mo.disconnect(); });
    mo.observe(area, { childList: true, subtree: true });
  }
})();
</script>
