<symbol id="i-plug" viewBox="0 0 24 24"><path d="M9 2v5M15 2v5M6 7h12v4a6 6 0 0 1-12 0zM12 17v5"/></symbol>
<symbol id="i-laptop" viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="11" rx="1.5"/><path d="M2 19h20"/></symbol>
<symbol id="i-key" viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M17 6l3 3M15 8l2 2"/></symbol>
<symbol id="i-phone" viewBox="0 0 24 24"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/></symbol>
<symbol id="i-game" viewBox="0 0 24 24"><path d="M7 8h10a4 4 0 0 1 4 4l.5 4a2.5 2.5 0 0 1-4.5 1.5L15.5 16h-7L7 17.5A2.5 2.5 0 0 1 2.5 16L3 12a4 4 0 0 1 4-4z"/><path d="M7.5 11v3M6 12.5h3M15.5 12h.01M17.5 13.5h.01"/></symbol>
<symbol id="i-wifi" viewBox="0 0 24 24"><path d="M2.5 9a14 14 0 0 1 19 0M5.5 12.5a9.5 9.5 0 0 1 13 0M8.5 16a5 5 0 0 1 7 0"/><circle cx="12" cy="19.5" r="1"/></symbol>
<symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></symbol>
<symbol id="i-image" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-9 9"/></symbol>
<symbol id="i-cart" viewBox="0 0 24 24"><path d="M3 4h2.5l2.2 10.5h10.6L20.5 7H6.4"/><circle cx="9.5" cy="19" r="1.5"/><circle cx="17" cy="19" r="1.5"/></symbol>
</svg>
<section class="pp-pdp" id="plugpal-top">
<div class="pp-wrap pp-pdp__grid">
<div class="pp-gallery" data-gallery>
<div class="pp-gallery__stage">
<span class="pp-gallery__count" data-gallery-count>1 / 8</span>
<button class="pp-gallery__arrow pp-gallery__arrow--prev" type="button" aria-label="Previous image" data-gallery-prev><svg class="pp-icon"><use href="#i-left"/></svg></button>
<button class="pp-gallery__arrow pp-gallery__arrow--next" type="button" aria-label="Next image" data-gallery-next><svg class="pp-icon"><use href="#i-right"/></svg></button>
<div class="pp-gallery__slide pp-is-on">
{%- render 'plugpal-media', img: section.settings.img_gallery_1, fallback: product.images[0], width: 1400, eager: true, alt: "Plug-Pal on a wall outlet with phones and a lamp plugged in" -%}
<div class="pp-hero-tile">
<div class="pp-hero-tile__top">
<div class="pp-hero-tile__kicker">No electrician · No wiring · No power strip</div>
<div class="pp-hero-tile__big">One outlet.<br><span>Nine ports.</span></div>
</div>
<div class="pp-hero-tile__chips">
<span class="pp-hero-chip"><svg class="pp-icon"><use href="#i-outlet"/></svg>5 outlets</span>
<span class="pp-hero-chip"><svg class="pp-icon"><use href="#i-usb"/></svg>4 USB</span>
<span class="pp-hero-chip"><svg class="pp-icon"><use href="#i-moon"/></svg>Night light</span>
</div>
</div>
<div class="pp-ph" style="justify-content:center;padding-top:40px"><svg class="pp-icon pp-ph__icon" style="font-size:96px"><use href="#i-outlet"/></svg><span class="pp-ph__tag">Add hero photo</span></div>
</div>
</div>
<div class="pp-gallery__slide">{%- render 'plugpal-media', img: section.settings.img_gallery_2, fallback: product.images[1], width: 1400, alt: "Before and after: a crowded two-socket outlet, then Plug-Pal with nine ports" -%}<div class="pp-ph"><svg class="pp-icon pp-ph__icon"><use href="#i-plug"/></svg><span class="pp-ph__tag">Before / after</span><span class="pp-ph__text">Crowded 2-socket outlet with an adapter pile, then Plug-Pal with 5 plugs and 4 cables in use.</span></div></div></div>
<div class="pp-gallery__slide">{%- render 'plugpal-media', img: section.settings.img_gallery_3, fallback: product.images[2], width: 1400, alt: "Three-step install: remove the screw, plug in, screw it in" -%}<div class="pp-ph"><svg class="pp-icon pp-ph__icon"><use href="#i-tool"/></svg><span class="pp-ph__tag">Install in 3 frames</span><span class="pp-ph__text">Screwdriver removes the centre screw. Unit plugs in. Long screw locks it flat.</span></div></div></div>
<div class="pp-gallery__slide">{%- render 'plugpal-media', img: section.settings.img_gallery_4, fallback: product.images[3], width: 1400, dark: true, alt: "Plug-Pal night light glowing in a dark hallway" -%}<div class="pp-ph"><svg class="pp-icon pp-ph__icon"><use href="#i-moon"/></svg><span class="pp-ph__tag">Night light</span><span class="pp-ph__text">Dark hallway at 3am. Soft glow from the outlet lights the floor to the bathroom.</span></div></div></div>
<div class="pp-gallery__slide">{%- render 'plugpal-media', img: section.settings.img_gallery_5, fallback: product.images[4], width: 1400, alt: "A cheap cube adapter sagging out of the wall next to a screw-locked Plug-Pal" -%}<div class="pp-ph"><svg class="pp-icon pp-ph__icon"><use href="#i-screw"/></svg><span class="pp-ph__tag">Wobbly cube vs screw-locked</span><span class="pp-ph__text">A cheap cube sagging out of a worn outlet, next to Plug-Pal sitting flat and screwed in.</span></div></div></div>
<div class="pp-gallery__slide">{%- render 'plugpal-media', img: section.settings.img_gallery_6, fallback: product.images[5], width: 1400, alt: "Kitchen coffee station with coffee maker and two phones charging" -%}<div class="pp-ph"><svg class="pp-icon pp-ph__icon"><use href="#i-coffee"/></svg><span class="pp-ph__tag">Coffee station</span><span class="pp-ph__text">Coffee maker and two phones charging from one counter outlet. Clean counter, no strip.</span></div></div></div>
<div class="pp-gallery__slide">{%- render 'plugpal-media', img: section.settings.img_gallery_7, fallback: product.images[6], width: 1400, alt: "Plug-Pal dimensions shown on a combination plate next to a light switch" -%}<div class="pp-ph"><svg class="pp-icon pp-ph__icon"><use href="#i-ruler"/></svg><span class="pp-ph__tag">Size and fit</span><span class="pp-ph__text">Dimensions drawn on, mounted next to a light switch so buyers see it doesn't block it.</span></div></div></div>
<div class="pp-gallery__slide">{%- render 'plugpal-media', img: section.settings.img_gallery_8, fallback: product.images[7], width: 1400, alt: "What's in the box: Plug-Pal, long screw and install card" -%}<div class="pp-ph"><svg class="pp-icon pp-ph__icon"><use href="#i-box"/></svg><span class="pp-ph__tag">In the box</span><span class="pp-ph__text">Plug-Pal, long 6-32 mounting screw and the install and load-guide card.</span></div></div></div>
</div>
<div class="pp-gallery__thumbs" role="tablist" aria-label="Product images" data-gallery-thumbs></div>
</div>
<div class="pp-buy">
{%- liquid
  assign r_count = product.metafields.reviews.rating_count.value | default: 0
  assign t_words = product.title | split: ' '
  assign t_lead = t_words | first
  assign t_rest = product.title | remove_first: t_lead | strip
  assign perks = section.blocks | where: 'type', 'perk'
  assign accs = section.blocks | where: 'type', 'accordion'
-%}
{%- if section.settings.show_rating -%}
<div class="pp-rating" id="rating">
{%- if r_count > 0 -%}
{%- capture rr -%}{{ product.metafields.reviews.rating.value.rating | round: 1 }}{%- endcapture -%}
{%- capture rc -%}{{ r_count }}{%- endcapture -%}
<a href="{{ section.settings.rating_link | default: '#pp-rv' }}" class="pp-rate">{%- if section.settings.rating_stars -%}<span class="pp-rate__stars" aria-hidden="true"><i>&#9733;</i><i>&#9733;</i><i>&#9733;</i><i>&#9733;</i><i>&#9733;</i></span>{%- endif -%}<span>{{ section.settings.rating_text | replace: '[rating]', rr | replace: '[count]', rc }}</span></a>
{%- else -%}
<div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}" data-template="product" data-auto-install="false">{{ product.metafields.judgeme.badge }}</div>
{%- endif -%}
</div>
{%- endif -%}
<h1 class="pp-title">{% if t_rest != blank %}{{ t_lead | escape }} <em>{{ t_rest | escape }}</em>{% else %}<em>{{ product.title | escape }}</em>{% endif %}<span class="pp-sr"> {{ section.settings.title_suffix | escape }}</span></h1>
{%- if section.settings.subtitle != blank -%}<p class="pp-buy__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
{%- if perks.size > 0 -%}
<ul class="pp-perks">
{%- for block in perks -%}
<li class="pp-perk" {{ block.shopify_attributes }}><span class="pp-perk__ico"><svg class="pp-icon"><use href="#i-{{ block.settings.icon }}"/></svg></span><b>{{ block.settings.text | escape }}</b></li>
{%- endfor -%}
</ul>
{%- endif -%}
{%- if section.settings.offer_title != blank -%}
<div class="pp-offer">
<p class="pp-offer__title">{% if section.settings.offer_emoji != blank %}<span aria-hidden="true">{{ section.settings.offer_emoji | escape }}</span> {% endif %}{{ section.settings.offer_title | escape }}</p>
{%- if section.settings.offer_text != blank -%}<p class="pp-offer__text">{{ section.settings.offer_text | escape }}</p>{%- endif -%}
{%- if section.settings.offer_sold > 0 -%}
<div class="pp-offer__bar" role="img" aria-label="{{ section.settings.offer_sold }}% sold"><i style="width:{{ section.settings.offer_sold }}%"></i></div>
<p class="pp-offer__sold">{{ section.settings.offer_sold }}% SOLD</p>
{%- endif -%}
</div>
{%- endif -%}
{%- liquid
  assign sw_white = nil
  assign sw_black = nil
  assign pk_1 = nil
  assign pk_3 = nil
  assign pk_6 = nil
  assign pv_1 = nil
  assign pv_3 = nil
  assign pv_6 = nil
  assign v6 = nil
  assign cur = cart.currency.iso_code
  for v in product.variants
    assign vt = v.title | downcase
    if vt contains 'white' and sw_white == blank and v.featured_image
      assign sw_white = v.featured_image
    endif
    if vt contains 'black' and sw_black == blank and v.featured_image
      assign sw_black = v.featured_image
    endif
    if vt contains 'white' or product.variants.size < 4
      if vt contains '1 pack' and pv_1 == blank
        assign pk_1 = v.featured_image
        assign pv_1 = v
      elsif vt contains '3 pack' and pv_3 == blank
        assign pk_3 = v.featured_image
        assign pv_3 = v
      elsif vt contains '6 pack' and pv_6 == blank
        assign pk_6 = v.featured_image
        assign pv_6 = v
      endif
    endif
    if vt contains '6 pack' and v6 == blank
      assign v6 = v
    endif
  endfor
-%}
{%- if section.settings.colour_label != blank -%}<p class="pp-colour-head">{{ section.settings.colour_label | escape }}</p>{%- endif -%}
<div class="pp-swatches pp-swatches--circles" role="radiogroup" aria-label="Colour" data-colours>
<button class="pp-swatch" type="button" role="radio" aria-checked="true" data-colour="white"><span class="pp-swatch__dot" style="--sw:#f7f8fa">{%- if sw_white -%}<img src="{{ sw_white | image_url: width: 160 }}" alt="" width="56" height="56" loading="eager">{%- endif -%}</span><span class="pp-swatch__name">White</span></button>
<button class="pp-swatch" type="button" role="radio" aria-checked="false" data-colour="black"><span class="pp-swatch__dot" style="--sw:#1d2230">{%- if sw_black -%}<img src="{{ sw_black | image_url: width: 160 }}" alt="" width="56" height="56" loading="eager">{%- endif -%}</span><span class="pp-swatch__name">Black</span></button>
</div>
<div class="pp-bundles" role="radiogroup" aria-label="Choose a pack" data-bundles>
<button class="pp-bundle" type="button" role="radio" aria-checked="false" data-qty="1">
{%- if section.settings.pack_1_badge != blank -%}<span class="pp-bundle__badge">{{ section.settings.pack_1_badge | escape }}</span>{%- endif -%}
<span class="pp-bundle__radio" aria-hidden="true"></span>
<span class="pp-bundle__img" aria-hidden="true">{%- if pk_1 -%}<img src="{{ pk_1 | image_url: width: 160 }}" alt="" data-pack-img>{%- else -%}&times;1{%- endif -%}</span>
<span class="pp-bundle__name">{{ section.settings.pack_1_name | escape }}</span>
{%- render 'plugpal-pack-price', variant: pv_1, single: pv_1, qty: 1, fallback_now: section.settings.price_1 -%}
</button>
<button class="pp-bundle" type="button" role="radio" aria-checked="false" data-qty="3">
{%- if section.settings.pack_3_badge != blank -%}<span class="pp-bundle__badge">{{ section.settings.pack_3_badge | escape }}</span>{%- endif -%}
<span class="pp-bundle__radio" aria-hidden="true"></span>
<span class="pp-bundle__img" aria-hidden="true">{%- if pk_3 -%}<img src="{{ pk_3 | image_url: width: 160 }}" alt="" data-pack-img>{%- else -%}&times;3{%- endif -%}</span>
<span class="pp-bundle__name">{{ section.settings.pack_3_name | escape }}</span>
{%- render 'plugpal-pack-price', variant: pv_3, single: pv_1, qty: 3, fallback_now: section.settings.price_2, fallback_was: section.settings.was_2 -%}
</button>
<button class="pp-bundle" type="button" role="radio" aria-checked="true" data-qty="6">
{%- if section.settings.pack_6_badge != blank -%}<span class="pp-bundle__badge pp-bundle__badge--gold">{{ section.settings.pack_6_badge | escape }}</span>{%- endif -%}
<span class="pp-bundle__radio" aria-hidden="true"></span>
<span class="pp-bundle__img" aria-hidden="true">{%- if pk_6 -%}<img src="{{ pk_6 | image_url: width: 160 }}" alt="" data-pack-img>{%- else -%}&times;6{%- endif -%}</span>
<span class="pp-bundle__name">{{ section.settings.pack_6_name | escape }}</span>
{%- render 'plugpal-pack-price', variant: pv_6, single: pv_1, qty: 6, fallback_now: section.settings.price_4, fallback_was: section.settings.was_4 -%}
</button>
</div>
{%- if section.settings.show_gifts -%}
<div>
{%- if section.settings.gifts_label != blank -%}<p class="pp-gifts__label">{{ section.settings.gifts_label | escape }}</p>{%- endif -%}
<div class="pp-gifts" data-gifts>
{%- if section.settings.gift_1_name != blank -%}<div class="pp-gift" data-min="3"><span class="pp-gift__tag">Free</span><span class="pp-gift__ico"><svg class="pp-icon"><use href="#i-truck"/></svg></span><b>{{ section.settings.gift_1_name | escape }}</b><span class="pp-gift__state" data-state></span></div>{%- endif -%}
{%- if section.settings.gift_2_name != blank -%}<div class="pp-gift" data-min="3"><span class="pp-gift__tag">Free{% liquid
  assign gv = ''
  if cur == 'USD'
    assign gv = section.settings.gift_2_value
  elsif cur == 'CAD'
    assign gv = section.settings.gift_2_value_cad
  endif
%}{% if gv != blank %} <s class="pp-verify">{{ gv | escape }}</s>{% endif %}</span><span class="pp-gift__ico"><svg class="pp-icon"><use href="#i-screw"/></svg></span><b class="pp-verify">{{ section.settings.gift_2_name | escape }}</b><span class="pp-gift__state" data-state></span></div>{%- endif -%}
{%- if section.settings.gift_3_name != blank -%}<div class="pp-gift" data-min="6"><span class="pp-gift__tag">Free{% liquid
  assign gv = ''
  if cur == 'USD'
    assign gv = section.settings.gift_3_value
  elsif cur == 'CAD'
    assign gv = section.settings.gift_3_value_cad
  endif
%}{% if gv != blank %} <s class="pp-verify">{{ gv | escape }}</s>{% endif %}</span><span class="pp-gift__ico"><svg class="pp-icon"><use href="#i-clip"/></svg></span><b class="pp-verify">{{ section.settings.gift_3_name | escape }}</b><span class="pp-gift__state" data-state></span></div>{%- endif -%}
</div>
<p class="pp-gifts__note" data-gifts-note aria-live="polite"></p>
</div>
{%- endif -%}
{%- if section.settings.ships_text != blank -%}<p class="pp-ships pp-verify">{{ section.settings.ships_text | escape }}</p>{%- endif -%}
<button class="pp-btn pp-btn--block pp-btn--buy" type="button" data-buy><svg class="pp-icon"><use href="#i-cart"/></svg>{{ section.settings.button_label | escape }}</button>
{%- if section.settings.show_guarantee -%}
<div class="pp-guarantee">
{%- if section.settings.guarantee_title != blank -%}<h2 class="pp-guarantee__lead">{{ section.settings.guarantee_title | escape }}</h2>{%- endif -%}
{%- if section.settings.guarantee_text != blank -%}<p>{{ section.settings.guarantee_text | escape }}</p>{%- endif -%}
<div class="pp-trust">
{%- if section.settings.trust_1 != blank -%}<div><svg class="pp-icon"><use href="#i-shield"/></svg>{{ section.settings.trust_1 | escape }}</div>{%- endif -%}
{%- if section.settings.delivery_text != blank -%}<div><svg class="pp-icon"><use href="#i-truck"/></svg><span class="pp-verify">{{ section.settings.delivery_text | escape }}</span></div>{%- endif -%}
{%- if section.settings.trust_3 != blank -%}<div><svg class="pp-icon"><use href="#i-tool"/></svg>{{ section.settings.trust_3 | escape }}</div>{%- endif -%}
</div>
{%- if section.settings.show_payments and shop.enabled_payment_types.size > 0 -%}<ul class="pp-pay" aria-label="Payment methods">{%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}</ul>{%- endif -%}
</div>
{%- endif -%}
{%- if accs.size > 0 -%}
<div class="pp-acc" data-acc>
{%- for block in accs -%}
<div class="pp-acc__item" {{ block.shopify_attributes }}><button class="pp-acc__btn" type="button" aria-expanded="false">{{ block.settings.title | escape }}<svg class="pp-icon pp-chev"><use href="#i-down"/></svg></button>
<div class="pp-acc__panel" hidden>
{%- render 'plugpal-specs', specs: block.settings.specs -%}
{{ block.settings.content }}
</div></div>
{%- endfor -%}
</div>
{%- endif -%}
{%- if section.settings.show_review_card -%}
<div class="pp-rv" id="pp-rv" data-rv data-verified-label="{{ section.settings.rv_verified_label | escape }}" hidden>
<div class="pp-rv__top"><div><b class="pp-rv__name" data-rv-name></b><span class="pp-rv__stars" data-rv-stars></span></div>
<div class="pp-rv__nav"><button type="button" aria-label="Previous review" data-rv-prev><svg class="pp-icon"><use href="#i-left"/></svg></button><button type="button" aria-label="Next review" data-rv-next><svg class="pp-icon"><use href="#i-right"/></svg></button></div></div>
<blockquote class="pp-rv__quote" data-rv-quote></blockquote>
<p class="pp-rv__foot" data-rv-foot></p>
</div>
<template data-rv-src>{{ product.metafields.judgeme.widget }}</template>
{%- endif -%}
</div>
</div>
</section>
{%- if section.settings.show_sticky -%}
<div class="pp-sticky-bar" data-sticky aria-hidden="true">
<div class="pp-wrap pp-sticky-bar__row">
<span class="pp-sticky-bar__thumb"><svg class="pp-icon"><use href="#i-outlet"/></svg></span>
<div class="pp-sticky-bar__info"><b data-sticky-name>{{ section.settings.pack_6_name | escape }}</b><span data-sticky-price>{% if v6 != blank %}{{ v6.price | money }} {{ cart.currency.iso_code }}{% else %}{{ section.settings.price_4 }}{% endif %}</span></div>
<button class="pp-btn pp-btn--sm" type="button" data-buy tabindex="-1">{{ section.settings.sticky_label | escape }}</button>
</div>
</div>
{%- endif -%}
<div class="pp-toast" data-toast role="status" hidden></div>
<script type="application/json" id="plugpal-data">
{
"product": {{ product | json }},
"moneyFormat": {{ shop.money_format | json }},
"currency": {{ cart.currency.iso_code | json }},
"cartAdd": {{ routes.cart_add_url | append: '.js' | json }},
"checkout": "/checkout",
"afterAdd": {{ section.settings.after_add | json }},
"cartUrl": {{ routes.cart_url | json }}
}
</script>
</div>
</div>
<script src="{{ 'plugpal-pdp.js' | asset_url }}" defer></script>
{% schema %}
{"name":"Plug-Pal fold","tag":"section","class":"plugpal-section","settings":[{"type":"paragraph","content":"Plug-Pal fold: gallery and buy box. The name comes from the product title (first word plain, the rest in amber italics). Perks and the drop-downs under the button are blocks: add, remove, reorder or edit them on the left."},{"type":"checkbox","id":"draft_mode","label":"Highlight claims to check (draft)","default":false,"info":"Shows unverified claims in yellow. Keep it off when the page is live."},{"type":"select","id":"after_add","label":"Buy button goes to","default":"checkout","options":[{"value":"checkout","label":"Checkout"},{"value":"cart","label":"Cart page"}]},{"type":"header","content":"Review rating above the name"},{"type":"checkbox","id":"show_rating","label":"Show the rating","default":true},{"type":"checkbox","id":"rating_stars","label":"Show the stars","default":true},{"type":"inline_richtext","id":"rating_text","label":"Rating text","default":"<strong>Excellent</strong> [rating]/5 | [count] Reviews","info":"[rating] and [count] are filled in from Judge.me, so they always match your real reviews. Bold words show in bold."},{"type":"text","id":"rating_link","label":"Rating links to","default":"#pp-rv","info":"#pp-rv scrolls to the review card. Use #reviews if you add the Plug-Pal reviews section back."},{"type":"paragraph","content":"If the product has no reviews yet, the Judge.me star badge shows here instead."},{"type":"header","content":"Name and sub-text"},{"type":"text","id":"title_suffix","label":"Rest of the product name (screen readers and search only)","default":"9-Port Outlet Extender with Night Light"},{"type":"inline_richtext","id":"subtitle","label":"Sub-text under the name","default":"The outlet upgrade that turns one crowded socket into <strong>9 surge-protected ports</strong>, ready in 30 seconds. No electrician.","info":"Bold words show in amber."},{"type":"header","content":"Offer box"},{"type":"text","id":"offer_emoji","label":"Emoji before the offer name","default":"🔥"},{"type":"text","id":"offer_title","label":"Offer name","default":"Early Black Friday Sale – Limited Stock","info":"Leave blank to hide the box."},{"type":"text","id":"offer_text","label":"Offer text","default":"Black Friday prices are on now, ahead of the rush. Stock at these prices is limited."},{"type":"range","id":"offer_sold","label":"Percentage sold bar","min":0,"max":100,"step":1,"unit":"%","default":0,"info":"0 hides the bar. Only enter a figure that matches your real stock."},{"type":"header","content":"Colour and packs"},{"type":"text","id":"colour_label","label":"Colour heading","default":"Choose your colour:"},{"type":"text","id":"pack_1_name","label":"1 Pack name","default":"1 Pack"},{"type":"text","id":"pack_1_badge","label":"1 Pack badge"},{"type":"text","id":"pack_3_name","label":"3 Pack name","default":"3 Pack"},{"type":"text","id":"pack_3_badge","label":"3 Pack badge","default":"Most popular"},{"type":"text","id":"pack_6_name","label":"6 Pack name","default":"6 Pack"},{"type":"text","id":"pack_6_badge","label":"6 Pack badge","default":"Best value"},{"type":"paragraph","content":"Pack prices come from the variants, in each market's currency (USD in the US, CAD in Canada). The prices below only show if a pack has no variant: name variants so each pack option contains 1, 3 or 6 (e.g. \"3 Pack\")."},{"type":"text","id":"price_1","label":"1 Pack price","default":"$36.99"},{"type":"text","id":"price_2","label":"3 Pack price","default":"$73.99"},{"type":"text","id":"was_2","label":"3 Pack, was","default":"$110.97"},{"type":"text","id":"price_4","label":"6 Pack price","default":"$114.99"},{"type":"text","id":"was_4","label":"6 Pack, was","default":"$221.94"},{"type":"header","content":"Free gifts"},{"type":"checkbox","id":"show_gifts","label":"Show free gifts","default":true},{"type":"paragraph","content":"Display only. Add the gifts to orders yourself (or with a gift app) until they are set up as products. Leave a name blank to hide that gift."},{"type":"text","id":"gifts_label","label":"Gifts heading","default":"Unlock free gifts with bundles"},{"type":"text","id":"gift_1_name","label":"Gift 1 (3+ pack)","default":"Free shipping"},{"type":"text","id":"gift_2_name","label":"Gift 2 (3+ pack)","default":"Deep-plate long-screw kit"},{"type":"text","id":"gift_2_value","label":"Gift 2 value (US, USD)","default":"$6.99"},{"type":"text","id":"gift_2_value_cad","label":"Gift 2 value (Canada, CAD)","default":"$9.99"},{"type":"text","id":"gift_3_name","label":"Gift 3 (6-pack)","default":"Cord-tidy clip set"},{"type":"text","id":"gift_3_value","label":"Gift 3 value (US, USD)","default":"$9.99"},{"type":"text","id":"gift_3_value_cad","label":"Gift 3 value (Canada, CAD)","default":"$13.99","info":"Gift values show only in the matching market."},{"type":"header","content":"Button and guarantee"},{"type":"text","id":"ships_text","label":"Line above the button","default":"Ships in 1–3 Business Days"},{"type":"text","id":"button_label","label":"Buy button","default":"Secure Checkout - Buy Now"},{"type":"checkbox","id":"show_guarantee","label":"Show the guarantee box","default":true},{"type":"text","id":"guarantee_title","label":"Guarantee heading","default":"30-Day Money Back Guarantee"},{"type":"text","id":"guarantee_text","label":"Guarantee text","default":"More outlets in 30 seconds, or your money back."},{"type":"text","id":"trust_1","label":"Trust item 1","default":"Secure Checkout"},{"type":"text","id":"delivery_text","label":"Trust item 2 (delivery)","default":"Delivered in 6–12 Days"},{"type":"text","id":"trust_3","label":"Trust item 3","default":"No Electrician"},{"type":"checkbox","id":"show_payments","label":"Show payment methods","default":true,"info":"Shows the icons for the payment methods turned on in Settings > Payments."},{"type":"header","content":"Review card"},{"type":"checkbox","id":"show_review_card","label":"Show the review card under the drop-downs","default":true,