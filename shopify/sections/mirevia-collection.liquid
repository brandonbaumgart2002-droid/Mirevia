{%- comment -%}
  Home page: a small, hand-picked set of products. Swipeable on mobile, a grid on desktop.
{%- endcomment -%}

{{ 'mirevia-pdp.css' | asset_url | stylesheet_tag }}

{%- if section.settings.products.size > 0 -%}
  <section class="mv mv-shelf mv-surface--{{ section.settings.surface }}">
    <div class="mv-container">
      {%- if section.settings.heading != blank -%}
        <h2 class="mv-h2 mv-shelf__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="mv-lead mv-shelf__intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}

      <ul class="mv-shelf__list" role="list">
        {%- for p in section.settings.products -%}
          <li class="mv-shelf__item">
            <a class="mv-shelf__card" href="{{ p.url }}">
              <span class="mv-shelf__media">
                {%- if p.featured_media -%}
                  {%- if forloop.index <= 2 %}{% assign img_loading = 'eager' %}{% else %}{% assign img_loading = 'lazy' %}{% endif -%}
                  {{ p.featured_media | image_url: width: 800 | image_tag: loading: img_loading, sizes: '(min-width: 990px) 25vw, 70vw', widths: '400, 600, 800', alt: p.featured_media.alt | default: p.title }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'mv-placeholder' }}
                {%- endif -%}
              </span>
              <span class="mv-shelf__title">{{ p.title | remove: 'Mirevia™ ' | escape }}</span>
              <span class="mv-shelf__price">{% if p.price_varies %}From {% endif %}{{ p.price | money }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Mirevia: product shelf",
  "tag": "div",
  "class": "mv-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the long nights" },
    { "type": "text", "id": "intro", "label": "Intro" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 8 },
    {
      "type": "select", "id": "surface", "label": "Background", "default": "parchment",
      "options": [ { "value": "canvas", "label": "White" }, { "value": "parchment", "label": "Blush cream" } ]
    }
  ],
  "presets": [{ "name": "Mirevia: product shelf" }]
}
{% endschema %}
