{{ 'mirevia-pdp.css' | asset_url | stylesheet_tag }}

{%- capture yes -%}<span class="mv-compare__yes" aria-hidden="true">✓</span><span class="mv-visually-hidden">Yes</span>{%- endcapture -%}
{%- capture no -%}<span class="mv-compare__no" aria-hidden="true">–</span><span class="mv-visually-hidden">No</span>{%- endcapture -%}

<section class="mv mv-compare mv-surface--{{ section.settings.surface }}">
  <div class="mv-container mv-compare__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="mv-h2">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="mv-compare__scroll" tabindex="0" role="region" aria-label="{{ section.settings.heading | default: 'Comparison' | escape }}">
      <table class="mv-compare__table">
        <thead>
          <tr>
            <td></td>
            <th scope="col" class="mv-compare__ours">{{ section.settings.col_1 | escape }}</th>
            <th scope="col">{{ section.settings.col_2 | escape }}</th>
            <th scope="col">{{ section.settings.col_3 | escape }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature | escape }}</th>
              {%- for i in (1..3) -%}
                {%- assign key = 'col_' | append: i -%}
                {%- assign value = block.settings[key] | strip -%}
                {%- assign value_down = value | downcase -%}
                <td{% if i == 1 %} class="mv-compare__ours"{% endif %}>
                  {%- if value_down == 'yes' -%}{{ yes }}{%- elsif value_down == 'no' -%}{{ no }}{%- else -%}{{ value | escape }}{%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mirevia comparison",
  "tag": "div",
  "class": "mv-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why it beats a hot water bottle" },
    { "type": "text", "id": "col_1", "label": "Your column", "default": "Mirevia" },
    { "type": "text", "id": "col_2", "label": "Column 2", "default": "Hot water bottle" },
    { "type": "text", "id": "col_3", "label": "Column 3", "default": "Heat patch" },
    {
      "type": "select", "id": "surface", "label": "Background", "default": "canvas",
      "options": [
        { "value": "canvas", "label": "White" },
        { "value": "parchment", "label": "Soft grey" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Cordless and wearable" },
        { "type": "paragraph", "content": "Type yes or no for a tick or dash, or any short text." },
        { "type": "text", "id": "col_1", "label": "Your column", "default": "yes" },
        { "type": "text", "id": "col_2", "label": "Column 2", "default": "no" },
        { "type": "text", "id": "col_3", "label": "Column 3", "default": "yes" }
      ]
    }
  ],
  "presets": [
    { "name": "Mirevia comparison", "blocks": [{ "type": "row" }] }
  ]
}
{% endschema %}
