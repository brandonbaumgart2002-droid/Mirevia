{%- comment -%}
  Mirevia product page: gallery + sticky buy box + floating add-to-bag bar.
  Structure follows the Therabody PDP; visual rules come from DESIGN.md.
{%- endcomment -%}

{{ 'mirevia-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mirevia-pdp.js' | asset_url }}" defer></script>
{%- unless section.settings.use_theme_fonts -%}
  {%- comment -%} Only downloaded on devices without SF (Android, Windows). {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap">
{%- endunless -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'mv-form-' | append: section.id
  assign installments_id = 'mv-installments-' | append: section.id
  assign swatch_lines = section.settings.swatches | newline_to_br | split: '<br />'
  assign has_rating = false
  if product.metafields.reviews.rating.value != blank
    assign has_rating = true
  endif
-%}

<style>
  :root {
    --mv-accent: {{ section.settings.accent }};
    --mv-accent-on-dark: {{ section.settings.accent_on_dark }};
    --mv-sticky-offset: {{ section.settings.sticky_offset }}px;
    {%- if section.settings.use_theme_fonts %}
      --mv-font-display: var(--font-heading-family);
      --mv-font-body: var(--font-body-family);
    {%- endif %}
  }
</style>

<section
  class="mv mv-product"
  id="mv-product-{{ section.id }}"
  data-mv-product
  data-after-add="{{ section.settings.after_add }}"
>
  <script type="application/json" data-mv-product-json>
    {
      "moneyFormat": {{ shop.money_format | json }},
      "variants": {{ product.variants | json }}
    }
  </script>

  <div class="mv-container mv-product__grid">
    {%- comment -%} Gallery {%- endcomment -%}
    <div class="mv-gallery" data-mv-gallery style="--mv-media-ratio: {{ section.settings.media_ratio }}; --mv-media-fit: {{ section.settings.media_fit }};">
      <div class="mv-gallery__track" data-mv-gallery-track tabindex="0" role="region" aria-label="{{ product.title | escape }} images">
        {%- for media in product.media -%}
          <figure class="mv-gallery__slide" data-media-id="{{ media.id }}" id="mv-media-{{ section.id }}-{{ media.id }}">
            {%- if media.media_type == 'image' -%}
              {%- liquid
                if forloop.first
                  assign loading = 'eager'
                  assign priority = 'high'
                else
                  assign loading = 'lazy'
                  assign priority = 'auto'
                endif
              -%}
              {{
                media
                | image_url: width: 1800
                | image_tag:
                  loading: loading,
                  fetchpriority: priority,
                  sizes: '(min-width: 990px) 56vw, 100vw',
                  widths: '600, 900, 1200, 1500, 1800',
                  class: 'mv-gallery__img'
              }}
            {%- else -%}
              {{ media | media_tag: image_size: '1800x', class: 'mv-gallery__img' }}
            {%- endif -%}
          </figure>
        {%- else -%}
          <figure class="mv-gallery__slide">
            {{ 'product-1' | placeholder_svg_tag: 'mv-gallery__img mv-placeholder' }}
          </figure>
        {%- endfor -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="mv-gallery__thumbs" role="group" aria-label="Choose image">
          {%- for media in product.media -%}
            <button
              type="button"
              class="mv-gallery__thumb{% if forloop.first %} is-active{% endif %}"
              data-mv-thumb="{{ media.id }}"
              aria-controls="mv-media-{{ section.id }}-{{ media.id }}"
              aria-label="Show image {{ forloop.index }} of {{ forloop.length }}"
              {% if forloop.first %}aria-current="true"{% endif %}
            >
              {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '', width: 90, height: 90 }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Buy box {%- endcomment -%}
    <div class="mv-buybox">
      <div class="mv-buybox__inner">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'greeting' -%}
              {%- if customer and customer.first_name != blank -%}
                {%- assign first_name = customer.first_name | escape -%}
                <p class="mv-greeting" {{ block.shopify_attributes }}>
                  {{ block.settings.text | escape | replace: '[name]', first_name }}
                </p>
              {%- endif -%}

            {%- when 'title' -%}
              <div class="mv-title" {{ block.shopify_attributes }}>
                <h1 class="mv-title__heading">{{ product.title | escape }}</h1>
                {%- if block.settings.tagline != blank -%}
                  <p class="mv-title__tagline">{{ block.settings.tagline | escape }}</p>
                {%- endif -%}
              </div>

            {%- when 'rating' -%}
              {%- if has_rating -%}
                {%- liquid
                  assign rating = product.metafields.reviews.rating.value
                  assign rating_pct = rating.rating | divided_by: rating.scale_max | times: 100
                  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
                -%}
                <a class="mv-rating" href="{{ block.settings.reviews_anchor | default: '#reviews' }}" {{ block.shopify_attributes }}>
                  <span class="mv-rating__stars" style="--mv-rating: {{ rating_pct }}%;" aria-hidden="true"></span>
                  <span class="mv-rating__text">
                    {{ rating.rating | round: 1 }}
                    <span class="mv-visually-hidden">out of {{ rating.scale_max }} stars,</span>
                    {%- if rating_count > 0 %} · {{ rating_count }} reviews{% endif -%}
                  </span>
                </a>
              {%- endif -%}

            {%- when 'price' -%}
              {%- liquid
                assign on_sale = false
                if current_variant.compare_at_price > current_variant.price
                  assign on_sale = true
                endif
                assign saving = current_variant.compare_at_price | minus: current_variant.price
              -%}
              <div class="mv-price" {{ block.shopify_attributes }}>
                <p class="mv-price__row">
                  <span class="mv-visually-hidden">Price</span>
                  <span class="mv-price__current" data-mv-price>{{ current_variant.price | money }}</span>
                  <s class="mv-price__compare" data-mv-compare {% unless on_sale %}hidden{% endunless %}>
                    {%- if on_sale %}{{ current_variant.compare_at_price | money }}{% endif -%}
                  </s>
                  {%- if block.settings.show_saving -%}
                    <span class="mv-badge" data-mv-saving {% unless on_sale %}hidden{% endunless %}>
                      Save <span data-mv-saving-amount>{% if on_sale %}{{ saving | money }}{% endif %}</span>
                    </span>
                  {%- endif -%}
                </p>
                {%- if block.settings.show_installments -%}
                  {%- form 'product', product, id: installments_id, class: 'mv-price__installments' -%}
                    <input type="hidden" name="id" value="{{ current_variant.id }}">
                    {{ form | payment_terms }}
                  {%- endform -%}
                {%- endif -%}
              </div>

            {%- when 'personal_note' -%}
              <p class="mv-note" data-mv-personal-note hidden {{ block.shopify_attributes }}>
                <span class="mv-note__label">{{ block.settings.label | escape }}</span>
                <span data-mv-personal-note-text></span>
              </p>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="mv-options-group" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- assign option_name = option.name | downcase -%}
                    {%- if option_name == 'color' or option_name == 'colour' -%}
                      {%- assign is_swatch = true -%}
                    {%- else -%}
                      {%- assign is_swatch = false -%}
                    {%- endif -%}
                    <fieldset class="mv-options" data-mv-option="{{ forloop.index0 }}">
                      <legend class="mv-options__legend">
                        {{ option.name | escape }}<span class="mv-options__value">: <span data-mv-option-value>{{ option.selected_value | escape }}</span></span>
                      </legend>
                      <div class="mv-options__list{% if is_swatch %} mv-options__list--swatches{% endif %}">
                        {%- for value in option.values -%}
                          {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
                          {%- liquid
                            assign swatch = ''
                            if is_swatch
                              if value.swatch.color
                                assign swatch = value.swatch.color
                              else
                                assign value_key = value | downcase | strip
                                for line in swatch_lines
                                  assign parts = line | split: ':'
                                  assign key = parts.first | downcase | strip
                                  if key == value_key and parts.size > 1
                                    assign swatch = parts.last | strip
                                  endif
                                endfor
                              endif
                            endif
                          -%}
                          <input
                            type="radio"
                            class="mv-options__input"
                            id="{{ input_id }}"
                            name="option-{{ section.id }}-{{ option.position }}"
                            value="{{ value | escape }}"
                            {% if option.selected_value == value %}checked{% endif %}
                          >
                          {%- if is_swatch -%}
                            <label for="{{ input_id }}" class="mv-swatch" title="{{ value | escape }}">
                              <span class="mv-swatch__color" style="--mv-swatch: {{ swatch | default: '#d2d2d7' }};{% if value.swatch.image %} background-image: url('{{ value.swatch.image | image_url: width: 80 }}');{% endif %}"></span>
                              <span class="mv-visually-hidden">{{ value | escape }}</span>
                            </label>
                          {%- else -%}
                            <label for="{{ input_id }}" class="mv-chip">{{ value | escape }}</label>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </div>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <div class="mv-buy" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: form_id, class: 'mv-form', novalidate: 'novalidate', data-mv-form: '' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-mv-variant-id>
                  <div class="mv-form__row">
                    {%- if block.settings.show_quantity -%}
                      <label class="mv-qty">
                        <span class="mv-visually-hidden">Quantity</span>
                        <input class="mv-qty__input" type="number" name="quantity" value="1" min="1" inputmode="numeric" autocomplete="off">
                      </label>
                    {%- endif -%}
                    <button
                      type="submit"
                      name="add"
                      class="mv-btn mv-btn--primary mv-btn--block disable-global-button-styling"
                      data-mv-add
                      data-mv-label="{{ block.settings.add_label | escape }}"
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      <span data-mv-add-label>
                        {%- if current_variant.available -%}
                          {{ block.settings.add_label | escape }}
                        {%- else -%}
                          Sold out
                        {%- endif -%}
                      </span>
                    </button>
                  </div>
                  {%- if block.settings.show_dynamic_checkout -%}
                    <div class="mv-form__dynamic">{{ form | payment_button }}</div>
                  {%- endif -%}
                  <p class="mv-form__error" role="alert" data-mv-error hidden></p>
                  <p class="mv-form__status" aria-live="polite" data-mv-status></p>
                {%- endform -%}
              </div>

            {%- when 'perks' -%}
              <ul class="mv-perks" {{ block.shopify_attributes }}>
                {%- for i in (1..3) -%}
                  {%- liquid
                    assign text_key = 'perk_' | append: i
                    assign icon_key = 'perk_' | append: i | append: '_icon'
                    assign text = block.settings[text_key]
                    assign icon = block.settings[icon_key]
                  -%}
                  {%- if text != blank -%}
                    <li class="mv-perks__item">
                      {%- if icon != blank -%}
                        {{ icon | image_url: width: 64 | image_tag: loading: 'lazy', alt: '', width: 24, height: 24, class: 'mv-perks__icon' }}
                      {%- endif -%}
                      <span>{{ text | escape }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'text' -%}
              <div class="mv-rte mv-text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'accordion' -%}
              {%- liquid
                if block.settings.use_description
                  assign acc_body = product.description
                else
                  assign acc_body = block.settings.content
                endif
                assign acc_text = acc_body | strip_html | strip
              -%}
              {%- comment -%} An empty accordion reads as broken, so skip it. {%- endcomment -%}
              {%- if acc_text != blank -%}
                <details class="mv-acc" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                  <summary class="mv-acc__summary">{{ block.settings.heading | escape }}</summary>
                  <div class="mv-acc__body mv-rte">{{ acc_body }}</div>
                </details>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if section.settings.sticky_bar -%}
    <div class="mv-sticky" data-mv-sticky inert>
      <div class="mv-container mv-sticky__inner">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 44, height: 44, class: 'mv-sticky__thumb' }}
        {%- endif -%}
        <div class="mv-sticky__meta">
          <p class="mv-sticky__title">{{ product.title | escape }}</p>
          <p class="mv-sticky__price" data-mv-price>{{ current_variant.price | money }}</p>
        </div>
        <button type="button" class="mv-btn mv-btn--primary disable-global-button-styling" data-mv-sticky-add data-mv-label="{{ section.settings.sticky_label | escape }}" {% unless current_variant.available %}disabled{% endunless %}>
          <span data-mv-add-label>{% if current_variant.available %}{{ section.settings.sticky_label | escape }}{% else %}Sold out{% endif %}</span>
        </button>
      </div>
    </div>
  {%- endif -%}
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media %}
    "image": {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},
    {%- endif %}
    "description": {{ product.description | strip_html | truncate: 500 | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    {%- if has_rating %}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ product.metafields.reviews.rating.value.rating | json }},
      "bestRating": {{ product.metafields.reviews.rating.value.scale_max | json }},
      "reviewCount": {{ product.metafields.reviews.rating_count.value | default: 1 | json }}
    },
    {%- endif %}
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          {%- if variant.sku != blank %}"sku": {{ variant.sku | json }},{% endif %}
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Mirevia product",
  "tag": "div",
  "class": "mv-section",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "color", "id": "accent", "label": "Accent colour", "default": "#8a2f52", "info": "Used for links, selected options and focus rings. Keep one accent across the page." },
    { "type": "color", "id": "accent_on_dark", "label": "Accent on dark backgrounds", "default": "#f2a9c4" },
    { "type": "checkbox", "id": "use_theme_fonts", "label": "Use my theme's fonts", "default": false, "info": "Off: uses the Apple system font stack from DESIGN.md." },
    { "type": "header", "content": "Gallery" },
    {
      "type": "select", "id": "media_ratio", "label": "Image shape", "default": "1",
      "options": [
        { "value": "1", "label": "Square" },
        { "value": "0.8", "label": "Portrait (4:5)" },
        { "value": "1.333", "label": "Landscape (4:3)" }
      ]
    },
    {
      "type": "select", "id": "media_fit", "label": "Image fit", "default": "cover",
      "options": [
        { "value": "cover", "label": "Fill the frame" },
        { "value": "contain", "label": "Show whole image" }
      ]
    },
    { "type": "textarea", "id": "swatches", "label": "Colour swatches", "default": "Navy: #1f2a44\nBlush: #e7c3c6\nBlack: #1d1d1f\nSand: #d8c8b4", "info": "One per line, as Colour name: #hex. Only needed if your colour options don't have Shopify swatches set." },
    { "type": "header", "content": "Buying" },
    {
      "type": "select", "id": "after_add", "label": "After add to bag", "default": "cart",
      "options": [
        { "value": "cart", "label": "Go to cart page" },
        { "value": "stay", "label": "Stay on this page" }
      ]
    },
    { "type": "checkbox", "id": "sticky_bar", "label": "Show floating add-to-bag bar", "default": true },
    { "type": "text", "id": "sticky_label", "label": "Floating bar button label", "default": "Add to bag" },
    { "type": "range", "id": "sticky_offset", "label": "Buy box distance from top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96, "info": "Match your theme's sticky header height." }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "greeting", "name": "Welcome back greeting", "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Welcome back, [name].", "info": "Only shown to logged-in customers. [name] becomes their first name." }
      ]
    },
    {
      "type": "title", "name": "Title", "limit": 1,
      "settings": [
        { "type": "text", "id": "tagline", "label": "Tagline", "default": "Heat and gentle massage for period cramps." }
      ]
    },
    {
      "type": "rating", "name": "Star rating", "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Reads the product's reviews.rating and reviews.rating_count metafields, which most review apps fill in. Hidden when there are no reviews." },
        { "type": "text", "id": "reviews_anchor", "label": "Link to reviews", "default": "#reviews" }
      ]
    },
    {
      "type": "price", "name": "Price", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_saving", "label": "Show saving badge on sale", "default": true },
        { "type": "checkbox", "id": "show_installments", "label": "Show Shop Pay instalments", "default": true }
      ]
    },
    {
      "type": "personal_note", "name": "Personalised note", "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Filled in from the 'Made for you' section when a shopper picks what they need, or arrives from a link with ?for=…" },
        { "type": "text", "id": "label", "label": "Label", "default": "For you:" }
      ]
    },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1, "settings": [] },
    {
      "type": "buy_buttons", "name": "Buy buttons", "limit": 1,
      "settings": [
        { "type": "text", "id": "add_label", "label": "Button label", "default": "Add to bag" },
        { "type": "checkbox", "id": "show_quantity", "label": "Show quantity", "default": false },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show express checkout", "default": true }
      ]
    },
    {
      "type": "perks", "name": "Perks", "limit": 1,
      "settings": [
        { "type": "text", "id": "perk_1", "label": "Perk 1", "default": "Free shipping" },
        { "type": "image_picker", "id": "perk_1_icon", "label": "Perk 1 icon" },
        { "type": "text", "id": "perk_2", "label": "Perk 2", "default": "Easy returns" },
        { "type": "image_picker", "id": "perk_2_icon", "label": "Perk 2 icon" },
        { "type": "text", "id": "perk_3", "label": "Perk 3", "default": "Secure checkout" },
        { "type": "image_picker", "id": "perk_3_icon", "label": "Perk 3 icon" }
      ]
    },
    {
      "type": "text", "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add a short note here.</p>" }
      ]
    },
    {
      "type": "accordion", "name": "Accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Details" },
        { "type": "checkbox", "id": "use_description", "label": "Show product description", "default": false },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add content here.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ]
}
{% endschema %}
