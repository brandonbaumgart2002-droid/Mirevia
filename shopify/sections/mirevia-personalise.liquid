{%- comment -%}
  "Made for you": shoppers pick what they need, or arrive pre-selected from an ad
  link such as ?for=sleep. The choice is remembered and echoed in the buy box.
{%- endcomment -%}

{{ 'mirevia-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mirevia-pdp.js' | asset_url }}" defer></script>

<section class="mv mv-personalise mv-surface--{{ section.settings.surface }}" data-mv-personalise>
  <div class="mv-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="mv-h2 mv-personalise__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="mv-lead mv-personalise__intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="mv-tabs" role="tablist" aria-label="{{ section.settings.heading | default: 'What do you need?' | escape }}">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="mv-chip mv-tabs__tab"
            role="tab"
            id="mv-tab-{{ block.id }}"
            aria-controls="mv-panel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-key="{{ block.settings.key | handleize }}"
            {{ block.shopify_attributes }}
          >
            {{- block.settings.label | escape -}}
          </button>
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        <div
          class="mv-personalise__panel{% if block.settings.image == blank %} mv-personalise__panel--text{% endif %}"
          role="tabpanel"
          id="mv-panel-{{ block.id }}"
          aria-labelledby="mv-tab-{{ block.id }}"
          data-note="{{ block.settings.note | escape }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          {%- if block.settings.image != blank -%}
            <div class="mv-personalise__media">
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400'
              }}
            </div>
          {%- endif -%}
          <div class="mv-personalise__copy">
            <h3 class="mv-h3">{{ block.settings.heading | escape }}</h3>
            <div class="mv-rte mv-body-muted">{{ block.settings.body }}</div>
            {%- if block.settings.tip != blank -%}
              <p class="mv-personalise__tip">{{ block.settings.tip | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="mv-personalise__cta">
        <a class="mv-btn mv-btn--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Mirevia made for you",
  "tag": "div",
  "class": "mv-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for how your cycle feels" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Pick what you need most. We'll show you how to use it." },
    { "type": "text", "id": "button_label", "label": "Button label", "info": "Optional, e.g. on the home page. Leave empty on the product page." },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "surface", "label": "Background", "default": "parchment",
      "options": [
        { "value": "canvas", "label": "White" },
        { "value": "parchment", "label": "Soft grey" }
      ]
    },
    { "type": "paragraph", "content": "Link straight to a tab from an ad: add ?for=<key> to the product URL, e.g. ?for=sleep." }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "Need",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Button label", "default": "Cramps" },
        { "type": "text", "id": "key", "label": "Link key", "default": "cramps", "info": "Used in ?for= links. Lowercase, no spaces." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Warmth where it hurts" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Describe how this customer uses it.</p>" },
        { "type": "text", "id": "tip", "label": "How-to tip" },
        { "type": "text", "id": "note", "label": "Buy box note", "default": "Warmth where it hurts.", "info": "Short line shown in the buy box once this is chosen." },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mirevia made for you",
      "blocks": [
        { "type": "need" }
      ]
    }
  ]
}
{% endschema %}
