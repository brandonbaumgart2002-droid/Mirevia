{%- comment -%}
  Apple-style full-bleed tiles. Each tile is one message; the background change
  between tiles is the divider (DESIGN.md: alternate light and dark).
{%- endcomment -%}

{{ 'mirevia-pdp.css' | asset_url | stylesheet_tag }}

<div class="mv mv-tiles">
  {%- for block in section.blocks -%}
    <section class="mv-tile mv-surface--{{ block.settings.surface }}" {{ block.shopify_attributes }}>
      <div class="mv-container mv-tile__inner">
        <h2 class="mv-display">{{ block.settings.heading | escape }}</h2>
        {%- if block.settings.text != blank -%}
          <p class="mv-lead mv-tile__text">{{ block.settings.text | escape }}</p>
        {%- endif -%}
        {%- if block.settings.link_label != blank and block.settings.link != blank -%}
          <a class="mv-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
        {%- endif -%}
        <div class="mv-tile__media{% if block.settings.product_shadow %} mv-tile__media--product{% endif %}">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 2000
              | image_tag: loading: 'lazy', sizes: '(min-width: 1200px) 1100px, 100vw', widths: '600, 900, 1200, 1600, 2000'
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'mv-placeholder' }}
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Mirevia feature tiles",
  "tag": "div",
  "class": "mv-section",
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "select", "id": "surface", "label": "Background", "default": "canvas",
          "options": [
            { "value": "canvas", "label": "White" },
            { "value": "parchment", "label": "Soft grey" },
            { "value": "dark", "label": "Dark" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Heat that stays steady." },
        { "type": "text", "id": "text", "label": "Text", "default": "No kettle, no cord, no cooling off halfway through." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "checkbox", "id": "product_shadow", "label": "Product cut-out (adds the soft product shadow)", "default": false },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Mirevia feature tiles", "blocks": [{ "type": "tile" }] }
  ]
}
{% endschema %}
