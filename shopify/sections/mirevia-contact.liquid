{%- comment -%}
  Contact page: Shopify's own contact form (messages go to the store's sender email),
  with quick links for the questions people most often write in about.
{%- endcomment -%}

{{ 'mirevia-pdp.css' | asset_url | stylesheet_tag }}

<section class="mv mv-contact mv-surface--{{ section.settings.surface }}">
  <div class="mv-container mv-contact__grid">
    <div class="mv-contact__form-wrap">
      {%- form 'contact', id: 'MvContactForm', class: 'mv-contact__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="mv-contact__notice mv-contact__notice--ok" role="status" tabindex="-1" autofocus>
            {{ section.settings.success_text | escape }}
          </p>
        {%- elsif form.errors -%}
          <p class="mv-contact__notice mv-contact__notice--error" role="alert" tabindex="-1" autofocus>
            Please check the highlighted fields and try again.
          </p>
        {%- endif -%}

        <div class="mv-field-row">
          <label class="mv-field">
            <span class="mv-field__label">Your name</span>
            <input class="mv-field__input" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
          </label>
          <label class="mv-field">
            <span class="mv-field__label">Email <span aria-hidden="true">*</span></span>
            <input class="mv-field__input" type="email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" required aria-required="true"
              {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="MvContactEmailError"{% endif %}
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
            {%- if form.errors contains 'email' -%}
              <span class="mv-field__error" id="MvContactEmailError">Please enter a valid email address.</span>
            {%- endif -%}
          </label>
        </div>
        <label class="mv-field">
          <span class="mv-field__label">Order number <span class="mv-field__optional">(optional)</span></span>
          <input class="mv-field__input" type="text" name="contact[order number]" inputmode="text" value="{{ form['order number'] }}">
        </label>
        <label class="mv-field">
          <span class="mv-field__label">How can we help? <span aria-hidden="true">*</span></span>
          <textarea class="mv-field__input mv-field__input--area" name="contact[body]" rows="6" required aria-required="true">{{ form.body }}</textarea>
        </label>
        <button type="submit" class="mv-btn mv-btn--primary mv-btn--block disable-global-button-styling">{{ section.settings.button_label | escape }}</button>
        {%- if section.settings.small_print != blank -%}
          <p class="mv-contact__small">{{ section.settings.small_print | escape }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>

    <aside class="mv-contact__aside">
      <h2 class="mv-h3">{{ section.settings.aside_heading | escape }}</h2>
      <ul class="mv-contact__links" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a class="mv-contact__link" href="{{ block.settings.link }}">
              <span class="mv-contact__link-title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.text != blank -%}<span class="mv-contact__link-text">{{ block.settings.text | escape }}</span>{%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Mirevia: contact",
  "tag": "div",
  "class": "mv-section",
  "settings": [
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "success_text", "label": "Thank-you message", "default": "Thank you. We've got your message and will be in touch soon." },
    { "type": "text", "id": "small_print", "label": "Small print under the button" },
    { "type": "text", "id": "aside_heading", "label": "Side heading", "default": "Quick answers" },
    {
      "type": "select", "id": "surface", "label": "Background", "default": "canvas",
      "options": [ { "value": "canvas", "label": "White" }, { "value": "parchment", "label": "Blush cream" } ]
    }
  ],
  "blocks": [
    {
      "type": "link", "name": "Quick link",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Mirevia: contact" }]
}
{% endschema %}
