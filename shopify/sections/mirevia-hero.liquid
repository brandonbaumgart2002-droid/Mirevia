{%- comment -%}
  Home page hero: one warm lifestyle photo, one promise, one action.
  Mobile stacks photo then words; desktop lays the words over the photo's quiet side.
{%- endcomment -%}

{{ 'mirevia-pdp.css' | asset_url | stylesheet_tag }}

<section class="mv mv-hero mv-hero--{{ section.settings.card_side }}" style="--mv-hero-focal: {{ section.settings.focal }};">
  <div class="mv-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '600, 900, 1200, 1600, 2000, 2400',
          class: 'mv-hero__img'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'mv-hero__img mv-placeholder' }}
    {%- endif -%}
  </div>

  <div class="mv-hero__content">
    <div class="mv-container">
      <div class="mv-hero__card">
        {%- if section.settings.eyebrow != blank -%}
          <p class="mv-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="mv-display mv-hero__heading">{{ section.settings.heading | escape | newline_to_br }}</h1>
        {%- if section.settings.text != blank -%}
          <p class="mv-lead mv-hero__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="mv-btn mv-btn--primary mv-hero__cta" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.reassurance != blank -%}
          <p class="mv-hero__reassure">{{ section.settings.reassurance | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mirevia: hero",
  "tag": "div",
  "class": "mv-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "A warm, at-home photo. Keep one side quiet for the words." },
    {
      "type": "select", "id": "focal", "label": "Keep this part of the photo in view", "default": "50% 50%",
      "options": [
        { "value": "50% 50%", "label": "Centre" },
        { "value": "30% 50%", "label": "Left" },
        { "value": "70% 50%", "label": "Right" },
        { "value": "50% 0%", "label": "Very top" },
        { "value": "50% 30%", "label": "Top" },
        { "value": "50% 70%", "label": "Bottom" }
      ]
    },
    {
      "type": "select", "id": "card_side", "label": "Words on desktop", "default": "left", "info": "The photo sits on the other side.",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ]
    },
    { "type": "text", "id": "eyebrow", "label": "Small line above the heading" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Melt cramps,\nnot your day." },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop The Melter" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "reassurance", "label": "Small line under the button", "default": "Free shipping · 30-day money-back guarantee" }
  ],
  "presets": [{ "name": "Mirevia: hero" }]
}
{% endschema %}
