{{ 'mirevia-pdp.css' | asset_url | stylesheet_tag }}

<section class="mv mv-highlights mv-surface--dark">
  <div class="mv-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="mv-h2 mv-highlights__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="mv-highlights__list">
      {%- for block in section.blocks -%}
        <li class="mv-highlights__item" {{ block.shopify_attributes }}>
          <p class="mv-highlights__value">{{ block.settings.value | escape }}</p>
          <p class="mv-highlights__label">{{ block.settings.label | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Mirevia highlights",
  "tag": "div",
  "class": "mv-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Relief that goes where you go" }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Big text", "default": "Cordless" },
        { "type": "text", "id": "label", "label": "Small text", "default": "Wear it on the couch, at your desk or in bed." }
      ]
    }
  ],
  "presets": [
    { "name": "Mirevia highlights", "blocks": [{ "type": "highlight" }, { "type": "highlight" }, { "type": "highlight" }] }
  ]
}
{% endschema %}
