{%- comment -%}
  Email sign-up using Shopify's built-in customer form. Sign-ups appear under Customers
  as email subscribers, tagged with the tags below. No app needed.
{%- endcomment -%}
{{ 'readysip-page.css' | asset_url | stylesheet_tag }}

{%- assign form_id = 'rs-news-' | append: section.id -%}
<section class="rs rs-news rs-surface--{{ section.settings.surface }}" id="newsletter">
  <div class="rs-container">
    <div class="rs-news__card">
      {%- if section.settings.eyebrow != blank -%}<p class="rs-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="rs-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="rs-lead">{{ section.settings.text | escape }}</p>{%- endif -%}

      {%- form 'customer', id: form_id, class: 'rs-news__form' -%}
        <input type="hidden" name="contact[tags]" value="{{ section.settings.tags | escape }}">
        {%- if form.posted_successfully? -%}
          <p class="rs-news__success" role="status" tabindex="-1" autofocus>{{ section.settings.success | escape }}</p>
        {%- else -%}
          <div class="rs-news__row">
            <label class="rs-visually-hidden" for="{{ form_id }}-email">Email address</label>
            <input
              class="rs-news__input"
              id="{{ form_id }}-email"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.placeholder | escape }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="{{ form_id }}-error"{% endif %}
            >
            <button type="submit" class="rs-btn rs-btn--cta disable-global-button-styling rs-news__btn">{{ section.settings.button | escape }}</button>
          </div>
          {%- if form.errors -%}
            <p class="rs-news__error" id="{{ form_id }}-error" role="alert">
              {%- for field in form.errors -%}
                {%- if field == 'form' -%}{{ form.errors.messages[field] }}{%- else -%}{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}{%- endif -%}
              {%- endfor -%}
            </p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.fineprint != blank -%}<p class="rs-news__fine">{{ section.settings.fineprint | escape }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ReadySip email sign-up",
  "settings": [
    { "type": "select", "id": "surface", "label": "Background", "default": "canvas", "options": [ { "value": "canvas", "label": "White" }, { "value": "soft", "label": "Off-white" }, { "value": "brand", "label": "Navy" } ] },
    { "type": "text", "id": "eyebrow", "label": "Small line above heading", "default": "Stay ready" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the ReadySip list" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Restock alerts, storm-season prep tips and first word on new packs." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Your email address" },
    { "type": "text", "id": "button", "label": "Button label", "default": "Sign up" },
    { "type": "text", "id": "success", "label": "Thank-you message", "default": "You're on the list. Check your inbox soon." },
    { "type": "text", "id": "fineprint", "label": "Small print", "default": "No spam. Unsubscribe anytime." },
    { "type": "text", "id": "tags", "label": "Customer tags", "default": "newsletter,readysip", "info": "Added to everyone who signs up here, so you can segment them in Shopify Email or Klaviyo." }
  ],
  "presets": [ { "name": "ReadySip email sign-up" } ]
}
{% endschema %}
