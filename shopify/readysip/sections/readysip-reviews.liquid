{%- comment -%}
  Customer reviews. Layout "One scrollable row" (default) shows every review as a compact card in one
  swipeable row; layout "Tabs" groups them by type of customer (sub-avatar) instead.
  Add real reviews as blocks (the customer's own words, with their photo if you have it) and set
  each one's "Tab" to a key from the section's tab list. Your review app's block can sit underneath
  for the full list. The section hides itself on the live store while it has no reviews.
{%- endcomment -%}
{{ 'readysip-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'readysip-page.js' | asset_url }}" defer></script>

{%- liquid
  assign tab_lines = section.settings.tabs | newline_to_br | split: '<br />'
  assign card_count = 0
  assign app_count = 0
  for block in section.blocks
    if block.type == 'review' and block.settings.text != blank
      assign card_count = card_count | plus: 1
    elsif block.type == '@app'
      assign app_count = app_count | plus: 1
    endif
  endfor
  assign has_content = false
  if card_count > 0 or app_count > 0
    assign has_content = true
  endif
-%}

{%- if has_content or request.design_mode -%}
  <section class="rs rs-reviews rs-surface--{{ section.settings.surface }}" id="reviews" data-rs-reviews-tabs>
    <div class="rs-container">
      <header class="rs-head">
        {%- if section.settings.eyebrow != blank -%}<p class="rs-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="rs-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.intro != blank -%}<p class="rs-lead">{{ section.settings.intro | escape }}</p>{%- endif -%}
      </header>

      {%- unless has_content -%}
        <p class="rs-editor-note">Reviews: add real customer reviews as blocks (their own words) and pick a tab for each, or add your review app's block. This section stays hidden on the live store until you do.</p>
      {%- endunless -%}

      {%- if card_count > 0 and section.settings.layout != 'tabs' -%}
        {%- comment -%} All reviews in one swipeable row of compact cards. {%- endcomment -%}
        <div class="rs-rv" data-rs-hscroll>
          <ul class="rs-rv__track" role="list" data-rs-hscroll-track tabindex="0" aria-label="{{ section.settings.heading | escape }}">
            {%- for block in section.blocks -%}
              {%- if block.type == 'review' and block.settings.text != blank -%}
                {% render 'readysip-review-card', block: block %}
              {%- endif -%}
            {%- endfor -%}
          </ul>
          <div class="rs-vids__nav" data-rs-hscroll-nav>
            <button type="button" class="rs-vids__arrow disable-global-button-styling" data-rs-hscroll-prev aria-label="Previous reviews">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="rs-vids__arrow disable-global-button-styling" data-rs-hscroll-next aria-label="Next reviews">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
      {%- elsif card_count > 0 -%}
        {%- comment -%} Work out which tabs actually have reviews, in the order listed. {%- endcomment -%}
        {%- capture used_keys -%}
          {%- for line in tab_lines -%}
            {%- assign parts = line | split: ':' -%}
            {%- assign key = parts.first | strip | handleize -%}
            {%- if key != blank -%}
              {%- for block in section.blocks -%}
                {%- assign bkey = block.settings.group | strip | handleize -%}
                {%- if block.type == 'review' and block.settings.text != blank and bkey == key -%}{{ key }},{% break %}{%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- assign used = used_keys | strip | split: ',' -%}

        {%- if used.size > 1 -%}
          <div class="rs-tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
            {%- for line in tab_lines -%}
              {%- assign parts = line | split: ':' -%}
              {%- assign key = parts.first | strip | handleize -%}
              {%- if used contains key -%}
                {%- assign label = line | remove_first: parts.first | remove_first: ':' | strip | default: key -%}
                <button
                  type="button"
                  class="rs-tabs__tab"
                  role="tab"
                  id="rs-tab-{{ section.id }}-{{ key }}"
                  aria-controls="rs-panel-{{ section.id }}-{{ key }}"
                  aria-selected="{% if key == used.first %}true{% else %}false{% endif %}"
                  tabindex="{% if key == used.first %}0{% else %}-1{% endif %}"
                >{{ label | escape }}</button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- for key in used -%}
          <div
            class="rs-tabs__panel"
            id="rs-panel-{{ section.id }}-{{ key }}"
            {% if used.size > 1 %}role="tabpanel" aria-labelledby="rs-tab-{{ section.id }}-{{ key }}"{% endif %}
            {% unless forloop.first %}hidden{% endunless %}
          >
            <ul class="rs-reviews__list" role="list">
              {%- for block in section.blocks -%}
                {%- assign bkey = block.settings.group | strip | handleize -%}
                {%- if block.type == 'review' and block.settings.text != blank and bkey == key -%}
                  {% render 'readysip-review-card', block: block %}
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endfor -%}
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}<div class="rs-reviews__app">{% render block %}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "ReadySip reviews",
  "max_blocks": 50,
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "slider", "options": [ { "value": "slider", "label": "One scrollable row" }, { "value": "tabs", "label": "Tabs by type of customer" } ] },
    { "type": "select", "id": "surface", "label": "Background", "default": "canvas", "options": [ { "value": "canvas", "label": "White" }, { "value": "soft", "label": "Off-white" }, { "value": "brand", "label": "Navy" } ] },
    { "type": "text", "id": "eyebrow", "label": "Small line above heading", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What families say" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    {
      "type": "textarea", "id": "tabs", "label": "Tabs",
      "default": "families: Families\ngrandparents: Grandparents\nstorm: Storm & flood season\noutdoors: Hikers & campers\nsmall-space: Small-space homes",
      "info": "One per line as key: Label. Set each review's Tab to a key. Tabs with no reviews are hidden; with only one tab in use, no tab bar is shown."
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review", "name": "Review",
      "settings": [
        { "type": "paragraph", "content": "Only add reviews from real customers, in their own words. Shorten if you need to, but don't reword." },
        { "type": "text", "id": "group", "label": "Tab", "default": "families", "info": "A key from the section's tab list, e.g. families, grandparents, storm, outdoors, small-space." },
        { "type": "image_picker", "id": "image", "label": "Customer photo (image testimonial)" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Headline" },
        { "type": "textarea", "id": "text", "label": "Review" },
        { "type": "text", "id": "author", "label": "Name", "info": "First name and initial, e.g. Sarah M." },
        { "type": "text", "id": "location", "label": "Location (optional)" },
        { "type": "image_picker", "id": "photo", "label": "Small avatar (optional)" },
        {"type": "checkbox", "id": "verified", "label": "Verified buyer", "default": false, "info": "Tick only if this person bought from you (you can match them to an order)."}
      ]
    }
  ],
  "presets": [ { "name": "ReadySip reviews" } ]
}
{% endschema %}
