{%- comment -%}
  Review cards. Add real customer reviews as blocks, or drop in your review
  app's block. The section hides itself on the live store while it's empty.
{%- endcomment -%}
{{ 'readysip-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign card_count = 0
  assign app_count = 0
  for block in section.blocks
    if block.type == 'review' and block.settings.text != blank
      assign card_count = card_count | plus: 1
    elsif block.type == '@app'
      assign app_count = app_count | plus: 1
    endif
  endfor
  assign has_content = false
  if card_count > 0 or app_count > 0
    assign has_content = true
  endif
-%}

{%- if has_content or request.design_mode -%}
  <section class="rs rs-reviews rs-surface--{{ section.settings.surface }}" id="reviews">
    <div class="rs-container">
      <header class="rs-head">
        {%- if section.settings.eyebrow != blank -%}<p class="rs-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="rs-h2">{{ section.settings.heading | escape }}</h2>
      </header>
      {%- unless has_content -%}
        <p class="rs-editor-note">Reviews: add real customer reviews as blocks, or add your review app's block. This section stays hidden on the live store until you do.</p>
      {%- endunless -%}
      {%- if card_count > 0 -%}
        <ul class="rs-reviews__list" role="list" data-rs-reviews>
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' and block.settings.text != blank -%}
              <li class="rs-card rs-review" {{ block.shopify_attributes }}>
                <span class="rs-stars" style="--rs-rating: {{ block.settings.stars | times: 20 }}%;" aria-hidden="true"></span>
                <span class="rs-visually-hidden">{{ block.settings.stars }} out of 5 stars</span>
                {%- if block.settings.title != blank -%}<h3 class="rs-review__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
                <blockquote class="rs-review__text">{{ block.settings.text | escape }}</blockquote>
                <p class="rs-review__by">
                  {%- if block.settings.photo != blank -%}
                    {{ block.settings.photo | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', width: 40, height: 40, class: 'rs-review__avatar' }}
                  {%- endif -%}
                  <span>
                    <strong>{{ block.settings.author | escape }}</strong>
                    {%- if block.settings.location != blank %} · {{ block.settings.location | escape }}{% endif -%}
                    {%- if block.settings.verified %}<span class="rs-verified">Verified buyer</span>{% endif -%}
                  </span>
                </p>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "ReadySip reviews",
  "settings": [
    { "type": "select", "id": "surface", "label": "Background", "default": "canvas", "options": [ { "value": "canvas", "label": "White" }, { "value": "soft", "label": "Off-white" }, { "value": "brand", "label": "Navy" } ] },
    { "type": "text", "id": "eyebrow", "label": "Small line above heading", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What families say" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review", "name": "Review",
      "settings": [
        { "type": "paragraph", "content": "Only add reviews from real customers, in their words." },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Headline" },
        { "type": "textarea", "id": "text", "label": "Review" },
        { "type": "text", "id": "author", "label": "Name", "info": "First name and initial, e.g. Sarah M." },
        { "type": "text", "id": "location", "label": "Location (optional)" },
        { "type": "image_picker", "id": "photo", "label": "Customer photo (optional)" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
      ]
    }
  ],
  "presets": [ { "name": "ReadySip reviews" } ]
}
{% endschema %}
