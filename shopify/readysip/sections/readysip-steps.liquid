{%- comment -%} Numbered steps or icon cards (how it works, ways to drink). {%- endcomment -%}
{{ 'readysip-page.css' | asset_url | stylesheet_tag }}

<section class="rs rs-steps rs-surface--{{ section.settings.surface }}" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="rs-container">
    <header class="rs-head">
      {%- if section.settings.eyebrow != blank -%}<p class="rs-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="rs-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}<p class="rs-lead">{{ section.settings.intro | escape }}</p>{%- endif -%}
    </header>
    <ol class="rs-steps__list rs-steps__list--{{ section.blocks.size }}" role="list">
      {%- for block in section.blocks -%}
        <li class="rs-card rs-steps__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'rs-steps__img', sizes: '(min-width: 990px) 25vw, 90vw', widths: '400, 600, 800' }}
          {%- endif -%}
          <div class="rs-steps__marker">
            {%- if section.settings.style == 'numbers' -%}
              <span class="rs-steps__num">{{ forloop.index }}</span>
            {%- else -%}
              {% render 'readysip-icon', icon: block.settings.icon, size: 44 %}
            {%- endif -%}
          </div>
          <h3 class="rs-h3">{{ block.settings.title | escape }}</h3>
          <div class="rs-rte rs-steps__body">{{ block.settings.text }}</div>
          {%- if block.settings.tip != blank -%}
            <p class="rs-steps__tip">{{ block.settings.tip | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.footnote != blank -%}
      <div class="rs-callout rs-rte">{{ section.settings.footnote }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "ReadySip steps",
  "settings": [
    { "type": "select", "id": "style", "label": "Card marker", "default": "numbers", "options": [ { "value": "numbers", "label": "Numbers" }, { "value": "icons", "label": "Icons" } ] },
    { "type": "select", "id": "surface", "label": "Background", "default": "soft", "options": [ { "value": "canvas", "label": "White" }, { "value": "soft", "label": "Off-white" }, { "value": "brand", "label": "Navy" } ] },
    { "type": "text", "id": "eyebrow", "label": "Small line above heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "richtext", "id": "footnote", "label": "Callout under the cards" },
    { "type": "text", "id": "anchor", "label": "Section id (optional)" }
  ],
  "blocks": [
    {
      "type": "step", "name": "Card", "limit": 6,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon (icon style only)", "default": "sip", "options": [ { "value": "sip", "label": "Sip from source" }, { "value": "bottle", "label": "Bottle" }, { "value": "squeeze", "label": "Squeeze pouch" }, { "value": "gravity", "label": "Gravity drip" }, { "value": "drop", "label": "Water drop" }, { "value": "home", "label": "Home" }, { "value": "car", "label": "Car" }, { "value": "bag", "label": "Go-bag" }, { "value": "gift", "label": "Gift" }, { "value": "bolt", "label": "Storm / power" }, { "value": "box", "label": "Box" }, { "value": "shield", "label": "Shield" } ] },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe the step.</p>" },
        { "type": "text", "id": "tip", "label": "Tip" }
      ]
    }
  ],
  "presets": [ { "name": "ReadySip steps", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] } ]
}
{% endschema %}
