{%- comment -%}
  Inline line icons for the ReadySip page.
  Usage: {% render 'readysip-icon', icon: 'shield', size: 24 %}
{%- endcomment -%}
{%- assign s = size | default: 24 -%}
{%- case icon -%}
  {%- when 'shield' -%}
    <svg class="rs-icon" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.5 12l2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'truck' -%}
    <svg class="rs-icon" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3.5V16h-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="17.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
  {%- when 'lock' -%}
    <svg class="rs-icon" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 10.5V8a4 4 0 018 0v2.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
  {%- when 'chat' -%}
    <svg class="rs-icon" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M4 5h16v11H9l-5 4V5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 9.5h8M8 12.5h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
  {%- when 'drop' -%}
    <svg class="rs-icon" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M12 3s6 6.6 6 11a6 6 0 01-12 0c0-4.4 6-11 6-11z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9.2 14.5a2.9 2.9 0 002.8 2.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
  {%- when 'box' -%}
    <svg class="rs-icon" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5v-9z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M3.5 7.5L12 12l8.5-4.5M12 12v9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
  {%- when 'list' -%}
    <svg class="rs-icon" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M9 6.5h11M9 12h11M9 17.5h11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="4.5" cy="6.5" r="1.3" fill="currentColor"/><circle cx="4.5" cy="12" r="1.3" fill="currentColor"/><circle cx="4.5" cy="17.5" r="1.3" fill="currentColor"/></svg>
  {%- when 'steps' -%}
    <svg class="rs-icon" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><circle cx="5" cy="6" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="19" cy="18" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M6.5 7.5l4 3M13.5 13.5l4 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
  {%- when 'sip' -%}
    <svg class="rs-icon" viewBox="0 0 48 48" width="{{ s }}" height="{{ s }}" aria-hidden="true"><rect x="20" y="4" width="8" height="30" rx="3" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M22 4V1.5h4V4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M6 40c4-3 8-3 12 0s8 3 12 0 8-3 12 0" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M24 34v6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
  {%- when 'bottle' -%}
    <svg class="rs-icon" viewBox="0 0 48 48" width="{{ s }}" height="{{ s }}" aria-hidden="true"><rect x="21" y="2" width="6" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M19 18h10v4c4 2 5 5 5 8v13a3 3 0 01-3 3H17a3 3 0 01-3-3V30c0-3 1-6 5-8v-4z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M14 33h20" stroke="currentColor" stroke-width="2.5"/></svg>
  {%- when 'squeeze' -%}
    <svg class="rs-icon" viewBox="0 0 48 48" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M14 4h14l2 6v16c0 3-2 5-5 5h-8c-3 0-5-2-5-5V10l2-6z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M21 31v5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M14 38h14l-2 8H16z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M8 14l4 2M8 22l4-2M38 14l-4 2M38 22l-4-2" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
  {%- when 'gravity' -%}
    <svg class="rs-icon" viewBox="0 0 48 48" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M10 3h18l-2 14H12z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M19 17v6c0 3 3 3 3 6v3" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><rect x="19" y="31" width="6" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M22 41v1M22 45v1" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M30 40h12v6H30z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/></svg>
  {%- when 'check' -%}
    <svg class="rs-icon" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'cross' -%}
    <svg class="rs-icon" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M8.5 8.5l7 7M15.5 8.5l-7 7" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/></svg>
  {%- when 'home' -%}
    <svg class="rs-icon" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M3.5 11L12 4l8.5 7M6 9.5V20h12V9.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/><path d="M10 20v-5h4v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
  {%- when 'car' -%}
    <svg class="rs-icon" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M4 16v-3.5L6 8h12l2 4.5V16H4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="7.5" cy="16.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="16.5" cy="16.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4 12.5h16" stroke="currentColor" stroke-width="1.8"/></svg>
  {%- when 'bag' -%}
    <svg class="rs-icon" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M6 8h12l1 13H5L6 8z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 8V6a3 3 0 016 0v2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
  {%- when 'gift' -%}
    <svg class="rs-icon" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><rect x="3.5" y="8.5" width="17" height="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M5 12.5V21h14v-8.5M12 8.5V21" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 8.5C10 4 6.5 5 7.5 7.2 8.2 8.5 12 8.5 12 8.5zM12 8.5c2-4.5 5.5-3.5 4.5-1.3-.7 1.3-4.5 1.3-4.5 1.3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
  {%- when 'bolt' -%}
    <svg class="rs-icon" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" aria-hidden="true"><path d="M13 2L5 13.5h6L10 22l8-11.5h-6L13 2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
{%- endcase -%}
