{%- comment -%}
  Product card used by the Mirevia product grid.
  Params: p (product), image (optional image override), loading ('eager' | 'lazy'), collection (optional).
{%- endcomment -%}
{%- liquid
  assign card_image = image | default: p.featured_media
  assign card_url = p.url
  if collection
    assign card_url = p.url | within: collection
  endif
-%}
<li>
  <a class="mv-shelf__card" href="{{ card_url }}">
    <span class="mv-shelf__media">
      {%- if card_image -%}
        {{ card_image | image_url: width: 800 | image_tag: loading: loading, sizes: '(min-width: 990px) 25vw, 50vw', widths: '400, 600, 800', alt: p.title }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'mv-placeholder' }}
      {%- endif -%}
      {%- unless p.available -%}<span class="mv-grid__badge">Sold out</span>{%- endunless -%}
    </span>
    <span class="mv-shelf__title">{{ p.title | remove: 'Mirevia™ ' | escape }}</span>
    <span class="mv-shelf__price">{% if p.price_varies %}From {% endif %}{{ p.price | money }}</span>
  </a>
</li>
