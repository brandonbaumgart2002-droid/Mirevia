{%- comment -%}
  Expert endorsement: a real practitioner's photo, name, credentials and quote.
  It only appears on the storefront once name, credentials and quote are filled in AND the
  confirmation box is ticked. Until then the theme editor shows a setup note and shoppers see nothing,
  so an unapproved or placeholder endorsement can never go live.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign ready = false
  if s.name != blank and s.credentials != blank and s.quote != blank and s.confirmed
    assign ready = true
  endif
-%}
{%- if ready or request.design_mode -%}
<div class="pp">
  <section id="pp-expert" class="bg-white py-10 lg:py-14 scroll-mt-6" aria-labelledby="pp-expert-{{ section.id }}">
    <div class="max-w-4xl mx-auto px-4">
      {%- unless ready -%}
        <p class="mb-3 text-[13px]">[SETUP] Expert endorsement is hidden from shoppers until name, credentials and quote are filled in and the confirmation box is ticked.</p>
      {%- endunless -%}
      <figure class="rounded-3xl bg-mint p-6 sm:p-10 grid gap-6 sm:grid-cols-[auto_1fr] items-center">
        <div class="flex sm:block items-center gap-4">
          {%- if s.image != blank -%}
            <div class="w-24 h-24 sm:w-32 sm:h-32 rounded-full overflow-hidden ring-4 ring-white shrink-0 bg-white">
              {{- s.image | image_url: width: 320 | image_tag: alt: s.name, loading: 'lazy', widths: '160, 256, 320', sizes: '128px', class: 'w-full h-full object-cover' -}}
            </div>
          {%- else -%}
            <div class="ph w-24 h-24 sm:w-32 sm:h-32 rounded-full !p-2 !text-[10px] shrink-0" role="img" aria-label="Expert photo (image placeholder)">[IMG: expert headshot]</div>
          {%- endif -%}
          <div class="sm:hidden">
            {%- if s.eyebrow != blank -%}<p class="text-[12px] font-bold uppercase tracking-[.14em] text-primary">{{ s.eyebrow }}</p>{%- endif -%}
          </div>
        </div>
        <div class="min-w-0">
          {%- if s.eyebrow != blank -%}<p class="max-sm:hidden sm:block text-[12px] font-bold uppercase tracking-[.14em] text-primary">{{ s.eyebrow }}</p>{%- endif -%}
          <blockquote id="pp-expert-{{ section.id }}" class="font-display font-semibold text-[22px] sm:text-[28px] leading-[1.2] tracking-tight sm:mt-2">
            {%- if s.quote != blank -%}“{%- render 'parapatrol-claim', text: s.quote -%}”{%- else -%}Add their approved quote in the section settings.{%- endif -%}
          </blockquote>
          <figcaption class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1">
            <span class="font-bold text-[16px]">{{ s.name | default: 'Paediatrician name' }}</span>
            <span class="text-muted text-[14px]">{{ s.credentials | default: 'Credentials' }}</span>
            {%- if s.credential_link != blank -%}
              <a href="{{ s.credential_link }}" class="inline-flex items-center gap-1 text-[13px] font-bold text-primary underline" target="_blank" rel="noopener">
                {%- render 'parapatrol-icon', name: 'check', icon_size: 12 -%} Verify credentials<span class="sr-only"> (opens in a new tab)</span>
              </a>
            {%- endif -%}
          </figcaption>
          {%- if s.disclosure != blank -%}
            <p class="mt-3 text-[12px] leading-snug text-muted">{{ s.disclosure }}</p>
          {%- endif -%}
        </div>
      </figure>
    </div>
  </section>
</div>
{%- endif -%}
{% schema %}
{
  "name": "ParaPatrol: expert",
  "settings": [
    { "type": "paragraph", "content": "Use a real, licensed practitioner who has read and approved this exact quote, and keep their written approval on file. Hidden from shoppers until the box at the bottom is ticked." },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Paediatrician recommended", "info": "Must match the quote and the person: only say \"recommended\" if they actually recommend it." },
    { "type": "image_picker", "id": "image", "label": "Headshot" },
    { "type": "text", "id": "name", "label": "Name", "info": "e.g. Dr. Jane Smith" },
    { "type": "text", "id": "credentials", "label": "Credentials", "info": "e.g. MBBS, FRACP, Paediatrician" },
    { "type": "textarea", "id": "quote", "label": "Quote", "info": "Their exact approved words. Keep it to gut comfort and digestion, and add * to any claim so it links to the FDA disclaimer." },
    { "type": "url", "id": "credential_link", "label": "Credential lookup link (optional)", "info": "e.g. their state medical board or registry listing." },
    { "type": "text", "id": "disclosure", "label": "Disclosure", "info": "Required if they are paid, an advisor, or get free product." },
    { "type": "checkbox", "id": "confirmed", "label": "This person approved this quote and their credentials are accurate", "default": false }
  ],
  "presets": [ { "name": "ParaPatrol: expert" } ]
}
{% endschema %}
