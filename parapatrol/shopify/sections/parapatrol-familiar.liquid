{%- comment -%} "Sound familiar?" recognition grid. Everyday moments only, no symptoms. {%- endcomment -%}
{{ 'parapatrol.css' | asset_url | stylesheet_tag }}
<div class="pp">
  <section class="bg-soft py-14 lg:py-20" aria-labelledby="pp-fam-{{ section.id }}">
    <div class="max-w-6xl mx-auto px-4">
      <div class="max-w-xl">
        {%- if section.settings.eyebrow != blank -%}<p class="text-sm font-bold uppercase tracking-[.14em] text-berry">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 id="pp-fam-{{ section.id }}" class="font-display font-semibold text-[30px] sm:text-[38px] leading-[1.1] mt-2">{{ section.settings.heading }}</h2>
      </div>
      {%- liquid
        case section.blocks.size
          when 1
            assign cols = 'lg:grid-cols-1'
          when 2
            assign cols = 'lg:grid-cols-2'
          when 3
            assign cols = 'lg:grid-cols-3'
          when 4
            assign cols = 'lg:grid-cols-4'
          when 6
            assign cols = 'lg:grid-cols-3'
          else
            assign cols = 'lg:grid-cols-5'
        endcase
      -%}
      <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 {{ cols }} gap-3 sm:gap-4">
        {%- for block in section.blocks -%}
          <li class="bg-white rounded-2xl p-5 shadow-soft flex lg:flex-col items-center lg:items-start gap-4{% if forloop.last and section.blocks.size == 5 %} sm:col-span-2 lg:col-span-1{% endif %}" {{ block.shopify_attributes }}>
            <span class="w-12 h-12 shrink-0 rounded-2xl bg-accent/30 text-ink inline-flex items-center justify-center">{%- render 'parapatrol-icon', name: block.settings.icon -%}</span>
            <p class="font-medium leading-snug">{{ block.settings.text }}</p>
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.closing != blank -%}
        <p class="mt-8 font-display text-[21px] sm:text-[24px] leading-snug max-w-2xl">{{ section.settings.closing }}</p>
      {%- endif -%}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "ParaPatrol: familiar",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sound familiar?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Kids touch everything. Some weeks it shows." },
    { "type": "text", "id": "closing", "label": "Closing line", "default": "ParaPatrol is the gentle reset you reach for when things feel off." }
  ],
  "blocks": [
    { "type": "moment", "name": "Moment", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "sun", "options": [
        { "value": "sun", "label": "Morning" }, { "value": "plate", "label": "Plate" }, { "value": "backpack", "label": "School bag" },
        { "value": "wave", "label": "Pool / sand" }, { "value": "suitcase", "label": "Travel" }, { "value": "heart", "label": "Heart" }
      ] },
      { "type": "text", "id": "text", "label": "Text", "default": "Everyday moment" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "ParaPatrol: familiar" } ]
}
{% endschema %}
