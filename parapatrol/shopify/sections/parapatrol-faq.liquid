{%- comment -%}
  FAQ accordion + FAQPage structured data. Answers still marked [VERIFY] are left
  out of the structured data until the brand confirms them.
{%- endcomment -%}
{{ 'parapatrol.css' | asset_url | stylesheet_tag }}
<script src="{{ 'parapatrol.js' | asset_url }}" defer></script>
<div class="pp" id="faq">
  <section class="bg-white py-14 lg:py-20" aria-labelledby="pp-faq-{{ section.id }}">
    <div class="max-w-3xl mx-auto px-4">
      {%- if section.settings.eyebrow != blank -%}<p class="text-sm font-bold uppercase tracking-[.14em] text-primary text-center">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 id="pp-faq-{{ section.id }}" class="font-display font-semibold text-[30px] sm:text-[38px] leading-[1.1] mt-2 text-center">{{ section.settings.heading }}</h2>
      <div class="mt-8 divide-y divide-line border-y border-line" data-pp-accordion>
        {%- for block in section.blocks -%}
          {%- assign bid = section.id | append: '-' | append: forloop.index -%}
          <div {{ block.shopify_attributes }}>
            <h3>
              <button type="button" class="disable-global-button-styling acc-btn w-full flex items-center justify-between gap-4 py-5 text-left font-display font-semibold text-[18px] sm:text-[19px]" aria-expanded="false" aria-controls="pp-faq-p-{{ bid }}" id="pp-faq-b-{{ bid }}">
                <span>{{ block.settings.question }}</span>
                <span class="acc-icon w-9 h-9 shrink-0 rounded-full bg-mint text-primary inline-flex items-center justify-center text-[22px] leading-none font-sans" aria-hidden="true">+</span>
              </button>
            </h3>
            <div id="pp-faq-p-{{ bid }}" role="region" aria-labelledby="pp-faq-b-{{ bid }}" class="pb-5 pr-12 text-ink/90 rte" hidden>
              {%- render 'parapatrol-claim', text: block.settings.answer -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{%- if section.settings.schema -%}
  {%- liquid
    assign faq_items = ''
    for block in section.blocks
      unless block.settings.answer contains '[VERIFY' or block.settings.question contains '[VERIFY'
        assign q = block.settings.question | strip_html | json
        assign a = block.settings.answer | strip_html | strip | json
        assign item = '{"@type":"Question","name":' | append: q | append: ',"acceptedAnswer":{"@type":"Answer","text":' | append: a | append: '}}'
        if faq_items != ''
          assign faq_items = faq_items | append: ','
        endif
        assign faq_items = faq_items | append: item
      endunless
    endfor
  -%}
  {%- if faq_items != '' -%}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_items }}]}</script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "ParaPatrol: FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions parents ask" },
    { "type": "checkbox", "id": "schema", "label": "Add FAQ structured data for Google", "default": true }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer", "info": "1–3 sentences. Every * links to the FDA disclaimer." }
    ] }
  ],
  "presets": [ { "name": "ParaPatrol: FAQ" } ]
}
{% endschema %}
