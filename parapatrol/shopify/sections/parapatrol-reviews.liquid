{%- comment -%}
  Reviews: rating summary + star breakdown, topic filter, featured quotes.
  Add your review app's widget as an app block (it appears under the quotes).
  Featured quotes must stay compliant: no behaviour, no worms seen, no medical conditions.
{%- endcomment -%}
{{ 'parapatrol.css' | asset_url | stylesheet_tag }}
<script src="{{ 'parapatrol.js' | asset_url }}" defer></script>
{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign filter_lines = section.settings.filters | newline_to_br | split: '<br />'
-%}
<div class="pp" id="reviews">
  <section class="bg-soft pt-10 pb-14 lg:pt-16 lg:pb-20" aria-labelledby="pp-rev-{{ section.id }}">
    <div class="max-w-[1240px] mx-auto px-4">
      <div class="text-center">
        {%- if section.settings.eyebrow != blank -%}<p class="text-sm font-bold uppercase tracking-[.14em] text-primary">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 id="pp-rev-{{ section.id }}" class="font-display font-bold text-[32px] sm:text-[44px] leading-[1.1] mt-2">{{ section.settings.heading }}</h2>
        {%- if section.settings.show_breakdown -%}
          {%- liquid
            if rating != blank
              assign score = rating.rating | round: 1
              assign review_count = product.metafields.reviews.rating_count.value
            else
              assign score = section.settings.score_fallback
              assign review_count = section.settings.count_fallback
            endif
          -%}
          {%- if score != blank -%}
            <div class="mt-3 inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
              {%- render 'parapatrol-stars', score: score, size: 20 -%}
              <p class="text-[16px] font-bold text-ink">{{ score }} / 5 <span class="font-semibold text-muted">· {% if review_count != blank %}{{ review_count }} {% endif %}{{ section.settings.count_label }}</span></p>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- comment -%} Optional lifestyle photo row, kept apart from the reviews. {%- endcomment -%}
      {%- assign photo_count = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type == 'photo' -%}{%- assign photo_count = photo_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if photo_count > 0 -%}
        <ul class="pp-slider--bar mt-8 -mx-4 px-4 scroll-px-4 sm:mx-0 sm:px-0 sm:scroll-px-0 flex gap-4 overflow-x-auto snap-x snap-mandatory" role="list" aria-label="ParaPatrol in family life">
          {%- for block in section.blocks -%}
            {%- if block.type == 'photo' -%}
              <li class="snap-start shrink-0 w-[62%] sm:w-[calc(20%-12.8px)]" {{ block.shopify_attributes }}>
                {%- render 'parapatrol-media', image: block.settings.image, asset: block.settings.asset, label: block.settings.alt, alt: block.settings.alt, class: 'aspect-square rounded-3xl', sizes: '(min-width: 1152px) 230px, (min-width: 640px) 20vw, 62vw' -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="mt-8 lg:mt-10" data-pp-reviews>
        {%- if filter_lines.size > 0 and section.settings.filters != blank -%}
          <div class="mb-5 flex flex-wrap justify-center gap-2" role="group" aria-label="Filter reviews by topic">
            <button type="button" data-pp-filter="all" aria-pressed="true" class="disable-global-button-styling px-4 py-2 rounded-full text-sm font-bold border border-primary bg-primary text-white">All</button>
            {%- for line in filter_lines -%}
              {%- assign parts = line | strip | split: '|' -%}
              {%- if parts.size == 2 -%}
                <button type="button" data-pp-filter="{{ parts[0] | strip | handleize }}" aria-pressed="false" class="disable-global-button-styling px-4 py-2 rounded-full text-sm font-bold border border-primary bg-white text-primary-dark">{{ parts[1] | strip }}</button>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <p class="sr-only" aria-live="polite" data-pp-filter-status></p>
        {%- endif -%}

        {%- comment -%} Horizontal scroller: 4 cards across on desktop, a visible scrollbar underneath. {%- endcomment -%}
        <div data-pp-scrollbar>
        <ul class="pp-slider -mx-4 px-4 scroll-px-4 sm:mx-0 sm:px-0 sm:scroll-px-0 flex gap-5 overflow-x-auto snap-x snap-mandatory pb-2" data-pp-scrollbar-track role="list" aria-label="Parent reviews" tabindex="0">
          {%- for block in section.blocks -%}
            {%- if block.type == 'quote' -%}
              {%- liquid
                assign tag_list = ''
                assign raw_tags = block.settings.tags | split: ','
                for t in raw_tags
                  assign t_clean = t | strip | handleize
                  assign tag_list = tag_list | append: ' ' | append: t_clean
                endfor
              -%}
              <li class="snap-start shrink-0 w-[84%] sm:w-[calc(50%-10px)] lg:w-[calc(25%-15px)] bg-white rounded-3xl p-4 sm:p-5 shadow-soft flex flex-col" data-pp-review data-tags="{{ tag_list | strip }}" {{ block.shopify_attributes }}>
                {%- if block.settings.customer_photo != blank -%}
                  {%- render 'parapatrol-media', image: block.settings.customer_photo, alt: block.settings.photo_alt, class: 'aspect-[5/4] rounded-2xl', sizes: '(min-width: 1024px) 280px, (min-width: 640px) 45vw, 84vw' -%}
                {%- elsif block.settings.illus_image != blank or block.settings.illus_asset != blank -%}
                  <div class="relative">
                    {%- render 'parapatrol-media', image: block.settings.illus_image, asset: block.settings.illus_asset, label: block.settings.illus_alt, alt: block.settings.illus_alt, class: 'aspect-[5/4] rounded-2xl', sizes: '(min-width: 1024px) 280px, (min-width: 640px) 45vw, 84vw' -%}
                    <span class="absolute left-2 bottom-2 rounded-full bg-white px-2 py-0.5 text-[11px] font-bold text-muted">Illustrative photo</span>
                  </div>
                {%- endif -%}
                {%- if block.settings.stars > 0 -%}
                  <div class="mt-4">{%- render 'parapatrol-stars', score: block.settings.stars, size: 18 -%}</div>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <p class="mt-3 font-display font-bold text-[18px] leading-snug text-primary">{{ block.settings.title }}</p>
                {%- endif -%}
                <blockquote class="mt-2 text-[15px] leading-relaxed flex-1">“{{ block.settings.quote }}”</blockquote>
                <div class="mt-4">
                  <p class="font-display font-bold text-[16px] text-ink">{{ block.settings.author }}{% if block.settings.detail != blank %} <span class="font-sans font-semibold text-[14px] text-muted">({{ block.settings.detail }})</span>{% endif %}</p>
                  {%- if block.settings.badge != blank -%}
                    <p class="mt-1 flex items-center gap-1.5 text-[14px] font-semibold text-primary-dark">
                      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="#3b7560" d="M12 1.5l2.6 1.9 3.2-.1 1 3.1 2.6 1.9-1 3.1 1 3.1-2.6 1.9-1 3.1-3.2-.1L12 22.5l-2.6-1.9-3.2.1-1-3.1-2.6-1.9 1-3.1-1-3.1 2.6-1.9 1-3.1 3.2.1z"/><path d="m8 12.2 2.7 2.7L16.2 9.4" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {{- block.settings.badge -}}
                    </p>
                  {%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <div class="pp-sbar mt-4 mx-auto max-w-[640px]" data-pp-scrollbar-rail aria-hidden="true"><span class="pp-sbar__thumb" data-pp-scrollbar-thumb></span></div>
        </div>
        <p class="mt-2 text-center text-[13px] font-bold text-muted" aria-hidden="true">Scroll for more reviews →</p>
        {%- if section.settings.quotes_note != blank -%}<p class="mt-4 text-center text-[12px] text-muted">{{ section.settings.quotes_note }}</p>{%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}<div class="mt-8">{% render block %}</div>{%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "ParaPatrol: reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What parents say" },
    { "type": "checkbox", "id": "show_breakdown", "label": "Show rating summary + breakdown", "default": true },
    { "type": "text", "id": "score_fallback", "label": "Star score when no reviews app data", "info": "Must match your real reviews.", "default": "4.8" },
    { "type": "text", "id": "count_fallback", "label": "Review count when no reviews app data", "default": "237+" },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "parent reviews" },
    { "type": "text", "id": "bar_percents", "label": "Breakdown bar widths, 5★ to 1★ (%)", "info": "The breakdown stays hidden until at least one bar is above 0.", "default": "0,0,0,0,0" },
    { "type": "text", "id": "bar_labels", "label": "Breakdown counts, 5★ to 1★" },
    { "type": "text", "id": "breakdown_note", "label": "Breakdown note", "default": "Replace the bar widths and counts with your review app's numbers." },
    { "type": "textarea", "id": "filters", "label": "Filter topics (one per line: key|Label)", "default": "easy|Easy to give\ntaste|Taste\ntummy|Tummy & appetite\nroutine|Routine" },
        { "type": "text", "id": "quotes_note", "label": "Note under quotes", "default": "Individual reviews reflect one family’s experience. Results vary." }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "quote", "name": "Featured review", "settings": [
      { "type": "text", "id": "title", "label": "Title", "info": "The moment that changed for this family, in a few words, e.g. Calmer mornings. Must match what the review actually says." },
      { "type": "textarea", "id": "quote", "label": "Quote" },
      { "type": "text", "id": "author", "label": "Name", "default": "Verified Buyer" },
      { "type": "text", "id": "detail", "label": "Detail next to the name", "info": "e.g. Parent of Leo, age 5. Use a changed name for the child; only use an age the customer gave. Shown in brackets." },
      { "type": "text", "id": "badge", "label": "Badge", "default": "Verified Buyer" },
      { "type": "range", "id": "stars", "label": "Stars (0 hides)", "min": 0, "max": 5, "step": 1, "default": 5 },
      { "type": "text", "id": "tags", "label": "Filter keys (comma separated)", "info": "Use keys from the section's filter list, e.g. easy, taste" },
      { "type": "image_picker", "id": "customer_photo", "label": "Customer photo (optional)", "info": "Only a real photo from this customer, used with their permission. Never a stock or AI image." },
      { "type": "text", "id": "photo_alt", "label": "Customer photo description" },
      { "type": "image_picker", "id": "illus_image", "label": "Illustrative photo (optional)", "info": "Shown with an 'Illustrative photo' tag. Used only when there's no customer photo." },
      { "type": "text", "id": "illus_asset", "label": "Illustrative photo: built-in image file" },
      { "type": "text", "id": "illus_alt", "label": "Illustrative photo description" }
    ] },
    { "type": "photo", "name": "Lifestyle photo", "settings": [
      { "type": "paragraph", "content": "Shown in a row above the reviews, separate from the quotes." },
      { "type": "image_picker", "id": "image", "label": "Image (square)" },
      { "type": "text", "id": "asset", "label": "Built-in image file", "info": "Used when no image is chosen. A file in the theme's assets folder." },
      { "type": "text", "id": "alt", "label": "Image description (for screen readers)" }
    ] }
  ],
  "presets": [ { "name": "ParaPatrol: reviews" } ]
}
{% endschema %}
