{%- comment -%}
  Reviews: rating summary + star breakdown, topic filter, featured quotes.
  Add your review app's widget as an app block (it appears under the quotes).
  Featured quotes must stay compliant: no behaviour, no worms seen, no medical conditions.
{%- endcomment -%}
{{ 'parapatrol.css' | asset_url | stylesheet_tag }}
<script src="{{ 'parapatrol.js' | asset_url }}" defer></script>
{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign percents = section.settings.bar_percents | split: ','
  assign bar_labels = section.settings.bar_labels | split: ','
  assign filter_lines = section.settings.filters | newline_to_br | split: '<br />'
-%}
<div class="pp" id="reviews">
  <section class="bg-soft pt-10 pb-14 lg:pt-14 lg:pb-20" aria-labelledby="pp-rev-{{ section.id }}">
    <div class="max-w-6xl mx-auto px-4">
      {%- if section.settings.eyebrow != blank -%}<p class="text-sm font-bold uppercase tracking-[.14em] text-primary">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 id="pp-rev-{{ section.id }}" class="font-display font-semibold text-[30px] sm:text-[38px] leading-[1.1] mt-2">{{ section.settings.heading }}</h2>

      {%- comment -%} Lifestyle photo strip. Kept apart from the quotes so it never reads as a reviewer's photo. {%- endcomment -%}
      {%- assign photo_count = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type == 'photo' -%}{%- assign photo_count = photo_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if photo_count > 0 -%}
        <ul class="mt-8 -mx-4 px-4 scroll-px-4 flex gap-3 overflow-x-auto snap-x snap-mandatory pb-2 sm:mx-0 sm:px-0 sm:grid sm:grid-cols-4 sm:gap-4 sm:overflow-visible" role="list" aria-label="ParaPatrol in family life">
          {%- for block in section.blocks -%}
            {%- if block.type == 'photo' -%}
              <li class="snap-start shrink-0 w-[62%] sm:w-auto" {{ block.shopify_attributes }}>
                {%- render 'parapatrol-media', image: block.settings.image, asset: block.settings.asset, label: block.settings.alt, alt: block.settings.alt, class: 'aspect-square rounded-3xl', sizes: '(min-width: 1152px) 270px, (min-width: 640px) 24vw, 62vw' -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="mt-8 grid lg:grid-cols-[320px_1fr] gap-6 lg:gap-10">
        {%- if section.settings.show_breakdown -%}
          <div class="bg-white rounded-3xl p-6 shadow-soft self-start">
            {%- liquid
              if rating != blank
                assign score = rating.rating | round: 1
                assign review_count = product.metafields.reviews.rating_count.value
              else
                assign score = section.settings.score_fallback
                assign review_count = section.settings.count_fallback
              endif
              assign has_bars = false
              for p in percents
                assign pv = p | strip | plus: 0
                if pv > 0
                  assign has_bars = true
                endif
              endfor
            -%}
            {%- if score != blank -%}
              <p class="font-display font-semibold text-[44px] leading-none">{{ score }}<span class="text-[20px] text-muted"> / 5</span></p>
              <div class="mt-2">{%- render 'parapatrol-stars', score: score, size: 22 -%}</div>
              <p class="text-sm text-muted mt-2">{% if review_count != blank %}{{ review_count }} {% endif %}{{ section.settings.count_label }}</p>
            {%- endif -%}
            {%- if has_bars -%}
            <dl class="mt-5 grid gap-2 text-sm">
              {%- for i in (1..5) -%}
                {%- liquid
                  assign idx = forloop.index0
                  assign stars = 6 | minus: forloop.index
                  assign pct = percents[idx] | strip | default: '0' | plus: 0 | at_most: 100 | at_least: 0
                  assign lbl = bar_labels[idx] | strip
                -%}
                <div class="flex items-center gap-2">
                  <dt class="w-8 shrink-0">{{ stars }} <span aria-hidden="true">★</span><span class="sr-only">stars</span></dt>
                  <dd class="flex-1 h-2 rounded-full bg-line overflow-hidden"><span class="block h-full bg-berry" style="width: {{ pct }}%"></span></dd>
                  <dd class="w-16 text-right text-muted text-[11px]">{{ lbl }}</dd>
                </div>
              {%- endfor -%}
            </dl>
            {%- endif -%}
            {%- if has_bars and section.settings.breakdown_note != blank -%}<p class="mt-4 text-[12px] text-muted">{{ section.settings.breakdown_note }}</p>{%- endif -%}
          </div>
        {%- endif -%}

        <div data-pp-reviews>
          {%- if filter_lines.size > 0 and section.settings.filters != blank -%}
            <div class="flex flex-wrap gap-2" role="group" aria-label="Filter reviews by topic">
              <button type="button" data-pp-filter="all" aria-pressed="true" class="disable-global-button-styling px-4 py-2 rounded-full text-sm font-bold border border-primary bg-primary text-white">All</button>
              {%- for line in filter_lines -%}
                {%- assign parts = line | strip | split: '|' -%}
                {%- if parts.size == 2 -%}
                  <button type="button" data-pp-filter="{{ parts[0] | strip | handleize }}" aria-pressed="false" class="disable-global-button-styling px-4 py-2 rounded-full text-sm font-bold border border-primary/30 bg-white text-primary-dark">{{ parts[1] | strip }}</button>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <p class="sr-only" aria-live="polite" data-pp-filter-status></p>
          {%- endif -%}

          {%- assign q_shown = section.settings.quotes_visible | default: 0 -%}
          {%- assign q_i = 0 -%}
          <ul class="mt-5 grid sm:grid-cols-2 gap-4" data-pp-more-list>
            {%- for block in section.blocks -%}
              {%- if block.type == 'quote' -%}
                {%- assign q_i = q_i | plus: 1 -%}
                {%- liquid
                  assign tag_list = ''
                  assign raw_tags = block.settings.tags | split: ','
                  for t in raw_tags
                    assign t_clean = t | strip | handleize
                    assign tag_list = tag_list | append: ' ' | append: t_clean
                  endfor
                -%}
                <li class="bg-white rounded-3xl p-6 shadow-soft flex flex-col{% if q_shown > 0 and q_i > q_shown %} pp-more-hidden{% endif %}" data-pp-review data-tags="{{ tag_list | strip }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.customer_photo != blank -%}
                    {%- render 'parapatrol-media', image: block.settings.customer_photo, alt: block.settings.photo_alt, class: 'aspect-square rounded-2xl mb-4', sizes: '(min-width: 1024px) 300px, (min-width: 640px) 45vw, 100vw' -%}
                  {%- endif -%}
                  {%- if block.settings.stars > 0 -%}
                    <div>{%- render 'parapatrol-stars', score: block.settings.stars, size: 16 -%}</div>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <p class="mt-3 font-display font-bold text-[19px] leading-snug text-primary">{{ block.settings.title }}</p>
                  {%- endif -%}
                  <blockquote class="{% if block.settings.title != blank %}mt-1.5{% else %}mt-3{% endif %} text-[16px] flex-1">“{{ block.settings.quote }}”</blockquote>
                  <p class="mt-4 text-sm font-bold">{{ block.settings.author }}{% if block.settings.badge != blank %} <span class="font-normal text-muted">· {{ block.settings.badge }}</span>{% endif %}</p>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if q_shown > 0 and q_i > q_shown -%}
            <div class="mt-5 text-center">
              <button type="button" data-pp-more-btn class="disable-global-button-styling inline-flex items-center justify-center min-h-[48px] px-7 rounded-full border-2 border-primary text-primary-dark font-extrabold text-[15px] hover:bg-mint transition-colors">Show {{ q_i | minus: q_shown }} more reviews</button>
            </div>
          {%- endif -%}
          {%- if section.settings.quotes_note != blank -%}<p class="mt-4 text-[12px] text-muted">{{ section.settings.quotes_note }}</p>{%- endif -%}

          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}<div class="mt-8">{% render block %}</div>{%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "ParaPatrol: reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What parents say" },
    { "type": "checkbox", "id": "show_breakdown", "label": "Show rating summary + breakdown", "default": true },
    { "type": "text", "id": "score_fallback", "label": "Star score when no reviews app data", "info": "Must match your real reviews.", "default": "4.8" },
    { "type": "text", "id": "count_fallback", "label": "Review count when no reviews app data", "default": "237+" },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "parent reviews" },
    { "type": "text", "id": "bar_percents", "label": "Breakdown bar widths, 5★ to 1★ (%)", "info": "The breakdown stays hidden until at least one bar is above 0.", "default": "0,0,0,0,0" },
    { "type": "text", "id": "bar_labels", "label": "Breakdown counts, 5★ to 1★" },
    { "type": "text", "id": "breakdown_note", "label": "Breakdown note", "default": "Replace the bar widths and counts with your review app's numbers." },
    { "type": "textarea", "id": "filters", "label": "Filter topics (one per line: key|Label)", "default": "easy|Easy to give\ntaste|Taste\ntummy|Tummy & appetite\nroutine|Routine" },
    { "type": "number", "id": "quotes_visible", "label": "Reviews shown before \"Show more\"", "info": "0 shows them all.", "default": 6 },
    { "type": "text", "id": "quotes_note", "label": "Note under quotes", "default": "Individual reviews reflect one family’s experience. Results vary." }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "quote", "name": "Featured review", "settings": [
      { "type": "text", "id": "title", "label": "Title", "info": "The moment that changed for this family, in a few words, e.g. Calmer mornings. Must match what the review actually says." },
      { "type": "textarea", "id": "quote", "label": "Quote" },
      { "type": "text", "id": "author", "label": "Name", "default": "Verified Buyer" },
      { "type": "text", "id": "badge", "label": "Badge", "default": "Verified Buyer" },
      { "type": "range", "id": "stars", "label": "Stars (0 hides)", "min": 0, "max": 5, "step": 1, "default": 5 },
      { "type": "text", "id": "tags", "label": "Filter keys (comma separated)", "info": "Use keys from the section's filter list, e.g. easy, taste" },
      { "type": "image_picker", "id": "customer_photo", "label": "Customer photo (optional)", "info": "Only a real photo from this customer, used with their permission. Never a stock or AI image." },
      { "type": "text", "id": "photo_alt", "label": "Customer photo description" }
    ] },
    { "type": "photo", "name": "Lifestyle photo", "settings": [
      { "type": "paragraph", "content": "Shown in a row above the reviews, separate from the quotes." },
      { "type": "image_picker", "id": "image", "label": "Image (square)" },
      { "type": "text", "id": "asset", "label": "Built-in image file", "info": "Used when no image is chosen. A file in the theme's assets folder." },
      { "type": "text", "id": "alt", "label": "Image description (for screen readers)" }
    ] }
  ],
  "presets": [ { "name": "ParaPatrol: reviews" } ]
}
{% endschema %}
