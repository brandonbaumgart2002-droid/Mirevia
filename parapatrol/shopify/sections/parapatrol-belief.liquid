          {%- unless b.enabled -%}<p class="mb-4"><mark class="pp-ph">[[Hidden on the live page: turn on "Show rewards ladder" once a subscription app is set up.]]</mark></p>{%- endunless -%}
          {%- if b.eyebrow != blank -%}<p class="text-[12px] font-extrabold uppercase tracking-[.14em] text-mintdeep">{{ b.eyebrow }}</p>{%- endif -%}
          <h2 id="pp-rw-{{ block.id }}" class="mt-1 font-display font-extrabold text-[28px] sm:text-[40px] leading-[1.1] text-ink">{{ b.heading }}</h2>
          {%- if b.intro != blank -%}<p class="mt-3 text-[16px] sm:text-[17px] text-ink">{{ b.intro | replace: '[[', ph_open | replace: ']]', ph_close }}</p>{%- endif -%}
