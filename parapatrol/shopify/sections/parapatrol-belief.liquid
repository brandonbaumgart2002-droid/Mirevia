{%- comment -%}
  Belief-led product page sections (Para Patrol AU belief brief, Nov 2026). Each block does one belief job:
  story (you know your kid), logic (why adult cleanses aren't for kids), compare (chemist tablet vs daily support),
  label (every ingredient on the label + testing), reviews (real reviews grouped by the belief they answer),
  howto (demonstration + dose table), close (guarantee, offer, price per day, mandatory statement).
  Anything still to confirm is written as [[PLACEHOLDER]] and renders highlighted so it can't ship unnoticed.
  Optional elements (AUST L, practitioner, binder line, test certificate) stay hidden while their setting is blank.
{%- endcomment -%}
{%- assign s = section.settings -%}
{{ 'parapatrol.css' | asset_url | stylesheet_tag }}
<script src="{{ 'parapatrol.js' | asset_url }}" defer></script>
{%- capture ph_open -%}<mark class="pp-ph">[[{%- endcapture -%}
{%- capture ph_close -%}]]</mark>{%- endcapture -%}
<div class="pp pp-belief">
{%- for block in section.blocks -%}
  {%- assign b = block.settings -%}
  {%- case block.type -%}

    {%- when 'story' -%}
      <section data-pp-band="{{ b.band | default: 'auto' }}" class="py-12 lg:py-16 bg-soft" {{ block.shopify_attributes }} aria-labelledby="pp-st-{{ block.id }}">
        <div class="max-w-[720px] mx-auto px-4">
          {%- if b.eyebrow != blank -%}<p class="text-[12px] font-extrabold uppercase tracking-[.14em] text-primary">{{ b.eyebrow }}</p>{%- endif -%}
          <h2 id="pp-st-{{ block.id }}" class="mt-1 font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ b.heading }}</h2>
          <figure class="mt-6 rounded-3xl bg-white border border-line p-6 sm:p-8 shadow-soft">
            <blockquote class="pp-adv-copy">{{ b.story | replace: '[[', ph_open | replace: ']]', ph_close }}</blockquote>
            {%- if b.attribution != blank -%}<figcaption class="mt-4 text-[14px] font-bold text-muted">{{ b.attribution | replace: '[[', ph_open | replace: ']]', ph_close }}</figcaption>{%- endif -%}
          </figure>
          {%- if b.closing != blank -%}<p class="mt-6 text-center font-display font-bold text-[22px] sm:text-[26px] leading-snug text-primary-dark">{{ b.closing }}</p>{%- endif -%}
        </div>
      </section>

    {%- when 'logic' -%}
      {%- assign steps = b.steps | newline_to_br | split: '<br />' -%}
      <section data-pp-band="{{ b.band | default: 'auto' }}" class="py-12 lg:py-16 bg-white" {{ block.shopify_attributes }} aria-labelledby="pp-lg-{{ block.id }}">
        <div class="max-w-[720px] mx-auto px-4">
          {%- if b.eyebrow != blank -%}<p class="text-[12px] font-extrabold uppercase tracking-[.14em] text-primary">{{ b.eyebrow }}</p>{%- endif -%}
          <h2 id="pp-lg-{{ block.id }}" class="mt-1 font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ b.heading }}</h2>
          <ol class="mt-7 grid gap-3" role="list">
            {%- for l in steps -%}{%- assign t = l | strip -%}{%- if t != blank -%}
              <li class="flex gap-4 rounded-2xl {% if forloop.last %}bg-mint border-2 border-primary{% else %}bg-soft{% endif %} p-4 sm:p-5">
                <span class="w-9 h-9 shrink-0 rounded-full {% if forloop.last %}bg-primary text-white{% else %}bg-white text-primary-dark{% endif %} inline-flex items-center justify-center font-display font-bold text-[17px]" aria-hidden="true">{{ forloop.index }}</span>
                <span class="pt-1 text-[16px] sm:text-[17px] leading-relaxed text-ink {% if forloop.last %}font-bold{% endif %}">{{ t | replace: '[[', ph_open | replace: ']]', ph_close }}</span>
              </li>
            {%- endif -%}{%- endfor -%}
          </ol>
          {%- if b.binder_line != blank -%}<p class="mt-5 text-center font-display font-bold text-[20px] text-primary-dark">{{ b.binder_line }}</p>{%- endif -%}
        </div>
      </section>

    {%- when 'compare' -%}
      {%- assign rows = b.rows | newline_to_br | split: '<br />' -%}
      <section data-pp-band="{{ b.band | default: 'auto' }}" class="py-12 lg:py-16 bg-mint" {{ block.shopify_attributes }} aria-labelledby="pp-cp-{{ block.id }}">
        <div class="max-w-[820px] mx-auto px-4">
          {%- if b.eyebrow != blank -%}<p class="text-[12px] font-extrabold uppercase tracking-[.14em] text-primary">{{ b.eyebrow }}</p>{%- endif -%}
          <h2 id="pp-cp-{{ block.id }}" class="mt-1 font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ b.heading }}</h2>
          {%- if b.intro != blank -%}<p class="mt-3 text-[16px] sm:text-[17px] text-ink">{{ b.intro }}</p>{%- endif -%}
          {%- if b.header_image != blank -%}
            <div class="mt-6 rounded-3xl overflow-hidden bg-white">{{ b.header_image | image_url: width: 1200 | image_tag: alt: b.header_image.alt, loading: 'lazy', sizes: '(min-width: 860px) 788px, calc(100vw - 32px)', widths: '400,600,800,1200', class: 'w-full h-auto' }}</div>
          {%- elsif b.media_pos > 0 -%}
            {%- assign cmp_i = b.media_pos | minus: 1 -%}{%- assign cmp_m = product.media[cmp_i] -%}
            {%- if cmp_m -%}<div class="mt-6 rounded-3xl overflow-hidden bg-white">{{ cmp_m.preview_image | image_url: width: 1200 | image_tag: alt: cmp_m.alt, loading: 'lazy', sizes: '(min-width: 860px) 788px, calc(100vw - 32px)', widths: '400,600,800,1200', class: 'w-full h-auto' }}</div>{%- endif -%}
          {%- endif -%}
          <div class="mt-6 rounded-3xl bg-white overflow-hidden shadow-soft">
            <table class="w-full text-left text-[14px] sm:text-[15px]">
              <thead><tr><th class="p-3 sm:p-4 w-[30%]"><span class="sr-only">Compare</span></th><th class="p-3 sm:p-4 font-extrabold text-muted">{{ b.col_a }}</th><th class="p-3 sm:p-4 bg-primary text-white font-extrabold">{{ b.col_b }}</th></tr></thead>
              <tbody>
                {%- for l in rows -%}{%- assign f = l | strip | split: '|' -%}{%- if f.size >= 3 -%}
                  <tr class="border-t border-line"><th scope="row" class="p-3 sm:p-4 font-bold text-ink">{{ f[0] | strip }}</th><td class="p-3 sm:p-4 text-muted">{{ f[1] | strip }}</td><td class="p-3 sm:p-4 bg-mint font-bold text-primary-dark">{{ f[2] | strip }}</td></tr>
                {%- endif -%}{%- endfor -%}
              </tbody>
            </table>
          </div>
          {%- if b.note != blank -%}<p class="mt-5 rounded-2xl border-2 border-primary bg-white px-5 py-4 text-center font-bold text-[16px] sm:text-[17px] text-ink">{{ b.note }}</p>{%- endif -%}
        </div>
      </section>

    {%- when 'label' -%}
      {%- assign ings = b.ingredients | newline_to_br | split: '<br />' -%}
      <section data-pp-band="{{ b.band | default: 'auto' }}" id="whats-in-it" class="py-12 lg:py-16 bg-white scroll-mt-24" {{ block.shopify_attributes }} aria-labelledby="pp-lb-{{ block.id }}">
        <div class="max-w-6xl mx-auto px-4">
          <div class="max-w-[720px]">
            {%- if b.eyebrow != blank -%}<p class="text-[12px] font-extrabold uppercase tracking-[.14em] text-primary">{{ b.eyebrow }}</p>{%- endif -%}
            <h2 id="pp-lb-{{ block.id }}" class="mt-1 font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ b.heading }}</h2>
            {%- if b.intro != blank -%}<p class="mt-3 text-[16px] sm:text-[17px] text-ink">{{ b.intro | replace: '[[', ph_open | replace: ']]', ph_close }}</p>{%- endif -%}
          </div>
          <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,.85fr)_minmax(0,1.15fr)] lg:items-start">
            <div class="min-w-0">
              {%- if b.label_asset != blank -%}
                <button type="button" class="block w-full cursor-zoom-in rounded-3xl overflow-hidden border border-line" data-pp-zoom="{{ b.label_asset | asset_url }}" data-pp-zoom-alt="{{ b.label_alt | escape }}" aria-label="Zoom in on the label">
                  <img src="{{ b.label_asset | asset_url }}" alt="{{ b.label_alt | escape }}" loading="lazy" width="1400" height="1400" class="w-full h-auto">
                </button>
                <p class="mt-2 text-center text-[13px] text-muted">Tap to zoom</p>
              {%- endif -%}
              {%- if b.other != blank -%}<p class="mt-4 text-[14px] text-ink"><strong>Other ingredients:</strong> {{ b.other }}</p>{%- endif -%}
              {%- if b.allergen != blank -%}<p class="mt-2 inline-flex rounded-full bg-soft px-3 py-1 text-[13px] font-bold text-berry">{{ b.allergen }}</p>{%- endif -%}
            </div>
            <div class="min-w-0">
              <ul class="grid gap-2.5 sm:grid-cols-2" role="list">
                {%- for l in ings -%}{%- assign f = l | strip | split: '|' -%}{%- if f[0] != blank -%}
                  <li class="rounded-2xl border border-line bg-soft p-4"><p class="font-display font-bold text-[17px] text-ink">{{ f[0] | strip | replace: '[[', ph_open | replace: ']]', ph_close }}</p>{%- if f[1] -%}<p class="mt-1 text-[14px] leading-relaxed text-muted">{{ f[1] | strip | replace: '[[', ph_open | replace: ']]', ph_close }}</p>{%- endif -%}</li>
                {%- endif -%}{%- endfor -%}
              </ul>
              <div class="mt-5 rounded-2xl bg-mint border border-line p-5">
                <p class="flex items-center gap-2 font-display font-bold text-[18px] text-primary-dark"><span aria-hidden="true">{%- render 'parapatrol-icon', name: 'check', icon_size: 18 -%}</span>{{ b.test_heading }}</p>
                <p class="mt-1.5 text-[15px] text-ink">{{ b.test_text | replace: '[[', ph_open | replace: ']]', ph_close }}</p>
                {%- if b.cert_label != blank -%}
                  {%- if b.cert_url != blank -%}<a href="{{ b.cert_url }}" target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1.5 font-extrabold text-primary-dark underline underline-offset-4">{{ b.cert_label }} →</a>
                  {%- else -%}<p class="mt-3 text-[14px]">{{ b.cert_label | replace: '[[', ph_open | replace: ']]', ph_close }}</p>{%- endif -%}
                {%- endif -%}
                {%- if b.aust_l != blank -%}<p class="mt-3 text-[14px] font-bold text-ink">{{ b.aust_l }}</p>{%- endif -%}
                {%- if b.practitioner != blank -%}<p class="mt-3 text-[14px] text-ink">{{ b.practitioner }}</p>{%- endif -%}
              </div>
            </div>
          </div>
        </div>
      </section>

    {%- when 'reviews' -%}
      {%- assign jm = product.metafields.judgeme.review_widget_data.value -%}
      <section data-pp-band="{{ b.band | default: 'auto' }}" id="reviews" class="py-12 lg:py-16 bg-soft scroll-mt-24" {{ block.shopify_attributes }} aria-labelledby="pp-rv-{{ block.id }}">
        <div class="max-w-6xl mx-auto px-4">
          <div class="text-center max-w-[680px] mx-auto">
            {%- if b.eyebrow != blank -%}<p class="text-[12px] font-extrabold uppercase tracking-[.14em] text-primary">{{ b.eyebrow }}</p>{%- endif -%}
            <h2 id="pp-rv-{{ block.id }}" class="mt-1 font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ b.heading }}</h2>
            {%- if b.intro != blank -%}<p class="mt-3 text-[16px] sm:text-[17px] text-muted">{{ b.intro }}</p>{%- endif -%}
          </div>
          <div class="mt-8 rounded-[28px] bg-white border border-line p-5 sm:p-8 shadow-soft" data-pp-jm data-shop="{{ shop.permanent_domain }}" data-pid="{{ product.id }}" data-per="{{ b.per_page | default: 6 }}">
            <div class="grid gap-6 md:grid-cols-[minmax(0,.8fr)_minmax(0,1.2fr)] md:items-center pb-6 border-b border-line">
              <div class="text-center md:text-left">
                <p class="font-display font-bold text-[56px] leading-none text-ink" data-pp-jm-avg>–</p>
                <p class="mt-2 flex justify-center md:justify-start" data-pp-jm-stars aria-hidden="true"></p>
                <p class="mt-1.5 text-[15px] font-bold text-muted" data-pp-jm-count>Loading reviews…</p>
              </div>
              <ul class="grid gap-2" role="list" data-pp-jm-hist></ul>
            </div>
            {%- if b.filters != blank -%}
              <div class="mt-5 flex flex-wrap gap-2" role="group" aria-label="Filter reviews" data-pp-jm-filters>
                <button type="button" class="disable-global-button-styling pp-chip" aria-pressed="true" data-pp-jm-f="">All</button>
                {%- assign fl = b.filters | newline_to_br | split: '<br />' -%}
                {%- for l in fl -%}{%- assign f = l | strip | split: '|' -%}{%- if f.size >= 2 -%}
                  <button type="button" class="disable-global-button-styling pp-chip" aria-pressed="false" data-pp-jm-f="{{ l | strip | remove_first: f[0] | remove_first: '|' | strip | escape }}" hidden>{{ f[0] | strip }}</button>
                {%- endif -%}{%- endfor -%}
              </div>
              <p class="mt-3 text-[14px] font-bold text-muted" data-pp-jm-fcount aria-live="polite" hidden></p>
            {%- endif -%}
            <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list" data-pp-jm-list></ul>
            <div class="mt-6 text-center"><button type="button" class="hidden min-h-[50px] px-8 rounded-full border-2 border-primary text-primary-dark font-extrabold text-[15px] hover:bg-mint" data-pp-jm-more>Show more reviews</button></div>
          </div>
          {%- if b.note != blank -%}<p class="mt-4 text-center text-[12px] text-muted">{{ b.note }}</p>{%- endif -%}
        </div>
      </section>

    {%- when 'howto' -%}
      {%- assign dose = b.dose | newline_to_br | split: '<br />' -%}
      <section data-pp-band="{{ b.band | default: 'auto' }}" class="py-12 lg:py-16 bg-white" {{ block.shopify_attributes }} aria-labelledby="pp-ht-{{ block.id }}">
        <div class="max-w-6xl mx-auto px-4 grid gap-8 lg:grid-cols-2 lg:items-center">
          <div class="min-w-0">
            {%- if b.video_url != blank -%}
              <video class="w-full aspect-square rounded-3xl object-cover bg-soft" src="{{ b.video_url }}" {% if b.poster != blank %}poster="{{ b.poster | asset_url }}"{% endif %} autoplay muted loop playsinline aria-label="{{ b.video_alt | escape }}"></video>
            {%- else -%}
              <div class="relative">
                {%- render 'parapatrol-media', asset: b.poster, alt: b.video_alt, label: '', class: 'aspect-square rounded-3xl', sizes: '(min-width: 1024px) 560px, 100vw' -%}
                <p class="absolute inset-x-3 bottom-3"><mark class="pp-ph">[[VIDEO — 10-second loop: one dropper into juice, child drinks it]]</mark></p>
              </div>
            {%- endif -%}
          </div>
          <div class="min-w-0">
            {%- if b.eyebrow != blank -%}<p class="text-[12px] font-extrabold uppercase tracking-[.14em] text-primary">{{ b.eyebrow }}</p>{%- endif -%}
            <h2 id="pp-ht-{{ block.id }}" class="mt-1 font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ b.heading }}</h2>
            <div class="mt-6 rounded-2xl border border-line overflow-hidden">
              <table class="w-full text-left text-[15px]">
                <thead class="bg-mint"><tr><th class="p-3 font-extrabold text-primary-dark">Age</th><th class="p-3 font-extrabold text-primary-dark">Dose</th><th class="p-3 font-extrabold text-primary-dark">How often</th></tr></thead>
                <tbody>
                  {%- assign n_dose = 0 -%}
                  {%- for l in dose -%}{%- assign f = l | strip | split: '|' -%}{%- if f.size >= 3 -%}{%- assign n_dose = n_dose | plus: 1 -%}
                    <tr class="border-t border-line"><td class="p-3 font-bold text-ink">{{ f[0] | strip }}</td><td class="p-3 text-ink">{{ f[1] | strip }}</td><td class="p-3 text-ink">{{ f[2] | strip }}</td></tr>
                  {%- endif -%}{%- endfor -%}
                  {%- if n_dose == 0 -%}<tr><td colspan="3" class="p-3"><mark class="pp-ph">[[DOSE TABLE FROM LABEL — age | dose | how often]]</mark></td></tr>{%- endif -%}
                </tbody>
              </table>
            </div>
            {%- if b.line != blank -%}<p class="mt-5 font-display font-bold text-[22px] leading-snug text-primary-dark">{{ b.line }}</p>{%- endif -%}
            {%- if b.small != blank -%}<p class="mt-2 text-[14px] text-muted">{{ b.small }}</p>{%- endif -%}
          </div>
        </div>
      </section>

    {%- when 'close' -%}
      {%- assign pp_prod = all_products[b.product] | default: product -%}
      {%- assign pp_v = pp_prod.selected_or_first_available_variant -%}
      <section data-pp-band="{{ b.band | default: 'auto' }}" class="py-12 lg:py-16 bg-primary-dark text-white" {{ block.shopify_attributes }} aria-labelledby="pp-cl-{{ block.id }}">
        <div class="max-w-[640px] mx-auto px-4 text-center">
          <span class="w-16 h-16 rounded-full bg-mintfill text-primary-dark inline-flex items-center justify-center" aria-hidden="true">{%- render 'parapatrol-icon', name: 'shield', icon_size: 30 -%}</span>
          <h2 id="pp-cl-{{ block.id }}" class="pp-adv-light-h mt-4 font-display font-bold text-[32px] sm:text-[42px] leading-[1.08]">{{ b.heading }}</h2>
          {%- if b.text != blank -%}<p class="mt-3 text-[17px] text-white/90">{{ b.text }}</p>{%- endif -%}
          {%- if b.terms_label != blank -%}<a href="{{ b.terms_url | default: '/policies/refund-policy' }}" class="mt-2 inline-block text-[14px] font-bold text-white underline underline-offset-4">{{ b.terms_label }}</a>{%- endif -%}
          <div class="mt-7 rounded-3xl bg-white text-ink p-5 sm:p-6">
            {%- if b.offer != blank -%}<p class="font-display font-bold text-[24px] text-primary-dark">{{ b.offer | replace: '[[', ph_open | replace: ']]', ph_close }}</p>{%- endif -%}
            {%- if pp_v -%}
              <p class="mt-1 text-[15px] text-muted">One bottle: <strong class="text-ink">{{ pp_v.price | money }}</strong>
              {%- assign serv = b.servings | plus: 0 -%}
              {%- if serv > 0 %} · about <strong class="text-ink">{{ pp_v.price | divided_by: serv | money }}</strong> a day{%- else %} · <mark class="pp-ph">[[$ PER DAY — needs servings per bottle]]</mark>{%- endif -%}</p>
            {%- endif -%}
            <a href="#pp-buy" data-pp-to-buy class="mt-5 flex w-full items-center justify-center gap-2 min-h-[56px] px-8 rounded-full bg-primary hover:bg-primary-dark text-white font-extrabold text-[17px] shadow-lift transition-colors">{{ b.cta_label | default: 'Add to cart' }}</a>
            {%- if s.mandatory != blank -%}<p class="mt-3 text-[13px] font-bold text-muted">{{ s.mandatory }}</p>{%- endif -%}
          </div>
        </div>
      </section>


    {%- when 'profiles' -%}
      {%- assign profs = b.profiles | newline_to_br | split: '<br />' -%}
      <section data-pp-band="{{ b.band | default: 'auto' }}" class="py-12 lg:py-16 bg-soft" {{ block.shopify_attributes }} aria-labelledby="pp-pf-{{ block.id }}" data-pp-profiles>
        <div class="max-w-[820px] mx-auto px-4">
          {%- if b.eyebrow != blank -%}<p class="text-[12px] font-extrabold uppercase tracking-[.14em] text-mintdeep">{{ b.eyebrow }}</p>{%- endif -%}
          <h2 id="pp-pf-{{ block.id }}" class="mt-1 font-display font-extrabold text-[28px] sm:text-[40px] leading-[1.1] text-ink">{{ b.heading }}</h2>
          {%- if b.intro != blank -%}<p class="mt-3 text-[16px] sm:text-[17px] text-ink">{{ b.intro }}</p>{%- endif -%}
          <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-2.5" role="tablist" aria-label="{{ b.heading | escape }}">
            {%- assign pn = 0 -%}
            {%- for l in profs -%}{%- assign f = l | strip | split: '|' -%}{%- if f.size >= 4 -%}
              <button type="button" role="tab" id="pp-pft-{{ block.id }}-{{ pn }}" aria-controls="pp-pfp-{{ block.id }}-{{ pn }}" aria-selected="{% if pn == 0 %}true{% else %}false{% endif %}" tabindex="{% if pn == 0 %}0{% else %}-1{% endif %}" data-pp-prof-tab="{{ pn }}" class="disable-global-button-styling pp-prof-tab flex flex-col items-center gap-2 rounded-2xl bg-white border border-line px-2 py-4 text-center">
                <span class="w-11 h-11 rounded-full bg-mint text-ink inline-flex items-center justify-center" aria-hidden="true">{%- assign pi = f[0] | strip -%}{%- render 'parapatrol-icon', name: pi, icon_size: 24 -%}</span>
                <span class="text-[13px] sm:text-[14px] font-extrabold leading-tight text-ink">{{ f[1] | strip }}</span>
              </button>
              {%- assign pn = pn | plus: 1 -%}
            {%- endif -%}{%- endfor -%}
          </div>
          {%- assign pn = 0 -%}
          {%- for l in profs -%}{%- assign f = l | strip | split: '|' -%}{%- if f.size >= 4 -%}
            <div role="tabpanel" id="pp-pfp-{{ block.id }}-{{ pn }}" aria-labelledby="pp-pft-{{ block.id }}-{{ pn }}" data-pp-prof-panel="{{ pn }}" class="mt-4 rounded-2xl bg-white border border-line p-5 sm:p-6"{% if pn > 0 %} hidden{% endif %}>
              <p class="font-display font-extrabold text-[20px] sm:text-[22px] text-ink">{{ f[1] | strip }}</p>
              <p class="mt-2 text-[16px] sm:text-[17px] italic text-ink">“{{ f[2] | strip }}”</p>
              <p class="mt-3 flex gap-2.5 text-[16px] text-ink"><span class="mt-0.5 inline-flex w-5 h-5 shrink-0 rounded-full bg-mintdeep text-white items-center justify-center" aria-hidden="true">{%- render 'parapatrol-icon', name: 'check', icon_size: 12 -%}</span><span>{%- render 'parapatrol-claim', text: f[3] -%}</span></p>
              {%- if b.link_label != blank -%}<a href="#pp-buy" data-pp-to-buy class="mt-4 inline-block font-extrabold text-mintdeep underline underline-offset-4">{{ b.link_label }} &rarr;</a>{%- endif -%}
            </div>
            {%- assign pn = pn | plus: 1 -%}
          {%- endif -%}{%- endfor -%}
        </div>
      </section>

    {%- when 'videos' -%}
      {%- liquid
        assign vids = 0
        for i in (1..8)
          assign vk = 'video_' | append: i
          if b[vk] != blank
            assign vids = vids | plus: 1
          endif
        endfor
      -%}
      {%- if vids > 0 or request.design_mode -%}
      <section data-pp-band="{{ b.band | default: 'auto' }}" class="py-12 lg:py-16 bg-white" {{ block.shopify_attributes }} aria-labelledby="pp-vd-{{ block.id }}">
        <div class="max-w-6xl mx-auto px-4">
          <div class="max-w-[720px] mx-auto text-center">
