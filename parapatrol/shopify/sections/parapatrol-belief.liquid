                <span class="text-[11px] sm:text-[12px] font-extrabold uppercase tracking-wide text-muted">{{ f[0] | strip }}</span>
                <span class="text-[13px] sm:text-[15px] font-extrabold leading-tight text-ink">{{ f[1] | strip | replace: '[[', ph_open | replace: ']]', ph_close }}</span>
              </li>
            {%- endif -%}{%- endfor -%}
          </ol>
          {%- if b.button != blank -%}<a href="#pp-buy" data-pp-to-buy class="mt-7 inline-flex min-h-[56px] items-center justify-center rounded-xl border-2 border-ink px-8 font-bold text-[16px] text-ink hover:bg-white">{{ b.button }}</a>{%- endif -%}
        </div>
      </section>
