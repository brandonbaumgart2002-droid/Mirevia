<script>
  (function () {
    // "Sound like your house?" tiles: one tab open at a time, arrow keys move between tiles
    document.querySelectorAll('[data-pp-profiles]').forEach(function (sec) {
      if (sec.__ppPf) return; sec.__ppPf = true;
      var tabs = [].slice.call(sec.querySelectorAll('[data-pp-prof-tab]'));
      function show(i) {
        tabs.forEach(function (t, k) { var on = k === i; t.setAttribute('aria-selected', on ? 'true' : 'false'); t.tabIndex = on ? 0 : -1; });
        sec.querySelectorAll('[data-pp-prof-panel]').forEach(function (p) { p.hidden = +p.getAttribute('data-pp-prof-panel') !== i; });
      }
      tabs.forEach(function (t, k) {
        t.addEventListener('click', function () { show(k); });
        t.addEventListener('keydown', function (e) {
          var d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0; if (!d) return;
          e.preventDefault(); var n = (k + d + tabs.length) % tabs.length; show(n); tabs[n].focus();
        });
      });
    });
  })();
</script>
<script>
  (function () {
    var STAR = '<svg width="SZ" height="SZ" viewBox="0 0 24 24" aria-hidden="true"><path fill="FILL" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.2 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>';
    function stars(n, sz) { var h = ''; for (var i = 1; i <= 5; i++) h += STAR.replace(/SZ/g, sz).replace('FILL', i <= Math.round(n) ? 'var(--pp-star)' : 'var(--pp-star-empty)'); return h; }
    function esc(t) { var d = document.createElement('div'); d.textContent = t || ''; return d.innerHTML; }
    function strip(h) { var d = document.createElement('div'); d.innerHTML = h || ''; return d.textContent.trim(); }
    // Imported bodies end with "Mother of Harry age 5. Verified Buyer." Move that sign-off into the name line.
    var SIGN = /\s*((?:Mother|Father|Mum|Mom|Dad|Parent|Grandmother|Grandfather|Nan|Grandma|Grandpa|Aunt|Uncle|Guardian) of [^.]+?)\.?\s*(?:Verified Buyer\.?)?\s*$/i;
    function split(text) {
      var t = text.replace(/\s*Verified Buyer\.?\s*$/i, '');
      var m = t.match(SIGN);
      if (!m) return { body: t, by: '', ages: [] };
      var ages = (m[1].match(/age\s+(\d+)/gi) || []).map(function (a) { return +a.replace(/\D/g, ''); });
      var by = m[1].replace(/\s+age\s+(\d+)/gi, ', age $1');
      return { body: t.slice(0, m.index).trim(), by: by.charAt(0).toUpperCase() + by.slice(1), ages: ages };
    }
    function prep(r) { if (!r.__pp) { r.__pp = split(strip(r.body_html)); } return r; }
    // Filter value "text:word|word" matches the review text; "age:3-5" matches a child's age in the sign-off
    function matches(r, f) {
      if (!f) return true;
      var i = f.indexOf(':'), kind = f.slice(0, i), arg = f.slice(i + 1), p = prep(r).__pp;
      if (kind === 'age') { var lo = +arg.split('-')[0], hi = +(arg.split('-')[1] || 99); return p.ages.some(function (a) { return a >= lo && a <= hi; }); }
      try { return new RegExp(arg, 'i').test((r.title || '') + ' ' + p.body); } catch (e) { return false; }
    }
    function card(r) {
      var p = prep(r).__pp, li = document.createElement('li');
      li.className = 'rounded-2xl bg-white border border-line p-5 flex flex-col';
      var pics = (r.pictures_urls || []).slice(0, 3).map(function (x) { var u = x.compact || x.small || x.original || x; return '<img src="' + esc(u) + '" alt="" loading="lazy" class="w-16 h-16 rounded-xl object-cover">'; }).join('');
      li.innerHTML = '<div class="flex">' + stars(r.rating, 16) + '</div>' +
        (r.title ? '<p class="mt-2.5 font-display font-extrabold text-[18px] leading-snug text-ink">' + esc(r.title) + '</p>' : '') +
        '<p class="mt-1.5 flex-1 text-[15px] leading-relaxed text-ink">' + esc(p.body) + '</p>' +
        (pics ? '<div class="mt-3 flex gap-2">' + pics + '</div>' : '') +
        '<p class="mt-4 flex items-center gap-2 text-[14px] font-bold text-ink"><span class="w-8 h-8 shrink-0 rounded-full bg-mint text-ink inline-flex items-center justify-center text-[13px]">' + esc(r.reviewer_initial || (r.reviewer_name || '?').charAt(0)) + '</span>' + esc(p.by || r.reviewer_name || '') + (r.verified_buyer ? ' <span class="text-mintdeep text-[12px]">✓ Verified buyer</span>' : '') + '</p>';
      return li;
    }
    document.querySelectorAll('[data-pp-jm]').forEach(function (box) {
      if (box.__ppJm) return; box.__ppJm = true;
      var shop = box.dataset.shop, pid = box.dataset.pid, per = +box.dataset.per || 6, page = 1, total = 0, shown = 0;
      var list = box.querySelector('[data-pp-jm-list]'), more = box.querySelector('[data-pp-jm-more]');
      var chips = [].slice.call(box.querySelectorAll('[data-pp-jm-f]')), fcount = box.querySelector('[data-pp-jm-fcount]');
      var filter = '', all = null, fshown = 0;
      function url(p, n) { return 'https://api.judge.me/reviews/reviews_for_widget?url=' + shop + '&shop_domain=' + shop + '&platform=shopify&page=' + p + '&per_page=' + n + '&product_id=' + pid; }
      function get(p, n) { return fetch(url(p, n)).then(function (r) { return r.json(); }); }
      function header(d) {
        total = d.number_of_reviews || 0;
        box.querySelector('[data-pp-jm-avg]').textContent = total ? String(+(+d.average_rating).toFixed(2)) : '–';
        box.querySelector('[data-pp-jm-stars]').innerHTML = stars(+d.average_rating || 0, 26);
        box.querySelector('[data-pp-jm-count]').textContent = total ? 'Based on ' + total + ' review' + (total === 1 ? '' : 's') : 'No reviews yet';
        box.querySelector('[data-pp-jm-hist]').innerHTML = (d.histogram || []).map(function (h) {
          return '<li class="flex items-center gap-3 text-[13px] font-bold text-muted"><span class="w-10 shrink-0">' + h.rating + ' ★</span><span class="flex-1 h-2 rounded-full bg-mint overflow-hidden"><span class="block h-full rounded-full bg-ink" style="width:' + h.percentage + '%"></span></span><span class="w-8 text-right">' + h.frequency + '</span></li>';
        }).join('');
      }
      // Unfiltered: page through the API as before
      function load() {
        more.disabled = true;
        get(page, per).then(function (d) {
          if (page === 1) header(d);
          (d.reviews || []).forEach(function (r) { list.appendChild(card(r)); shown++; });
          more.classList.toggle('hidden', shown >= total);
          more.disabled = false; page++;
        }).catch(function () { box.querySelector('[data-pp-jm-count]').textContent = 'Reviews could not load. Please refresh.'; });
      }
      // Filters need every review: fetch all pages once (30 per call), then show only chips with matches
      function loadAll() {
        if (all) return all;
        all = get(1, 30).then(function (d) {
          var n = Math.ceil((d.number_of_reviews || 0) / 30), reqs = [];
          for (var p = 2; p <= n; p++) reqs.push(get(p, 30));
          return Promise.all(reqs).then(function (rest) {
            var seen = {}, out = [];
            [d].concat(rest).forEach(function (x) { (x.reviews || []).forEach(function (r) { var k = r.uuid || (r.created_at + r.reviewer_name); if (!seen[k]) { seen[k] = 1; out.push(r); } }); });
            return out;
          });
        });
        return all;
      }
      function renderFiltered(reset) {
        loadAll().then(function (rs) {
          var m = rs.filter(function (r) { return matches(r, filter); });
          if (reset) { list.innerHTML = ''; fshown = 0; }
          m.slice(fshown, fshown + per).forEach(function (r) { list.appendChild(card(r)); });
          fshown = Math.min(m.length, fshown + per);
          more.classList.toggle('hidden', fshown >= m.length);
          if (fcount) { fcount.hidden = false; fcount.textContent = m.length + ' review' + (m.length === 1 ? '' : 's') + ' match'; }
        });
      }
      more.addEventListener('click', function () { if (filter) renderFiltered(false); else load(); });
      chips.forEach(function (c) {
        c.addEventListener('click', function () {
          var f = c.getAttribute('data-pp-jm-f');
          chips.forEach(function (x) { x.setAttribute('aria-pressed', x === c ? 'true' : 'false'); });
          filter = f;
          if (!f) { list.innerHTML = ''; shown = 0; page = 1; if (fcount) fcount.hidden = true; load(); return; }
          renderFiltered(true);
        });
      });
      load();
      if (chips.length > 1) {
        var go = function () { loadAll().then(function (rs) { chips.forEach(function (c) { var f = c.getAttribute('data-pp-jm-f'); if (f) c.hidden = !rs.some(function (r) { return matches(r, f); }); }); }); };
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (es) { if (es.some(function (e) { return e.isIntersecting; })) { io.disconnect(); go(); } }, { rootMargin: '600px' });
          io.observe(box);
        } else go();
      }
    });
  })();
</script>
