{%- comment -%} Guarantee strip: the 30-day promise as its own band, for parents who never open the gallery. {%- endcomment -%}
{{ 'parapatrol.css' | asset_url | stylesheet_tag }}
<div class="pp">
  <section class="bg-mint py-10 lg:py-14" aria-labelledby="pp-guar-{{ section.id }}">
    <div class="max-w-4xl mx-auto px-4 flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-8">
      <span class="w-16 h-16 sm:w-20 sm:h-20 shrink-0 rounded-full bg-white text-primary inline-flex items-center justify-center shadow-soft">{%- render 'parapatrol-icon', name: 'shield', icon_size: 34 -%}</span>
      <div>
        <h2 id="pp-guar-{{ section.id }}" class="font-display font-semibold text-[26px] sm:text-[32px] leading-[1.15]">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="mt-2 text-[16px] sm:text-[17px] text-ink/90 max-w-2xl">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "ParaPatrol: guarantee",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try it for 30 days, risk-free." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "If ParaPatrol isn't right for your family, contact our team within 30 days and we'll refund you. No awkward questions." }
  ],
  "presets": [ { "name": "ParaPatrol: guarantee" } ]
}
{% endschema %}
