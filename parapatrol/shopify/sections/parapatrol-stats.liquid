{%- comment -%}
  "Numbers that speak": outcome stats from ParaPatrol's own customers.
  Hidden from shoppers until every stat has a real number (no [VERIFY]), the source line is filled in
  and the confirmation box is ticked. In the theme editor it always shows, with a setup note.
  Any stat that touches tummy or digestion keeps its * so it links to the FDA disclaimer.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign ready = s.confirmed
  if s.source == blank or s.source contains 'VERIFY'
    assign ready = false
  endif
  for block in section.blocks
    if block.settings.number == blank or block.settings.number contains 'VERIFY'
      assign ready = false
    endif
  endfor
-%}
{%- if ready or request.design_mode -%}
{{ 'parapatrol.css' | asset_url | stylesheet_tag }}
<div class="pp">
  <section class="bg-soft py-12 lg:py-20" aria-labelledby="pp-stats-{{ section.id }}">
    <div class="max-w-6xl mx-auto px-4">
      {%- unless ready -%}
        <p class="mb-4 text-[13px]">[SETUP] Stats are hidden from shoppers until every number is real, the source line is filled in and the confirmation box is ticked.</p>
      {%- endunless -%}
      <div class="max-w-2xl">
        {%- if s.eyebrow != blank -%}<p class="text-sm font-bold uppercase tracking-[.14em] text-berry">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 id="pp-stats-{{ section.id }}" class="font-display font-semibold text-[30px] sm:text-[38px] leading-[1.1] mt-2">{{ s.heading }}</h2>
      </div>
      <ul class="mt-8 grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4" role="list">
        {%- for block in section.blocks -%}
          <li class="bg-white rounded-3xl p-5 sm:p-6 shadow-soft flex flex-col" {{ block.shopify_attributes }}>
            <p class="font-display font-semibold text-[40px] sm:text-[52px] leading-none text-primary">{{ block.settings.number }}</p>
            <p class="mt-2 text-[15px] sm:text-[17px] font-medium leading-snug">{%- render 'parapatrol-claim', text: block.settings.label -%}</p>
          </li>
        {%- endfor -%}
      </ul>
      {%- if s.source != blank -%}
        <p class="mt-5 text-[12px] leading-snug text-muted">{{ s.source }}</p>
      {%- endif -%}
    </div>
  </section>
</div>
{%- endif -%}
{% schema %}
{
  "name": "ParaPatrol: stats",
  "settings": [
    { "type": "paragraph", "content": "Every number must come from your own customers (a survey or a count of your reviews), and the source line must say which. Hidden from shoppers until the box at the bottom is ticked." },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Numbers that speak" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What parents tell us" },
    { "type": "text", "id": "source", "label": "Source line", "info": "e.g. Based on a survey of 212 ParaPatrol parents, March 2026.", "default": "[VERIFY: Based on a survey of ___ ParaPatrol parents, month year.]" },
    { "type": "checkbox", "id": "confirmed", "label": "These numbers are from our own customers and the source is accurate", "default": false }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "info": "e.g. 94%" },
        { "type": "text", "id": "label", "label": "What it measures", "info": "Keep a * on anything about tummy or digestion." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "ParaPatrol: stats", "blocks": [ { "type": "stat" }, { "type": "stat" }, { "type": "stat" } ] } ]
}
{% endschema %}
