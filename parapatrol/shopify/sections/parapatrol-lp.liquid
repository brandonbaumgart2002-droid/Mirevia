                <div class="mt-4 grid gap-2.5">{%- for l in wy -%}{%- assign f = l | strip | split: '|' -%}{%- if f.size >= 3 -%}<div class="flex items-start gap-3 rounded-2xl bg-white px-4 py-3"><span class="w-9 h-9 shrink-0 rounded-xl bg-mint inline-flex items-center justify-center text-[18px]" aria-hidden="true">{{ f[0] | strip }}</span><span><span class="block font-bold text-[15px] text-ink">{{ f[1] | strip }}</span><span class="block text-[14px] text-muted">{%- assign pp_v = f[2] | strip -%}{%- render 'parapatrol-claim', text: pp_v -%}</span></span></div>{%- endif -%}{%- endfor -%}</div>
