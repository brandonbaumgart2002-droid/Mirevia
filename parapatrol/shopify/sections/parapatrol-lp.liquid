              <p class="mt-6 rounded-2xl border border-[#d6e7dd] bg-mint px-5 py-4 text-center text-[16px] leading-relaxed text-ink">{{ bs.stat }}{% if bs.stat_source != blank %} <span class="text-[13px] text-muted">({% if bs.stat_url != blank %}<a href="{{ bs.stat_url }}" target="_blank" rel="noopener" class="underline underline-offset-2">{{ bs.stat_source }}</a>{% else %}{{ bs.stat_source }}{% endif %})</span>{% endif %}</p>
            {%- endif -%}
            {%- if bs.text != blank -%}<div class="pp-adv-copy mt-6">{%- render 'parapatrol-claim', text: bs.text -%}</div>{%- endif -%}
            {%- if bs.link_label != blank -%}<a href="#{{ bs.link_to | default: 'kit' }}" class="mt-5 inline-flex items-center gap-1.5 font-extrabold text-primary underline underline-offset-4">{{ bs.link_label }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12l7 7 7-7"/></svg></a>{%- endif -%}
          </div>
        </section>

      {%- when 'kit' -%}
        <section class="py-12 lg:py-16 bg-mint" id="{{ bs.anchor | default: 'kit' }}" {{ block.shopify_attributes }}>
