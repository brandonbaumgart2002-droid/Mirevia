                    <p class="flex items-center gap-2.5 font-display font-bold text-[21px] text-ink"><span class="w-9 h-9 rounded-xl bg-mint text-primary inline-flex items-center justify-center" aria-hidden="true">{%- assign pp_v = f[0] | strip -%}{%- render 'parapatrol-icon', name: pp_v, icon_size: 18 -%}</span>{{ f[1] | strip }}</p>
