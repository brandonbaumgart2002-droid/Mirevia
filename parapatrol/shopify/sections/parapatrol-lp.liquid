                {%- render 'parapatrol-media', image: bs.image, asset: bs.asset, alt: bs.alt, label: bs.heading, class: 'aspect-[4/3] rounded-3xl shadow-lift', sizes: '(min-width: 1024px) 560px, 100vw' -%}
