                    {%- for l in cm -%}{%- assign f = l | strip | split: '|' -%}{%- if f.size >= 2 -%}
                      <li class="snap-start shrink-0 w-[88%] sm:w-[380px] rounded-2xl bg-white p-4 shadow-soft">
                        <div class="flex gap-3">
                          <span class="w-10 h-10 shrink-0 rounded-full bg-primary text-white inline-flex items-center justify-center font-display font-bold text-[17px]" aria-hidden="true">{{ f[1] | strip | slice: 0 }}</span>
                          <div class="min-w-0 rounded-2xl bg-[#f0f2f5] px-3.5 py-2.5">
                            <p class="text-[14px] font-extrabold text-ink">{{ f[1] | strip }}</p>
