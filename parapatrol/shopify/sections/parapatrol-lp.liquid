{%- comment -%}
  Long-form landing page for cold traffic (layout modelled on a proven kids' cleanse LP):
  hero → problem → "does this sound like your child?" → solution → ingredients → routine → timeline →
  reviews → comparison → guarantee → FAQ → offer → trust row, with a sticky button and CTA buttons between.
  Each block is one full-width module. Repeating items are one per line, fields split with |.
  Copy rules: everyday gut comfort, digestion, appetite and regularity only. No parasite removal, "detox",
  worm, behaviour, skin or condition claims, no invented stats, studies, founders or customer counts.
  Claims keep their * so they link to the FDA disclaimer (#pp-fda): keep the disclaimer section on the template.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign lp = s.product
  assign lp_url = s.product_link | default: lp.url | default: routes.all_products_collection_url
-%}
{{ 'parapatrol.css' | asset_url | stylesheet_tag }}
<div class="pp pp-lp bg-white">

  {%- if s.marquee != blank -%}
    {%- assign mq = s.marquee | split: '|' -%}
    <div class="bg-mint border-b border-[#d6e7dd] overflow-hidden" aria-hidden="true">
      <div class="pp-lp-marquee flex w-max gap-3 py-2.5">
        {%- for r in (1..2) -%}
          {%- for m in mq -%}
            <span class="shrink-0 inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 text-[13px] font-bold text-primary-dark shadow-soft"><span class="text-primary">{%- render 'parapatrol-icon', name: 'check', icon_size: 13 -%}</span>{{ m | strip }}</span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- assign bs = block.settings -%}
    {%- case block.type -%}

      {%- when 'hero' -%}
        <section class="bg-mint" {{ block.shopify_attributes }} aria-labelledby="pp-lp-h-{{ block.id }}">
          <div class="max-w-6xl mx-auto px-4 pt-8 pb-10 lg:pt-14 lg:pb-16 grid gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,.95fr)] lg:items-center">
            <div>
              {%- if bs.rating_text != blank -%}
                <p class="flex flex-wrap items-center gap-2 text-[14px] font-bold text-ink">{%- render 'parapatrol-stars', score: 5, size: 18 -%}<span>{{ bs.rating_text }}</span></p>
              {%- endif -%}
              {%- if bs.as_h2 -%}{%- assign h_tag = "h2" -%}{%- else -%}{%- assign h_tag = "h1" -%}{%- endif -%}<{{ h_tag }} id="pp-lp-h-{{ block.id }}" class="mt-3 font-display font-bold text-[34px] sm:text-[48px] leading-[1.06] text-ink">{{ bs.headline }}{% if bs.highlight != blank %} <span class="text-primary">{{ bs.highlight }}</span>{% endif %}{% if bs.headline_end != blank %} {{ bs.headline_end }}{% endif %}</{{ h_tag }}>
              {%- if bs.subhead != blank -%}<p class="mt-4 text-[17px] sm:text-[19px] leading-relaxed text-muted">{%- render 'parapatrol-claim', text: bs.subhead -%}</p>{%- endif -%}
              {%- assign items = bs.benefits | newline_to_br | split: '<br />' -%}
              <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-4" role="list">
                {%- for l in items -%}
                  {%- assign f = l | strip | split: '|' -%}
                  {%- if f.size >= 2 -%}
                    <li class="flex items-start gap-2.5">
                      <span class="mt-0.5 w-9 h-9 shrink-0 rounded-xl bg-white text-primary inline-flex items-center justify-center shadow-soft" aria-hidden="true">{%- assign pp_v = f[0] | strip -%}{%- render 'parapatrol-icon', name: pp_v, icon_size: 18 -%}</span>
                      <span class="min-w-0"><span class="block font-display font-bold text-[15px] sm:text-[16px] leading-tight text-ink">{{ f[1] | strip }}</span>{% if f[2] %}<span class="block mt-0.5 text-[13px] leading-snug text-muted">{%- assign pp_v = f[2] | strip -%}{%- render 'parapatrol-claim', text: pp_v -%}</span>{% endif %}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
              <a href="{{ lp_url }}" class="mt-7 flex w-full sm:w-auto sm:inline-flex items-center justify-center gap-2 min-h-[58px] px-8 rounded-full bg-primary hover:bg-primary-dark text-white font-extrabold text-[17px] shadow-lift transition-colors" data-pp-adv-cta>{{ bs.button_label | default: s.cta_label }}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
              {%- if s.cta_note != blank -%}<p class="mt-2.5 text-[13px] font-semibold text-muted sm:pl-4">✓ {{ s.cta_note }}</p>{%- endif -%}
            </div>
            <div class="relative mx-auto w-full max-w-[520px] aspect-square">
              {%- assign photos = bs.photos | split: ',' -%}
              <div class="absolute inset-[16%] rounded-full overflow-hidden bg-white shadow-lift border-[6px] border-white">
                {%- if bs.image != blank or bs.asset != blank -%}
                  {%- render 'parapatrol-media', image: bs.image, asset: bs.asset, alt: bs.alt, label: 'ParaPatrol', class: 'w-full h-full', sizes: '(min-width: 1024px) 360px, 70vw', loading: 'eager', priority: true -%}
                {%- elsif lp.featured_image -%}
                  {{ lp.featured_image | image_url: width: 900 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1024px) 360px, 70vw', class: 'w-full h-full object-cover', alt: lp.title }}
                {%- endif -%}
              </div>
              {%- for ph in photos limit: 6 -%}
                {%- case forloop.index -%}
                  {%- when 1 -%}{%- assign pos = 'left-[2%] top-[4%] w-[30%]' -%}
                  {%- when 2 -%}{%- assign pos = 'right-[4%] top-[0%] w-[27%]' -%}
                  {%- when 3 -%}{%- assign pos = 'right-[-2%] top-[40%] w-[25%]' -%}
                  {%- when 4 -%}{%- assign pos = 'right-[10%] bottom-[0%] w-[29%]' -%}
                  {%- when 5 -%}{%- assign pos = 'left-[6%] bottom-[2%] w-[26%]' -%}
                  {%- else -%}{%- assign pos = 'left-[-3%] top-[42%] w-[22%]' -%}
                {%- endcase -%}
                <div class="absolute {{ pos }} aspect-square rounded-full overflow-hidden border-4 border-white shadow-lift" aria-hidden="true">
                  {%- assign pp_v = ph | strip -%}{%- render 'parapatrol-media', asset: pp_v, alt: '', label: '', class: 'w-full h-full', sizes: '160px' -%}
                </div>
              {%- endfor -%}
              <span class="absolute left-[30%] top-[2%] text-berry" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10Z"/></svg></span>
              <span class="absolute right-[30%] bottom-[8%] text-accent" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10Z"/></svg></span>
            </div>
          </div>
        </section>

      {%- when 'story' -%}
        <section class="py-12 lg:py-16 {% if bs.tint %}bg-soft{% else %}pp-adv-sec{% endif %}" {{ block.shopify_attributes }} id="{{ bs.anchor | default: block.id }}">
          <div class="max-w-[760px] mx-auto px-4">
            {%- if bs.eyebrow != blank -%}<p class="text-[13px] font-extrabold uppercase tracking-[.14em] text-primary">{{ bs.eyebrow }}</p>{%- endif -%}
            <h2 class="mt-1 font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ bs.heading }}</h2>
            {%- if bs.image != blank or bs.asset != blank -%}
              {%- assign st_ratio = 'aspect-[4/3] rounded-3xl' -%}{%- if bs.square_image -%}{%- assign st_ratio = 'aspect-square rounded-3xl' -%}{%- endif -%}<div class="mt-6">{%- render 'parapatrol-media', image: bs.image, asset: bs.asset, alt: bs.alt, label: bs.heading, class: st_ratio, sizes: '(min-width: 800px) 728px, 100vw' -%}</div>
            {%- endif -%}
            {%- if bs.text != blank -%}<div class="pp-adv-copy mt-6">{%- render 'parapatrol-claim', text: bs.text -%}</div>{%- endif -%}
            {%- if bs.stat != blank -%}
              <div class="mt-6 rounded-2xl border-2 border-primary overflow-hidden">
                <p class="bg-mint px-5 py-4 text-center font-display font-bold text-[18px] sm:text-[20px] text-primary-dark">{{ bs.stat }}</p>
                {%- if bs.stat_note != blank -%}<p class="bg-primary px-5 py-2.5 text-center text-[14px] font-bold text-white">{{ bs.stat_note }}</p>{%- endif -%}
                {%- if bs.stat_source != blank -%}<p class="bg-white px-5 py-2 text-center text-[12px] text-muted">Source: {% if bs.stat_url != blank %}<a href="{{ bs.stat_url }}" target="_blank" rel="noopener" class="underline underline-offset-2">{{ bs.stat_source }}</a>{% else %}{{ bs.stat_source }}{% endif %}</p>{%- endif -%}
              </div>
            {%- endif -%}
            {%- if bs.text2 != blank -%}<div class="pp-adv-copy mt-6">{%- render 'parapatrol-claim', text: bs.text2 -%}</div>{%- endif -%}
            {%- if bs.warn != blank -%}<p class="mt-6 rounded-2xl bg-[#fdeef3] border-l-4 border-berry px-5 py-4 text-[16px] leading-relaxed text-[#7a2a4a]">{%- render 'parapatrol-claim', text: bs.warn -%}</p>{%- endif -%}
            {%- if bs.good != blank -%}<p class="mt-3 rounded-2xl bg-mint border-l-4 border-primary px-5 py-4 text-[16px] leading-relaxed text-primary-dark">{%- render 'parapatrol-claim', text: bs.good -%}</p>{%- endif -%}
            {%- render 'parapatrol-lp-acc', lines: bs.accordions -%}
            {%- if bs.button -%}{%- render 'parapatrol-lp-cta', url: lp_url, label: s.cta_label, note: s.cta_note -%}{%- endif -%}
          </div>
        </section>

      {%- when 'signs' -%}
        <section class="pp-adv-sec py-12 lg:py-16" {{ block.shopify_attributes }}>
          <div class="max-w-[760px] mx-auto px-4">
            <h2 class="font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ bs.heading }}</h2>
            {%- if bs.image != blank or bs.asset != blank -%}
              {%- assign sg_ratio = 'aspect-[4/3] rounded-3xl' -%}{%- if bs.square_image -%}{%- assign sg_ratio = 'aspect-square rounded-3xl' -%}{%- endif -%}<div class="mt-6">{%- render 'parapatrol-media', image: bs.image, asset: bs.asset, alt: bs.alt, label: bs.heading, class: sg_ratio, sizes: '(min-width: 800px) 728px, 100vw' -%}</div>
            {%- endif -%}
            {%- if bs.intro != blank -%}<p class="mt-5 text-[17px] text-ink">{{ bs.intro }}</p>{%- endif -%}
            {%- render 'parapatrol-lp-acc', lines: bs.items, emoji: true -%}
          </div>
          {%- if bs.banner != blank -%}
            <div class="mt-8 bg-accent"><p class="max-w-[760px] mx-auto px-4 py-5 text-center text-[16px] sm:text-[17px] leading-relaxed text-ink">{%- render 'parapatrol-claim', text: bs.banner -%}</p></div>
          {%- endif -%}
        </section>

      {%- when 'solution' -%}
        <section class="pp-adv-sec py-12 lg:py-16" {{ block.shopify_attributes }} id="{{ bs.anchor | default: 'solution' }}">
          <div class="max-w-[760px] mx-auto px-4">
            <h2 class="font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-primary">{{ bs.heading }}</h2>
            {%- if bs.image != blank or bs.asset != blank -%}
              <div class="mt-6 relative">
                {%- render 'parapatrol-media', image: bs.image, asset: bs.asset, alt: bs.alt, label: bs.heading, class: 'aspect-[4/3] rounded-3xl', sizes: '(min-width: 800px) 728px, 100vw' -%}
                {%- if bs.badges != blank -%}
                  {%- assign sb = bs.badges | newline_to_br | split: '<br />' -%}
                  <ul class="mt-3 grid grid-cols-2 gap-x-2.5 gap-y-3 sm:mt-0 sm:absolute sm:inset-x-4 sm:bottom-5 sm:flex sm:flex-wrap sm:gap-x-3.5 sm:gap-y-4" role="list">
                    {%- for l in sb -%}{%- assign f = l | strip | split: '|' -%}{%- if f.size >= 2 -%}
                      <li class="flex sm:inline-flex items-center gap-1.5 sm:gap-2.5 rounded-xl sm:rounded-2xl border-2 border-[#5aa58a] bg-[#f3f8f6] px-2.5 py-2 sm:px-4 sm:py-2.5 shadow-[3px_4px_0_#5aa58a] sm:shadow-[5px_6px_0_#5aa58a] font-display font-bold text-[13px] sm:text-[19px] leading-tight text-ink"><span class="text-[14px] sm:text-[24px] leading-none" aria-hidden="true">{{ f[0] | strip }}</span>{{ f[1] | strip }}</li>
                    {%- endif -%}{%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if bs.intro != blank -%}<div class="pp-adv-copy mt-6">{%- render 'parapatrol-claim', text: bs.intro -%}</div>{%- endif -%}
            {%- assign pls = bs.pillars | newline_to_br | split: '<br />' -%}
            <div class="mt-7 grid gap-3">
              {%- for l in pls -%}
                {%- assign f = l | strip | split: '|' -%}
                {%- if f.size >= 3 -%}
                  <div class="rounded-3xl bg-white border border-line p-5 sm:p-6 shadow-soft">
                    <div class="flex items-center justify-between gap-3">
                      <p class="flex items-center gap-2.5 font-display font-bold text-[20px] text-ink"><span class="w-10 h-10 rounded-xl bg-mint text-primary inline-flex items-center justify-center" aria-hidden="true">{%- assign pp_v = f[0] | strip -%}{%- render 'parapatrol-icon', name: pp_v, icon_size: 20 -%}</span>{{ f[1] | strip }}</p>
                      {%- if f[2] != blank -%}<span class="rounded-full bg-primary px-3 py-1 text-[11px] font-extrabold uppercase tracking-[.08em] text-white">{{ f[2] | strip }}</span>{%- endif -%}
                    </div>
                    {%- if f[3] -%}<p class="mt-3 font-bold text-[16px] text-ink">{%- assign pp_v = f[3] | strip -%}{%- render 'parapatrol-claim', text: pp_v -%}</p>{%- endif -%}
                    {%- if f[4] -%}
                      {%- assign bul = f[4] | split: ';' -%}
                      <ul class="mt-2 grid gap-1.5" role="list">{%- for x in bul -%}<li class="flex gap-2 text-[15px] leading-snug text-muted"><span class="mt-[7px] w-1.5 h-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span><span>{%- assign pp_v = x | strip -%}{%- render 'parapatrol-claim', text: pp_v -%}</span></li>{%- endfor -%}</ul>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if bs.result_list != blank -%}
              {%- assign rl = bs.result_list | newline_to_br | split: '<br />' -%}
              <div class="mt-4 rounded-3xl bg-mint border-l-4 border-primary p-5 sm:p-7">
                <p class="font-display font-bold text-[20px] text-primary-dark">{{ bs.result_title }}</p>
                {%- if bs.result_intro != blank -%}<p class="mt-1 text-[15px] text-ink">{{ bs.result_intro }}</p>{%- endif -%}
                <ul class="mt-3 grid gap-2" role="list">{%- for x in rl -%}{%- assign xt = x | strip -%}{%- if xt != blank -%}<li class="flex items-start gap-2.5 text-[16px] text-ink"><span class="mt-0.5 text-primary shrink-0" aria-hidden="true">{%- render 'parapatrol-icon', name: 'check', icon_size: 18 -%}</span><span>{%- render 'parapatrol-claim', text: xt -%}</span></li>{%- endif -%}{%- endfor -%}</ul>
              </div>
            {%- endif -%}
            {%- render 'parapatrol-lp-acc', lines: bs.accordions -%}
            {%- render 'parapatrol-lp-cta', url: lp_url, label: s.cta_label, note: s.cta_note -%}
          </div>
        </section>

      {%- when 'ingredients' -%}
        <section class="py-12 lg:py-16 bg-soft" {{ block.shopify_attributes }}>
          <div class="max-w-6xl mx-auto px-4">
            <div class="text-center max-w-2xl mx-auto">
              {%- if bs.eyebrow != blank -%}<p class="text-[13px] font-extrabold uppercase tracking-[.14em] text-primary">{{ bs.eyebrow }}</p>{%- endif -%}
              <h2 class="mt-1 font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ bs.heading }}</h2>
              {%- if bs.intro != blank -%}<p class="mt-3 text-[16px] sm:text-[17px] leading-relaxed text-muted">{{ bs.intro }}</p>{%- endif -%}
            </div>
            {%- assign ing = bs.items | newline_to_br | split: '<br />' -%}
            <div class="mt-8" data-pp-scrollbar>
              <ul class="pp-slider -mx-4 px-4 scroll-px-4 sm:mx-0 sm:px-0 sm:scroll-px-0 flex gap-4 overflow-x-auto snap-x snap-mandatory pb-2" data-pp-scrollbar-track role="list" aria-label="{{ bs.heading | escape }}" tabindex="0">
                {%- for l in ing -%}
                  {%- assign f = l | strip | split: '|' -%}
                  {%- if f.size >= 3 -%}
                    <li class="snap-start shrink-0 w-[72%] sm:w-[calc(33.333%-11px)] lg:w-[calc(25%-12px)] rounded-3xl bg-white border-2 border-[#d6e7dd] p-5 flex flex-col">
                      <span class="w-12 h-12 rounded-2xl bg-mint text-primary inline-flex items-center justify-center" aria-hidden="true">{%- render 'parapatrol-icon', name: 'leaf', icon_size: 22 -%}</span>
                      <p class="mt-3 flex flex-wrap items-center gap-2"><span class="font-display font-bold text-[18px] uppercase tracking-[.04em] text-ink">{{ f[0] | strip }}</span><span class="rounded-full bg-mint px-2.5 py-0.5 text-[11px] font-extrabold text-primary-dark">{{ f[1] | strip }}</span></p>
                      <p class="mt-2 text-[15px] leading-relaxed text-muted">{%- assign pp_v = f[2] | strip -%}{%- render 'parapatrol-claim', text: pp_v -%}</p>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
              <div class="pp-sbar mt-4 mx-auto max-w-[520px]" data-pp-scrollbar-rail aria-hidden="true"><span class="pp-sbar__thumb" data-pp-scrollbar-thumb></span></div>
            </div>
            {%- if bs.note != blank -%}<p class="mt-5 text-center text-[13px] text-muted">{{ bs.note }}</p>{%- endif -%}
          </div>
        </section>

      {%- when 'routine' -%}
        <section class="pp-adv-sec py-12 lg:py-16" {{ block.shopify_attributes }}>
          <div class="max-w-[760px] mx-auto px-4">
            <h2 class="font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-primary">{{ bs.heading }}</h2>
            {%- if bs.image != blank or bs.asset != blank -%}
              <div class="mt-6">{%- render 'parapatrol-media', image: bs.image, asset: bs.asset, alt: bs.alt, label: bs.heading, class: 'aspect-[4/3] rounded-3xl', sizes: '(min-width: 800px) 728px, 100vw' -%}</div>
            {%- endif -%}
            {%- if bs.text != blank -%}<div class="pp-adv-copy mt-6">{%- render 'parapatrol-claim', text: bs.text -%}</div>{%- endif -%}
            {%- assign st = bs.steps | newline_to_br | split: '<br />' -%}
            <ol class="mt-6 rounded-3xl bg-mint p-4 sm:p-5 grid gap-3" role="list">
              {%- for l in st -%}{%- assign lt = l | strip -%}{%- if lt != blank -%}
                <li class="flex items-start gap-3 rounded-2xl bg-white px-4 py-3"><span class="w-8 h-8 shrink-0 rounded-full bg-primary text-white inline-flex items-center justify-center font-display font-bold text-[16px]" aria-hidden="true">{{ forloop.index }}</span><span class="pt-1 text-[16px] leading-snug text-ink">{{ lt }}</span></li>
              {%- endif -%}{%- endfor -%}
            </ol>
            {%- render 'parapatrol-lp-acc', lines: bs.accordions -%}
            {%- render 'parapatrol-lp-cta', url: lp_url, label: s.cta_label, note: s.cta_note -%}
          </div>
        </section>

      {%- when 'timeline' -%}
        <section class="py-12 lg:py-16 bg-soft" {{ block.shopify_attributes }}>
          <div class="max-w-[760px] mx-auto px-4">
            <h2 class="font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink text-center">{{ bs.heading }}</h2>
            {%- if bs.intro != blank -%}<p class="mt-3 text-center text-[16px] sm:text-[17px] leading-relaxed text-muted">{%- render 'parapatrol-claim', text: bs.intro -%}</p>{%- endif -%}
            {%- assign stg = bs.stages | newline_to_br | split: '<br />' -%}
            <ol class="mt-8 mx-auto max-w-[460px] grid" role="list">
              {%- for l in stg -%}
                {%- assign f = l | strip | split: '|' -%}
                {%- if f.size >= 3 -%}
                  {%- unless forloop.first -%}<li class="mx-auto w-[3px] h-8 bg-primary" aria-hidden="true"></li>{%- endunless -%}
                  <li class="rounded-3xl bg-white border-2 border-primary p-5 sm:p-6">
                    <p class="font-display font-bold text-[21px] leading-tight text-primary-dark"><span aria-hidden="true">{{ f[0] | strip }}</span> {{ f[1] | strip }}</p>
                    <p class="mt-2 text-[15px] leading-relaxed text-ink">{%- assign pp_v = f[2] | strip -%}{%- render 'parapatrol-claim', text: pp_v -%}</p>
                    {%- if f[3] -%}
                      {%- assign bul = f[3] | split: ';' -%}
                      <ul class="mt-3 grid gap-1.5" role="list">{%- for x in bul -%}<li class="flex items-start gap-2 text-[15px] text-ink"><span class="text-primary mt-0.5 shrink-0" aria-hidden="true">{%- render 'parapatrol-icon', name: 'check', icon_size: 16 -%}</span><span>{%- assign pp_v = x | strip -%}{%- render 'parapatrol-claim', text: pp_v -%}</span></li>{%- endfor -%}</ul>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ol>
            {%- render 'parapatrol-lp-cta', url: lp_url, label: s.cta_label, note: s.cta_note -%}
          </div>
        </section>

      {%- when 'reviews' -%}
        <section class="pp-adv-sec py-12 lg:py-16" {{ block.shopify_attributes }}>
          <div class="max-w-6xl mx-auto px-4">
            <div class="text-center">
              {%- if bs.rating_text != blank -%}<p class="inline-flex flex-wrap items-center justify-center gap-2 text-[14px] font-bold text-ink">{%- render 'parapatrol-stars', score: 5, size: 18 -%}{{ bs.rating_text }}</p>{%- endif -%}
              <h2 class="mt-2 font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ bs.heading }}</h2>
              {%- if bs.intro != blank -%}<p class="mt-2 text-[16px] text-muted">{{ bs.intro }}</p>{%- endif -%}
            </div>
            {%- assign rv = bs.quotes | newline_to_br | split: '<br />' -%}
            <div class="mt-8" data-pp-scrollbar>
              <ul class="pp-slider -mx-4 px-4 scroll-px-4 sm:mx-0 sm:px-0 sm:scroll-px-0 flex gap-5 overflow-x-auto snap-x snap-mandatory pb-2" data-pp-scrollbar-track role="list" aria-label="Parent reviews" tabindex="0">
                {%- for l in rv -%}
                  {%- assign f = l | strip | split: '|' -%}
                  {%- if f.size >= 3 -%}
                    <li class="snap-start shrink-0 w-[86%] sm:w-[calc(50%-10px)] lg:w-[calc(33.333%-14px)] rounded-3xl bg-soft p-6 flex flex-col">
                      {%- render 'parapatrol-stars', score: 5, size: 18 -%}
                      <p class="mt-3 font-display font-bold text-[19px] leading-snug text-primary">{{ f[0] | strip }}</p>
                      <blockquote class="mt-2 flex-1 text-[16px] leading-relaxed italic text-ink">“{{ f[1] | strip }}”</blockquote>
                      <p class="mt-4 font-display font-bold text-[16px] text-ink">{{ f[2] | strip }}</p>
                      <p class="mt-0.5 flex items-center gap-1.5 text-[13px] font-semibold text-primary-dark"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="#3b7560" d="M12 1.5l2.6 1.9 3.2-.1 1 3.1 2.6 1.9-1 3.1 1 3.1-2.6 1.9-1 3.1-3.2-.1L12 22.5l-2.6-1.9-3.2.1-1-3.1-2.6-1.9 1-3.1-1-3.1 2.6-1.9 1-3.1 3.2.1z"/><path d="m8 12.2 2.7 2.7L16.2 9.4" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>Verified Buyer</p>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
              <div class="pp-sbar mt-4 mx-auto max-w-[520px]" data-pp-scrollbar-rail aria-hidden="true"><span class="pp-sbar__thumb" data-pp-scrollbar-thumb></span></div>
            </div>
            {%- if bs.note != blank -%}<p class="mt-4 text-center text-[12px] text-muted">{{ bs.note }}</p>{%- endif -%}
          </div>
        </section>

      {%- when 'compare' -%}
        <section class="py-12 lg:py-16 bg-soft" {{ block.shopify_attributes }}>
          <div class="max-w-[860px] mx-auto px-4">
            <h2 class="text-center font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ bs.heading }}</h2>
            {%- if bs.intro != blank -%}<p class="mt-3 text-center text-[16px] sm:text-[17px] text-muted">{{ bs.intro }}</p>{%- endif -%}
            {%- assign rows = bs.rows | newline_to_br | split: '<br />' -%}
            <div class="mt-8 rounded-3xl bg-white shadow-soft overflow-hidden">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr>
                    <th scope="col" class="p-3 sm:p-4 {% if bs.col_them2 != blank %}w-[31%]{% else %}w-[40%]{% endif %}"><span class="sr-only">Feature</span></th>
                    <th scope="col" class="p-3 sm:p-4 bg-primary text-center font-display font-bold text-[17px] sm:text-[22px] text-white pp-adv-light-h">{{ bs.col_ours }}</th>
                    <th scope="col" class="p-3 sm:p-4 text-center text-[13px] sm:text-[15px] font-bold text-muted">{{ bs.col_them }}</th>
                    {%- if bs.col_them2 != blank -%}<th scope="col" class="p-3 sm:p-4 text-center text-[13px] sm:text-[15px] font-bold text-muted">{{ bs.col_them2 }}</th>{%- endif -%}
                  </tr>
                </thead>
                <tbody>
                  {%- for l in rows -%}
                    {%- assign f = l | strip | split: '|' -%}
                    {%- if f.size >= 3 -%}
                      <tr class="border-t border-line">
                        <th scope="row" class="p-3 sm:p-4 text-[14px] sm:text-[16px] font-bold text-ink">{{ f[0] | strip }}</th>
                        <td class="p-3 sm:p-4 bg-mint text-center">
                          <span class="mx-auto w-8 h-8 rounded-full bg-primary text-white inline-flex items-center justify-center" aria-hidden="true">{%- render 'parapatrol-icon', name: 'check', icon_size: 16 -%}</span>
                          <span class="block mt-1 text-[12px] sm:text-[13px] font-semibold text-primary-dark">{{ f[1] | strip }}</span>
                        </td>
                        <td class="p-3 sm:p-4 text-center text-[13px] sm:text-[14px] text-muted">{{ f[2] | strip }}</td>
                        {%- if bs.col_them2 != blank -%}<td class="p-3 sm:p-4 text-center text-[13px] sm:text-[14px] text-muted">{{ f[3] | strip }}</td>{%- endif -%}
                      </tr>
                    {%- endif -%}
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
          </div>
        </section>

      {%- when 'promise' -%}
        <section class="py-12 lg:py-16 bg-mint" {{ block.shopify_attributes }}>
          <div class="max-w-[560px] mx-auto px-4 text-center">
            <span class="mx-auto w-16 h-16 rounded-full bg-white text-primary inline-flex items-center justify-center shadow-soft" aria-hidden="true">{%- render 'parapatrol-icon', name: 'shield', icon_size: 30 -%}</span>
            <h2 class="mt-4 font-display font-bold text-[30px] sm:text-[38px] leading-[1.1] text-primary">{{ bs.heading }}</h2>
            <div class="mt-5 rounded-3xl bg-white border-2 border-primary p-6 sm:p-8 text-left pp-adv-copy pp-adv-copy--sm">{%- render 'parapatrol-claim', text: bs.text -%}
              {%- if bs.signoff != blank -%}<p class="!mt-5 font-display font-bold text-[18px] text-primary-dark">{{ bs.signoff }}</p>{%- endif -%}
            </div>
            {%- render 'parapatrol-lp-cta', url: lp_url, label: s.cta_label, note: s.cta_note -%}
          </div>
        </section>

      {%- when 'faq' -%}
        <section class="pp-adv-sec py-12 lg:py-16" {{ block.shopify_attributes }}>
          <div class="max-w-[760px] mx-auto px-4">
            <h2 class="text-center font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ bs.heading }}</h2>
            {%- render 'parapatrol-lp-acc', lines: bs.items -%}
          </div>
        </section>

      {%- when 'offer' -%}
        <section class="py-12 lg:py-16 bg-soft" {{ block.shopify_attributes }}>
          <div class="max-w-6xl mx-auto px-4 grid gap-8 lg:grid-cols-2 lg:items-center">
            <div class="order-2 lg:order-1">
              <h2 class="font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ bs.heading }}</h2>
              {%- if bs.subheading != blank -%}<p class="mt-2 font-bold text-[16px] text-berry">{{ bs.subheading }}</p>{%- endif -%}
              {%- if bs.tiers != blank -%}
                {%- assign tiers = bs.tiers | newline_to_br | split: '<br />' -%}
                <div class="mt-5 grid gap-2.5">
                  {%- for l in tiers -%}
                    {%- assign f = l | strip | split: '|' -%}
                    {%- if f.size >= 2 -%}
                      {%- assign t_badge = f[4] | strip -%}
                      <a href="{{ lp_url }}" class="relative flex items-center justify-between gap-3 rounded-2xl bg-white px-4 py-3.5 border-2 {% if t_badge != blank %}border-primary bg-mint{% else %}border-line{% endif %} hover:border-primary transition-colors" data-pp-adv-cta>
                        {%- if t_badge != blank -%}<span class="absolute -top-3 right-4 rounded-md bg-primary px-2.5 py-0.5 text-[11px] font-extrabold uppercase tracking-[.08em] text-white">{{ t_badge }}</span>{%- endif -%}
                        <span class="min-w-0"><span class="block font-display font-bold text-[18px] text-ink">{{ f[0] | strip }}</span>{% if f[3] and f[3] != blank %}<span class="block text-[13px] font-bold text-berry">{{ f[3] | strip }}</span>{% endif %}</span>
                        <span class="text-right shrink-0"><span class="block font-display font-bold text-[20px] text-ink">{{ f[1] | strip }}</span>{% if f[2] and f[2] != blank %}<span class="block text-[13px] text-muted line-through">{{ f[2] | strip }}</span>{% endif %}</span>
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
              {%- assign cl = bs.checklist | newline_to_br | split: '<br />' -%}
              <ul class="mt-5 grid gap-2.5" role="list">{%- for x in cl -%}{%- assign xt = x | strip -%}{%- if xt != blank -%}<li class="flex items-start gap-2.5 text-[16px] text-ink"><span class="mt-0.5 w-5 h-5 shrink-0 rounded-full bg-primary text-white inline-flex items-center justify-center" aria-hidden="true">{%- render 'parapatrol-icon', name: 'check', icon_size: 12 -%}</span><span>{{ xt }}</span></li>{%- endif -%}{%- endfor -%}</ul>
              {%- if bs.quote != blank -%}<p class="mt-5 rounded-2xl bg-white px-4 py-3 text-[15px] italic leading-relaxed text-ink">💬 “{{ bs.quote }}”{% if bs.quote_author != blank %} <span class="not-italic font-bold">— {{ bs.quote_author }}</span>{% endif %}</p>{%- endif -%}
              {%- render 'parapatrol-lp-cta', url: lp_url, label: s.cta_label, note: s.cta_note, left: true -%}
            </div>
            <div class="order-1 lg:order-2">
              {%- if bs.image != blank or bs.asset != blank -%}
                {%- render 'parapatrol-media', image: bs.image, asset: bs.asset, alt: bs.alt, label: 'ParaPatrol', class: 'aspect-square rounded-3xl', sizes: '(min-width: 1024px) 560px, 100vw' -%}
              {%- elsif lp.featured_image -%}
                <div class="aspect-square rounded-3xl overflow-hidden bg-mint">{{ lp.featured_image | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 1024px) 560px, 100vw', class: 'w-full h-full object-cover', alt: lp.title }}</div>
              {%- endif -%}
            </div>
          </div>
        </section>

      {%- when 'offer2' -%}
        <section class="py-12 lg:py-16 bg-white" {{ block.shopify_attributes }} aria-labelledby="pp-of2-{{ block.id }}">
          <div class="max-w-6xl mx-auto px-4 grid gap-8 lg:grid-cols-2 lg:gap-8 lg:items-center">
            <div class="min-w-0 order-2 lg:order-1">
              <h2 id="pp-of2-{{ block.id }}" class="font-display font-bold text-[32px] sm:text-[40px] leading-[1.1] text-ink">{{ bs.heading }}</h2>
              {%- if bs.subheading != blank -%}<p class="mt-4 text-[16px] text-ink"><strong class="font-extrabold">{{ bs.subheading }}</strong></p>{%- endif -%}
              {%- assign cl = bs.checklist | newline_to_br | split: '<br />' -%}
              <ul class="mt-4 grid gap-3.5" role="list">{%- for x in cl -%}{%- assign xt = x | strip -%}{%- if xt != blank -%}<li class="flex items-start gap-2 text-[16px] text-ink"><span class="mt-[3px] shrink-0 text-primary" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m4 12.5 5 5L20 6.5"/></svg></span><span>{{ xt }}</span></li>{%- endif -%}{%- endfor -%}</ul>
              {%- if bs.quote != blank -%}<p class="mt-5 text-[16px] leading-relaxed text-ink">💬 “{{ bs.quote }}”{% if bs.quote_author != blank %} — <strong class="font-extrabold">{{ bs.quote_author }}</strong>{% endif %}</p>{%- endif -%}
              <a href="{{ lp_url }}" class="mt-6 flex w-full items-center justify-center min-h-[54px] px-6 rounded-xl bg-primary hover:bg-primary-dark text-white font-extrabold text-[17px] transition-colors" data-pp-adv-cta>{{ bs.button_label | default: s.cta_label }}</a>
              {%- assign of_note = bs.button_note | default: s.cta_note -%}
              {%- if of_note != blank -%}<p class="mt-2 text-center text-[13px] text-ink">✓ {{ of_note }}</p>{%- endif -%}
            </div>
            <div class="min-w-0 order-1 lg:order-2 grid grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)] gap-2 sm:gap-2.5">
              <div class="relative rounded-2xl overflow-hidden bg-[linear-gradient(160deg,#cfe9dc_0%,#a9d6c1_100%)] min-h-[300px] sm:min-h-[420px] lg:min-h-[560px]">
                {%- if bs.badge != blank -%}<span class="absolute z-[1] top-3 left-3 right-3 sm:right-auto rounded-full bg-primary-dark px-3 py-1.5 sm:px-4 sm:py-2 text-[11px] sm:text-[15px] font-extrabold uppercase tracking-[.03em] text-white text-center">{{ bs.badge }}</span>{%- endif -%}
                {%- if bs.image != blank -%}
                  {{ bs.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 1024px) 340px, 60vw', class: 'absolute inset-0 w-full h-full object-cover', alt: bs.alt }}
                {%- else -%}
                  <img src="{{ bs.asset | default: 'pp-offer-studio.jpg' | asset_url }}" alt="{{ bs.alt | escape }}" loading="lazy" width="1000" height="1360" class="absolute inset-0 w-full h-full object-cover">
                {%- endif -%}
              </div>
              {%- assign tl = bs.tiles | newline_to_br | split: '<br />' -%}
              <ul class="grid grid-rows-3 gap-2 sm:gap-2.5" role="list">
                {%- for l in tl -%}{%- assign f = l | strip | split: '|' -%}{%- if f.size >= 2 -%}{%- assign ic = f[0] | strip -%}
                  <li class="rounded-2xl bg-[linear-gradient(180deg,#d7efe3_0%,#b4dcc8_100%)] flex flex-col items-center justify-center gap-2 px-2 py-4 text-center text-primary-dark">
                    <span aria-hidden="true" class="w-10 h-10 sm:w-16 sm:h-16">
                      {%- case ic -%}
                        {%- when 'smile' -%}<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" class="w-full h-full"><circle cx="32" cy="32" r="27"/><path d="M20 26c2.5-3 6.5-3 9 0M35 26c2.5-3 6.5-3 9 0M21 38c5.5 8 16.5 8 22 0"/></svg>
                        {%- when 'tummy' -%}<svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><path d="M7 34h50c0 13-11 22-25 22S7 47 7 34z"/><path d="M22 56h20"/><path d="M32 26c-6-4-10-7-10-11a5 5 0 0 1 10-1 5 5 0 0 1 10 1c0 4-4 7-10 11z" fill="currentColor" stroke-width="2"/></svg>
                        {%- when 'moon' -%}<svg viewBox="0 0 64 64" fill="currentColor" class="w-full h-full"><path d="M30 14a22 22 0 1 0 22 30A19 19 0 0 1 30 14z"/><path d="M40 8h8l-8 9h8M50 20h6l-6 7h6" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        {%- else -%}{%- render 'parapatrol-icon', name: ic, icon_size: 40 -%}
                      {%- endcase -%}
                    </span>
                    <span class="font-display font-bold text-[15px] sm:text-[24px] leading-[1.05]">{{ f[1] | strip }}</span>
                  </li>
                {%- endif -%}{%- endfor -%}
              </ul>
            </div>
          </div>
        </section>

      {%- when 'hook' -%}
        <section class="bg-primary-dark" {{ block.shopify_attributes }} aria-labelledby="pp-lp-hook-{{ block.id }}">
          <div class="max-w-6xl mx-auto px-4 py-8 lg:py-12 grid gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,.8fr)] lg:items-center">
            <div>
              {%- if bs.eyebrow != blank -%}<p class="inline-flex rounded-full bg-[rgba(255,255,255,.12)] px-3 py-1 text-[12px] font-extrabold uppercase tracking-[.12em] text-[#cfe6da]">{{ bs.eyebrow }}</p>{%- endif -%}
              <h1 id="pp-lp-hook-{{ block.id }}" class="pp-adv-light-h mt-3 font-display font-bold text-[30px] sm:text-[44px] leading-[1.08]">{{ bs.headline }}</h1>
              {%- if bs.text != blank -%}<div class="pp-adv-copy pp-adv-copy--light mt-4">{%- render 'parapatrol-claim', text: bs.text -%}</div>{%- endif -%}
              {%- if bs.stat != blank -%}
                <p class="mt-5 rounded-2xl bg-white px-4 py-3 text-[15px] font-bold text-primary-dark">{{ bs.stat }}{% if bs.stat_source != blank %} <span class="font-normal text-muted">({% if bs.stat_url != blank %}<a href="{{ bs.stat_url }}" target="_blank" rel="noopener" class="underline underline-offset-2">{{ bs.stat_source }}</a>{% else %}{{ bs.stat_source }}{% endif %})</span>{% endif %}</p>
              {%- endif -%}
              {%- if bs.scroll_label != blank -%}<a href="#{{ bs.scroll_to | default: 'solution' }}" class="mt-5 inline-flex items-center gap-2 text-[15px] font-extrabold text-white underline underline-offset-4">{{ bs.scroll_label }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12l7 7 7-7"/></svg></a>{%- endif -%}
            </div>
            {%- if bs.image != blank or bs.asset != blank -%}
              <div>{%- render 'parapatrol-media', image: bs.image, asset: bs.asset, alt: bs.alt, label: bs.headline, class: 'aspect-[4/3] rounded-3xl', sizes: '(min-width: 1024px) 440px, 100vw', loading: 'eager', priority: true -%}</div>
            {%- endif -%}
          </div>
        </section>

      {%- when 'videos' -%}
        {%- assign vids = bs.items | newline_to_br | split: '<br />' -%}
        {%- assign v_count = 0 -%}
        {%- for l in vids -%}{%- assign f = l | strip | split: '|' -%}{%- assign v_src = f[1] | strip -%}{%- if v_src != blank -%}{%- assign v_count = v_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {%- if v_count > 0 -%}
        <section class="py-12 lg:py-16 bg-mint" {{ block.shopify_attributes }}>
          <div class="max-w-6xl mx-auto px-4">
            <div class="text-center max-w-2xl mx-auto">
              <h2 class="font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ bs.heading }}</h2>
              {%- if bs.intro != blank -%}<p class="mt-3 text-[16px] sm:text-[17px] leading-relaxed text-muted">{%- render 'parapatrol-claim', text: bs.intro -%}</p>{%- endif -%}
            </div>
            <ol class="mt-8 grid gap-5 grid-cols-1 sm:grid-cols-3" role="list">
              {%- for l in vids -%}
                {%- assign f = l | strip | split: '|' -%}
                {%- assign v_src = f[1] | strip -%}
                {%- if v_src != blank -%}
                  {%- assign v_poster = f[2] | strip -%}
                  <li class="flex flex-col items-center">
                    <div class="w-full max-w-[320px] mx-auto aspect-[9/16] rounded-3xl overflow-hidden bg-ink shadow-lift">
                      <video class="w-full h-full object-cover" src="{{ v_src }}" {% if v_poster != blank %}poster="{{ v_poster | asset_url }}"{% endif %} controls playsinline preload="metadata"></video>
                    </div>
                    <p class="mt-3 font-display font-bold text-[20px] text-primary-dark">{{ f[0] | strip }}</p>
                    {%- assign v_cap = f[3] | strip -%}{%- if v_cap != blank -%}<p class="mt-0.5 text-center text-[14px] text-muted max-w-[300px]">{{ v_cap }}</p>{%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ol>
            {%- if bs.note != blank -%}<p class="mt-5 text-center text-[12px] text-muted">{{ bs.note }}</p>{%- endif -%}
          </div>
        </section>
        {%- endif -%}

      {%- when 'progress' -%}
        <section class="py-12 lg:py-16 bg-mint" {{ block.shopify_attributes }}>
          <div class="max-w-6xl mx-auto px-4">
            <div class="text-center max-w-2xl mx-auto">
              <h2 class="font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ bs.heading }}</h2>
              {%- if bs.intro != blank -%}<p class="mt-3 text-[16px] sm:text-[17px] leading-relaxed text-muted">{%- render 'parapatrol-claim', text: bs.intro -%}</p>{%- endif -%}
            </div>
            {%- assign pg = bs.items | newline_to_br | split: '<br />' -%}
            <ol class="mt-8 grid gap-4 md:grid-cols-3" role="list">
              {%- for l in pg -%}
                {%- assign f = l | strip | split: '|' -%}
                {%- if f.size >= 4 -%}
                  <li class="relative rounded-3xl bg-white p-5 sm:p-6 shadow-soft flex flex-col">
                    <span class="self-start rounded-full bg-primary px-3.5 py-1 font-display font-bold text-[15px] text-white">{{ f[0] | strip }}</span>
                    {%- assign pp_ph = f[4] | strip -%}
                    {%- if pp_ph != blank -%}<div class="mt-4">{%- render 'parapatrol-media', asset: pp_ph, alt: '', label: '', class: 'aspect-[4/3] rounded-2xl', sizes: '(min-width: 768px) 340px, 100vw' -%}</div>{%- endif -%}
                    <p class="mt-4 font-display font-bold text-[19px] leading-snug text-primary">{{ f[1] | strip }}</p>
                    <blockquote class="mt-2 flex-1 text-[15px] leading-relaxed italic text-ink">“{{ f[2] | strip }}”</blockquote>
                    <p class="mt-3 text-[14px] font-bold text-ink">{{ f[3] | strip }} <span class="font-semibold text-primary-dark">· Verified Buyer</span></p>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ol>
            {%- if bs.note != blank -%}<p class="mt-4 text-center text-[12px] text-muted">{{ bs.note }}</p>{%- endif -%}
          </div>
        </section>

      {%- when 'stories' -%}
        <section class="pp-adv-sec py-12 lg:py-16" {{ block.shopify_attributes }}>
          <div class="max-w-6xl mx-auto px-4">
            <div class="text-center">
              {%- if bs.rating_text != blank -%}<p class="inline-flex flex-wrap items-center justify-center gap-2 text-[14px] font-bold text-ink">{%- render 'parapatrol-stars', score: 5, size: 18 -%}{{ bs.rating_text }}</p>{%- endif -%}
              <h2 class="mt-2 font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ bs.heading }}</h2>
            </div>
            {%- assign st = bs.items | newline_to_br | split: '<br />' -%}
            <div class="mt-8 grid gap-5 md:grid-cols-2">
              {%- for l in st -%}
                {%- assign f = l | strip | split: '|' -%}
                {%- if f.size >= 5 -%}
                  <figure class="rounded-3xl bg-soft p-5 sm:p-6 flex gap-4">
                    {%- assign pp_ph = f[0] | strip -%}
