                    <div class="min-w-0">
                      <p class="text-[11px] font-extrabold uppercase tracking-[.12em] text-primary">{{ f[1] | strip }}</p>
                      <p class="font-display font-bold text-[20px] leading-tight text-ink">{{ f[2] | strip }}</p>
                      {%- assign sb = f[3] | strip -%}{%- if sb != blank -%}<p class="text-[13px] text-muted">{{ sb }}</p>{%- endif -%}
                    </div>
                  </div>
                  {%- assign bul = f[4] | split: ';' -%}
                  <ul class="mt-3 grid gap-1.5" role="list">{%- for x in bul -%}<li class="flex items-start gap-2 text-[15px] text-ink"><span class="mt-0.5 text-primary shrink-0" aria-hidden="true">{%- render 'parapatrol-icon', name: 'check', icon_size: 17 -%}</span><span>{%- assign pp_v = x | strip -%}{%- render 'parapatrol-claim', text: pp_v -%}</span></li>{%- endfor -%}</ul>
                </div>
              {%- endif -%}{%- endfor -%}
            </div>
            {%- if bs.note != blank -%}<p class="mt-4 rounded-2xl bg-mint border-2 border-primary px-4 py-3 text-center text-[15px] font-bold text-primary-dark">{{ bs.note }}</p>{%- endif -%}
            {%- render 'parapatrol-lp-cta', url: lp_url, label: s.cta_label, note: s.cta_note -%}
          </div>
        </section>

      {%- when 'promise2' -%}
        <section class="py-12 lg:py-16 bg-mint" {{ block.shopify_attributes }}>
          <div class="max-w-[640px] mx-auto px-4 text-center">
            <h2 class="font-display font-bold text-[32px] sm:text-[44px] leading-[1.08] text-primary">{{ bs.heading }}</h2>
            {%- if bs.intro != blank -%}<p class="mt-3 text-[17px] text-ink">{{ bs.intro }}</p>{%- endif -%}
            {%- assign stp = bs.steps | newline_to_br | split: '<br />' -%}
            <ol class="mt-6 mx-auto max-w-[460px] grid gap-4 text-left" role="list">
              {%- for l in stp -%}{%- assign lt = l | strip -%}{%- if lt != blank -%}<li class="flex items-center gap-3 text-[17px] font-bold text-ink"><span class="w-9 h-9 shrink-0 rounded-full bg-primary text-white inline-flex items-center justify-center font-display font-bold" aria-hidden="true">{{ forloop.index }}</span>{{ lt }}</li>{%- endif -%}{%- endfor -%}
            </ol>
            {%- render 'parapatrol-lp-cta', url: lp_url, label: s.cta_label, note: s.cta_note -%}
            {%- if bs.image != blank or bs.asset != blank -%}<div class="mt-8 mx-auto max-w-[360px]">{%- render 'parapatrol-media', image: bs.image, asset: bs.asset, alt: bs.alt, label: '', class: 'aspect-square rounded-full', sizes: '360px' -%}</div>{%- endif -%}
          </div>
        </section>

      {%- when 'topbar' -%}
        <p class="bg-primary px-4 py-2.5 text-center text-[14px] sm:text-[15px] font-extrabold uppercase tracking-[.08em] text-white" {{ block.shopify_attributes }}>{{ bs.text }}</p>

      {%- when 'trust' -%}
        {%- assign tr = bs.items | newline_to_br | split: '<br />' -%}
        <section class="pp-adv-sec py-10 border-t border-line" {{ block.shopify_attributes }}>
          <ul class="max-w-5xl mx-auto px-4 grid grid-cols-2 sm:grid-cols-3 gap-y-6 gap-x-4" role="list">
            {%- for l in tr -%}{%- assign f = l | strip | split: '|' -%}{%- if f.size >= 2 -%}
              <li class="flex flex-col items-center text-center gap-2"><span class="w-12 h-12 rounded-2xl bg-mint text-primary inline-flex items-center justify-center" aria-hidden="true">{%- assign pp_v = f[0] | strip -%}{%- render 'parapatrol-icon', name: pp_v, icon_size: 22 -%}</span><span class="font-display font-bold text-[15px] sm:text-[17px] text-ink">{{ f[1] | strip }}</span></li>
            {%- endif -%}{%- endfor -%}
          </ul>
        </section>
    {%- endcase -%}
  {%- endfor -%}

  {%- if s.sticky_cta -%}
    <div class="pp-adv-sticky fixed inset-x-0 bottom-0 z-50 translate-y-full" data-pp-adv-sticky aria-hidden="true">
      <a href="{{ lp_url }}" tabindex="-1" class="flex items-center justify-center gap-2 min-h-[56px] px-4 bg-primary hover:bg-primary-dark text-white font-extrabold text-[15px] sm:text-[16px] uppercase tracking-[.06em] shadow-lift">{{ s.sticky_label | default: s.cta_label }}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
    </div>
    <script>
      (function () {
        var bar = document.querySelector('[data-pp-adv-sticky]');
        if (!bar) return;
        var ctas = document.querySelectorAll('[data-pp-adv-cta]');
        var ctaVisible = false, past = false;
        function update() {
          var show = past && !ctaVisible;
          bar.classList.toggle('translate-y-full', !show);
          bar.setAttribute('aria-hidden', show ? 'false' : 'true');
          var a = bar.querySelector('a'); if (a) a.tabIndex = show ? 0 : -1;
        }
        window.addEventListener('scroll', function () { past = window.scrollY > 600; update(); }, { passive: true });
        if ('IntersectionObserver' in window) {
          var seen = new Set();
          var io = new IntersectionObserver(function (es) { es.forEach(function (e) { e.isIntersecting ? seen.add(e.target) : seen.delete(e.target); }); ctaVisible = seen.size > 0; update(); });
          ctas.forEach(function (c) { io.observe(c); });
        }
      })();
    </script>
  {%- endif -%}
</div>
