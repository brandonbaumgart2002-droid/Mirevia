{%- comment -%} Safety & who it's for. Required trust section: always visible, never in an accordion. {%- endcomment -%}
{{ 'parapatrol.css' | asset_url | stylesheet_tag }}
<div class="pp" id="safety">
  <section class="bg-soft py-14 lg:py-20" aria-labelledby="pp-safe-{{ section.id }}">
    <div class="max-w-4xl mx-auto px-4">
      <div class="rounded-3xl border-2 border-primary/25 bg-white p-6 sm:p-10 shadow-soft">
        <div class="flex items-center gap-3">
          <span class="w-12 h-12 shrink-0 rounded-2xl bg-mint text-primary inline-flex items-center justify-center">{%- render 'parapatrol-icon', name: 'shield-alert' -%}</span>
          <h2 id="pp-safe-{{ section.id }}" class="font-display font-semibold text-[30px] sm:text-[38px] leading-[1.1]">{{ section.settings.heading }}</h2>
        </div>
        <ul class="mt-6 grid gap-3.5">
          {%- for block in section.blocks -%}
            <li class="flex gap-3" {{ block.shopify_attributes }}>
              <span class="mt-2.5 w-2 h-2 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
              <p>{% if block.settings.lead != blank %}<strong>{{ block.settings.lead }}</strong> {% endif %}{{ block.settings.text }}</p>
            </li>
          {%- endfor -%}
        </ul>
        {%- if section.settings.callout != blank -%}
          <p class="mt-6 rounded-2xl bg-soft p-5 font-medium">{{ section.settings.callout }}</p>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "ParaPatrol: safety",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Safety & who it’s for" },
    { "type": "textarea", "id": "callout", "label": "Doctor callout", "default": "Itchy bottom at night or worms you can see? That’s a job for your doctor, not a supplement." }
  ],
  "blocks": [
    { "type": "item", "name": "Safety point", "settings": [
      { "type": "text", "id": "lead", "label": "Bold start" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [ { "name": "ParaPatrol: safety" } ]
}
{% endschema %}
