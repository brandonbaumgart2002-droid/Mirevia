{%- comment -%}
  Safety profile: why it's gentle enough for a child. Always visible, never in an accordion.
  Order: intro → four design pillars → ingredient-by-ingredient notes → who it isn't for / when to stop
  → doctor callout → button back up to the buy box (bundles).
  Blocks: pillar (icon, title, text), ingredient (name, tag, text), item (who-it's-for / stop-use point),
  stop (stop-use point). Only facts the brand can back up: no study counts, no "clinically proven".
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign pillars = section.blocks | where: 'type', 'pillar'
  assign ings = section.blocks | where: 'type', 'ingredient'
  assign items = section.blocks | where: 'type', 'item'
  assign stops = section.blocks | where: 'type', 'stop'
-%}
{{ 'parapatrol.css' | asset_url | stylesheet_tag }}
<script src="{{ 'parapatrol.js' | asset_url }}" defer></script>
<div class="pp" id="safety">
  <section class="bg-soft py-14 lg:py-20" aria-labelledby="pp-safe-{{ section.id }}">
    <div class="max-w-5xl mx-auto px-4">
      <div class="max-w-3xl">
        {%- if s.eyebrow != blank -%}<p class="text-sm font-bold uppercase tracking-[.14em] text-primary">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 id="pp-safe-{{ section.id }}" class="mt-2 font-display font-bold text-[30px] sm:text-[40px] leading-[1.1] text-ink">{{ s.heading }}</h2>
        {%- if s.intro != blank -%}<div class="pp-adv-copy pp-adv-copy--sm mt-4">{%- render 'parapatrol-claim', text: s.intro -%}</div>{%- endif -%}
      </div>

      {%- if pillars.size > 0 -%}
        <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" role="list">
          {%- for block in pillars -%}
            <li class="rounded-3xl bg-white p-5 shadow-soft" {{ block.shopify_attributes }}>
              <span class="w-11 h-11 rounded-2xl bg-mint text-primary inline-flex items-center justify-center" aria-hidden="true">{%- render 'parapatrol-icon', name: block.settings.icon, icon_size: 22 -%}</span>
              <p class="mt-3 font-display font-bold text-[19px] leading-snug text-ink">{{ block.settings.title }}</p>
              <p class="mt-1.5 text-[15px] leading-relaxed text-ink">{%- render 'parapatrol-claim', text: block.settings.text -%}</p>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if ings.size > 0 -%}
        <div class="mt-12">
          {%- if s.ing_heading != blank -%}<h3 class="font-display font-bold text-[24px] sm:text-[30px] leading-tight text-ink">{{ s.ing_heading }}</h3>{%- endif -%}
          {%- if s.ing_intro != blank -%}<p class="mt-2 text-[16px] leading-relaxed text-muted max-w-3xl">{{ s.ing_intro }}</p>{%- endif -%}
          <div class="mt-6 grid gap-3 md:grid-cols-2">
            {%- for block in ings -%}
              <article class="rounded-3xl bg-white border border-line p-5 sm:p-6" {{ block.shopify_attributes }}>
                <div class="flex flex-wrap items-center gap-2">
                  <h4 class="font-display font-bold text-[20px] leading-snug text-ink">{{ block.settings.name }}</h4>
                  {%- if block.settings.tag != blank -%}<span class="rounded-full bg-mint px-2.5 py-0.5 text-[12px] font-extrabold text-primary-dark">{{ block.settings.tag }}</span>{%- endif -%}
                </div>
                <div class="pp-adv-copy pp-adv-copy--sm mt-2">{%- render 'parapatrol-claim', text: block.settings.text -%}</div>
              </article>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if items.size > 0 or stops.size > 0 -%}
        <div class="mt-12 grid gap-4 md:grid-cols-2">
          {%- if items.size > 0 -%}
            <div class="rounded-3xl bg-white p-6 sm:p-8 shadow-soft">
              <p class="flex items-center gap-2 font-display font-bold text-[22px] text-ink"><span class="text-primary">{%- render 'parapatrol-icon', name: 'shield', icon_size: 22 -%}</span>{{ s.who_heading }}</p>
              <ul class="mt-4 grid gap-3" role="list">
                {%- for block in items -%}
                  <li class="flex gap-3 text-[15px] leading-relaxed" {{ block.shopify_attributes }}>
                    <span class="mt-2 w-2 h-2 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
                    <p>{% if block.settings.lead != blank %}<strong class="font-extrabold">{{ block.settings.lead }}</strong> {% endif %}{{ block.settings.text }}</p>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
          {%- if stops.size > 0 -%}
            <div class="rounded-3xl bg-[#fdeef3] border border-accent p-6 sm:p-8">
              <p class="flex items-center gap-2 font-display font-bold text-[22px] text-ink"><span class="text-berry">{%- render 'parapatrol-icon', name: 'shield-alert', icon_size: 22 -%}</span>{{ s.stop_heading }}</p>
              <ul class="mt-4 grid gap-3" role="list">
                {%- for block in stops -%}
                  <li class="flex gap-3 text-[15px] leading-relaxed" {{ block.shopify_attributes }}>
                    <span class="mt-2 w-2 h-2 shrink-0 rounded-full bg-berry" aria-hidden="true"></span>
                    <p>{{ block.settings.text }}</p>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.callout != blank -%}
        <p class="mt-4 rounded-3xl bg-white border-l-4 border-primary p-5 sm:p-6 text-[16px] font-semibold text-ink">{{ s.callout }}</p>
      {%- endif -%}

      {%- if s.button_label != blank -%}
        <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-5">
          <a href="#pp-buy" data-pp-to-buy class="inline-flex items-center justify-center gap-2 min-h-[56px] px-8 rounded-full bg-primary hover:bg-primary-dark text-white font-extrabold text-[17px] shadow-lift transition-colors">
            {{- s.button_label -}}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
          </a>
          {%- if s.button_note != blank -%}<p class="text-[14px] text-muted">{{ s.button_note }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "ParaPatrol: safety",
  "settings": [
    { "type": "paragraph", "content": "Only facts you can back up with your label, supplier specs or test results. No study counts or 'clinically proven' unless you hold the evidence." },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Safety profile" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Is it gentle enough for my child?" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "ing_heading", "label": "Ingredient notes heading", "default": "Ingredient by ingredient" },
    { "type": "textarea", "id": "ing_intro", "label": "Ingredient notes intro" },
    { "type": "text", "id": "who_heading", "label": "Who it's for: heading", "default": "Who it's for" },
    { "type": "text", "id": "stop_heading", "label": "When to stop: heading", "default": "Stop and call your doctor if" },
    { "type": "textarea", "id": "callout", "label": "Doctor callout", "default": "Itchy bottom at night or worms you can see? That’s a job for your doctor, not a supplement." },
    { "type": "text", "id": "button_label", "label": "Button label", "info": "Scrolls up to the bundles. Blank hides it.", "default": "Choose your bundle" },
    { "type": "text", "id": "button_note", "label": "Small line beside the button", "default": "30-day money-back guarantee · Free shipping" }
  ],
  "blocks": [
    { "type": "pillar", "name": "Design point", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [
        { "value": "shield", "label": "Shield" }, { "value": "leaf", "label": "Leaf" }, { "value": "check", "label": "Tick" },
        { "value": "heart", "label": "Heart" }, { "value": "lock", "label": "Lock" }, { "value": "reset", "label": "Cycle" }, { "value": "info", "label": "Info" }
      ] },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] },
    { "type": "ingredient", "name": "Ingredient note", "settings": [
      { "type": "text", "id": "name", "label": "Ingredient" },
      { "type": "text", "id": "tag", "label": "Tag", "info": "e.g. Settle, Reset, Strengthen" },
      { "type": "richtext", "id": "text", "label": "Note" }
    ] },
    { "type": "item", "name": "Who it's for", "settings": [
      { "type": "text", "id": "lead", "label": "Bold start" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] },
    { "type": "stop", "name": "When to stop", "settings": [
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [ { "name": "ParaPatrol: safety" } ]
}
{% endschema %}
