{%- comment -%} FDA disclaimer. Every * on the page links here (#pp-fda). Keep this section on the template. {%- endcomment -%}
{{ 'parapatrol.css' | asset_url | stylesheet_tag }}
<div class="pp">
  <div class="bg-mint text-muted py-8 pb-28 lg:pb-8 border-t border-line">
    <div class="max-w-4xl mx-auto px-4 text-[13px] leading-relaxed">
      <p id="pp-fda" class="text-ink font-medium scroll-mt-6" tabindex="-1">{{ section.settings.fda_text }}</p>
      {%- if section.settings.small_print != blank -%}<p class="mt-4">{{ section.settings.small_print }}</p>{%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "ParaPatrol: disclaimer",
  "settings": [
    { "type": "textarea", "id": "fda_text", "label": "Disclaimer", "default": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease." },
    { "type": "textarea", "id": "small_print", "label": "Small print", "default": "Always read the label. Talk to your pediatrician before use if your child takes medication or has a health condition." }
  ],
  "presets": [ { "name": "ParaPatrol: disclaimer" } ]
}
{% endschema %}
