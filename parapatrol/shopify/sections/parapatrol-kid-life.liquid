{%- comment -%}
  "Made for real kid life": square lifestyle photos of kids with the product, each with a short caption.
  Each tile uses its image picker, or the built-in theme asset named in the block, or a placeholder.
  Lifestyle imagery only: no captions that read like a customer result.
{%- endcomment -%}
{{ 'parapatrol.css' | asset_url | stylesheet_tag }}
<div class="pp">
  <section class="bg-white py-12 lg:py-20" aria-labelledby="pp-life-{{ section.id }}">
    <div class="max-w-6xl mx-auto px-4">
      <div class="max-w-2xl">
        {%- if section.settings.eyebrow != blank -%}<p class="text-sm font-bold uppercase tracking-[.14em] text-primary">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 id="pp-life-{{ section.id }}" class="font-display font-semibold text-[30px] sm:text-[38px] leading-[1.1] mt-2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="mt-3 text-[16px] sm:text-[17px] text-ink/90">{%- render 'parapatrol-claim', text: section.settings.text -%}</p>{%- endif -%}
      </div>
      {%- comment -%} Swipeable row on phones, three across on desktop {%- endcomment -%}
      <ul class="mt-8 -mx-4 px-4 scroll-px-4 flex gap-3 overflow-x-auto snap-x snap-mandatory pb-2 sm:mx-0 sm:px-0 sm:grid sm:grid-cols-3 sm:gap-5 sm:overflow-visible" role="list">
        {%- for block in section.blocks -%}
          <li class="snap-start shrink-0 w-[82%] sm:w-auto" {{ block.shopify_attributes }}>
            <figure>
              {%- render 'parapatrol-media', image: block.settings.image, asset: block.settings.asset, label: block.settings.caption, alt: block.settings.alt, class: 'aspect-square rounded-3xl', sizes: '(min-width: 1152px) 360px, (min-width: 640px) 31vw, 82vw' -%}
              {%- if block.settings.caption != blank -%}
                <figcaption class="mt-3 font-display font-semibold text-[19px] leading-snug">{{ block.settings.caption }}</figcaption>
              {%- endif -%}
              {%- if block.settings.subcaption != blank -%}
                <p class="mt-1 text-[14px] text-muted">{{ block.settings.subcaption }}</p>
              {%- endif -%}
            </figure>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "ParaPatrol: kid life",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Made for real kid life" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sandpits, school runs and sticky fingers." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "One easy drop in their morning juice, so busy little tummies stay on track through all of it.*" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (square)" },
        { "type": "text", "id": "asset", "label": "Built-in image file", "info": "Used when no image is chosen. A file in the theme's assets folder." },
        { "type": "text", "id": "alt", "label": "Image description (for screen readers)" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "text", "id": "subcaption", "label": "Small text" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "ParaPatrol: kid life", "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ] } ]
}
{% endschema %}
