{%- comment -%}
  ParaPatrol hero: gallery, badges, title, headline (A/B/C), rating, subhead,
  benefit ticks, purchase box, sticky mobile add-to-cart. Also holds the brand
  colour tokens and font loading for every ParaPatrol section on the page.
{%- endcomment -%}

{%- if section.settings.load_google_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- comment -%} Loaded without blocking first paint; text shows in the fallback font until it arrives {%- endcomment -%}
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@800;900&family=Nunito+Sans:opsz,wght@6..12,400;6..12,700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Nunito:wght@800;900&family=Nunito+Sans:opsz,wght@6..12,400;6..12,700&display=swap" rel="stylesheet"></noscript>
{%- endif -%}
{{ 'parapatrol.css' | asset_url | stylesheet_tag }}
<script>window.ppGiftImages = { 'free shipping': {{ 'pp-gift-free-shipping.jpg' | asset_url | json }} };</script>
{%- unless section.settings.hide_tier_images -%}<script>window.ppTierImages = { 1: {{ 'pp-tier-1.png' | asset_url | json }}, 2: {{ 'pp-tier-2.png' | asset_url | json }}, 3: {{ 'pp-tier-3.png' | asset_url | json }}, 4: {{ 'pp-tier-4.png' | asset_url | json }}, 5: {{ 'pp-tier-5.png' | asset_url | json }}, 6: {{ 'pp-tier-6.png' | asset_url | json }} };</script>{%- endunless -%}
<script src="{{ 'parapatrol.js' | asset_url }}" defer></script>

<style>
  body { background-color: {{ section.settings.pp_cream }}; }
  html:root {
    --pp-cream: {{ section.settings.pp_cream }};
    --pp-label-mint: {{ section.settings.pp_mint }};
    --pp-mint-deep: {{ section.settings.pp_mint_deep }};
    --pp-raspberry: {{ section.settings.pp_raspberry }};
    --pp-blush: {{ section.settings.pp_blush }};
    --brand-primary: {{ section.settings.brand_primary }};
    --brand-primary-dark: {{ section.settings.brand_primary_dark }};
    --brand-accent: {{ section.settings.brand_accent }};
    --brand-berry: {{ section.settings.brand_berry }};
    --bg-soft: {{ section.settings.bg_soft }};
    --bg-mint: {{ section.settings.bg_mint }};
    --ink: {{ section.settings.ink }};
    --ink-muted: {{ section.settings.ink_muted }};
    --line: {{ section.settings.line }};
    {%- if section.settings.use_theme_fonts %}
      --pp-font-display: var(--font-heading-family);
      --pp-font-body: var(--font-body-family);
    {%- endif %}
  }
</style>

{%- liquid
  assign free_ship = section.settings.free_shipping | times: 100
  assign badges = section.settings.badges | split: ','
  assign images = product.media | where: 'media_type', 'image'
  assign rating = product.metafields.reviews.rating.value
-%}

<div class="pp bg-white" data-pp-band="{{ section.settings.band | default: 'auto' }}" id="pp-main-{{ section.id }}" data-pp-main data-after-add="{{ section.settings.after_add }}" data-cart-url="{{ routes.cart_url }}" data-cart-add-url="{{ routes.cart_add_url }}">
  <section class="max-w-6xl mx-auto px-4 pt-3 pb-10 lg:pt-10 lg:pb-20 grid lg:grid-cols-[1.05fr_1fr] gap-3 lg:gap-12" aria-labelledby="pp-title-{{ section.id }}">

    {%- comment -%} Gallery {%- endcomment -%}
    <div class="lg:sticky lg:top-6 self-start min-w-0" data-pp-gallery>
      <div class="gallery-track flex overflow-x-auto rounded-3xl" data-pp-gallery-track tabindex="0" role="region" aria-label="Product images. Use the thumbnails or swipe to browse.">
        {%- if images.size > 0 -%}
          {%- for media in images limit: 12 -%}
            {%- liquid
              assign loading = 'lazy'
              assign priority = false
              assign media_alt = media.alt | default: product.title
              if forloop.first
                assign loading = 'eager'
                assign priority = true
              endif
            -%}
            {%- render 'parapatrol-media', image: media.preview_image, label: 'product image', alt: media_alt, class: 'shrink-0 w-full aspect-square rounded-3xl', sizes: '(min-width: 1152px) 560px, (min-width: 1024px) 48vw, calc(100vw - 32px)', loading: loading, priority: priority, fit: 'contain' -%}
          {%- endfor -%}
        {%- else -%}
          {%- render 'parapatrol-media', label: section.settings.ph_1, alt: 'ParaPatrol bottle on a white background', class: 'shrink-0 w-full aspect-square rounded-3xl' -%}
          {%- render 'parapatrol-media', label: section.settings.ph_2, alt: 'Dropper of ParaPatrol going into a cup of orange juice', class: 'shrink-0 w-full aspect-square rounded-3xl' -%}
          {%- render 'parapatrol-media', label: section.settings.ph_3, alt: 'Child playing outdoors in the sand', class: 'shrink-0 w-full aspect-square rounded-3xl' -%}
          {%- render 'parapatrol-media', label: section.settings.ph_4, alt: 'ParaPatrol supplement facts label', class: 'shrink-0 w-full aspect-square rounded-3xl' -%}
        {%- endif -%}
      </div>
      {%- liquid
        assign slide_count = images.size | at_most: 12
        if images.size == 0
          assign slide_count = 4
        endif
      -%}
      {%- if slide_count > 1 -%}
        <div class="flex justify-center gap-1.5 mt-2 sm:hidden" aria-hidden="true">
          {%- for i in (1..slide_count) -%}<span data-pp-dot-nav class="w-2 h-2 rounded-full {% if forloop.first %}bg-primary{% else %}bg-line{% endif %}"></span>{%- endfor -%}
        </div>
        <div class="max-sm:hidden sm:grid grid-cols-4 gap-3 mt-3" role="group" aria-label="Choose image">
          {%- if images.size > 0 -%}
            {%- for media in images limit: 12 -%}
              <button type="button" data-pp-thumb class="disable-global-button-styling block overflow-hidden aspect-square rounded-2xl bg-mint{% if forloop.first %} ring-2 ring-primary ring-offset-2{% endif %}" aria-label="Show image {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}>
                {{- media.preview_image | image_url: width: 240 | image_tag: alt: '', loading: 'lazy', class: 'w-full h-full object-cover' -}}
              </button>
            {%- endfor -%}
          {%- else -%}
            {%- assign thumb_labels = 'bottle,juice,play,facts' | split: ',' -%}
            {%- for t in thumb_labels -%}
              <button type="button" data-pp-thumb class="disable-global-button-styling ph aspect-square rounded-2xl !text-[10px] !p-1{% if forloop.first %} ring-2 ring-primary ring-offset-2{% endif %}" aria-label="Show image {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}>[IMG: {{ t }}]</button>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Product info. Title, rating, price and the paediatrician line come first so the price is in the first screen on phones. {%- endcomment -%}
    <div class="flex flex-col min-w-0">
      {%- liquid
        assign hero_v = product.selected_or_first_available_variant
        assign hero_sub = hero_v.selling_plan_allocations.first
        assign hero_save = 0
        if hero_sub
          assign hero_save = hero_v.price | minus: hero_sub.price | times: 100 | divided_by: hero_v.price | floor
        endif
      -%}
      <div class="order-1">

        {%- liquid
          assign score = blank
          assign review_count = blank
          if rating != blank
            assign score = rating.rating | round: 1
            assign review_count = product.metafields.reviews.rating_count.value
          elsif section.settings.rating_score_fallback != blank
            assign score = section.settings.rating_score_fallback
            assign review_count = section.settings.rating_count_fallback
          endif
        -%}
        {%- if score == blank and section.settings.judgeme_badge -%}
          <a href="#reviews" data-pp-scroll data-pp-jm-badge data-shop="{{ shop.permanent_domain }}" data-pid="{{ product.id }}" class="hidden items-center gap-2 text-[15px] text-ink"><span data-pp-jm-badge-stars class="flex"></span><span class="font-bold" data-pp-jm-badge-avg></span><span class="underline underline-offset-2" data-pp-jm-badge-count></span></a>
          <script>
            (function () {
              var a = document.currentScript.previousElementSibling;
              fetch('https://api.judge.me/reviews/reviews_for_widget?url=' + a.dataset.shop + '&shop_domain=' + a.dataset.shop + '&platform=shopify&page=1&per_page=1&product_id=' + a.dataset.pid).then(function (r) { return r.json(); }).then(function (d) {
                if (!d.number_of_reviews) return;
                var h = ''; for (var i = 1; i <= 5; i++) h += '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="' + (i <= Math.round(+d.average_rating) ? '#e27aa3' : '#f0dbe3') + '" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.2 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>';
                a.querySelector('[data-pp-jm-badge-stars]').innerHTML = h;
                a.querySelector('[data-pp-jm-badge-avg]').textContent = String(+(+d.average_rating).toFixed(2));
                a.querySelector('[data-pp-jm-badge-count]').textContent = '(' + d.number_of_reviews + ' reviews)';
                a.classList.remove('hidden'); a.classList.add('flex');
              }).catch(function () {});
            })();
          </script>
        {%- endif -%}
        {%- if score != blank -%}
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[15px]">
            {%- if section.settings.rating_avatars != blank -%}
              {%- assign avs = section.settings.rating_avatars | split: ',' -%}
              <span class="flex -space-x-2 mr-0.5" aria-hidden="true">{%- for a in avs limit: 3 -%}{%- assign a_f = a | strip -%}<img src="{{ a_f | asset_img_url: '64x64', crop: 'center' }}" alt="" width="28" height="28" loading="lazy" class="w-7 h-7 rounded-full object-cover border-2 border-white">{%- endfor -%}</span>
            {%- endif -%}
            <span data-pp-live-stars class="inline-flex">{%- render 'parapatrol-stars', score: score, size: 18 -%}</span>
            <span class="font-bold text-ink" data-pp-live-avg>{{ score }}</span>
            {%- if section.settings.rating_text != blank -%}<a href="#reviews" class="text-ink underline underline-offset-2 hover:text-primary">{{ section.settings.rating_text }}</a>{%- else -%}<a href="#reviews" class="text-ink underline underline-offset-2 hover:text-primary">(<span data-pp-live-count>{% if review_count != blank %}{{ review_count }} {% endif %}</span>{{ section.settings.rating_label }})</a>{%- endif -%}
          </div>
          {%- comment -%} The stored rating can lag behind Judge.me; refresh the numbers from the live widget data {%- endcomment -%}
          <script>
            (function () {
              var row = document.currentScript.previousElementSibling;
              fetch('https://api.judge.me/reviews/reviews_for_widget?url={{ shop.permanent_domain }}&shop_domain={{ shop.permanent_domain }}&platform=shopify&page=1&per_page=1&product_id={{ product.id }}')
                .then(function (r) { return r.json(); }).then(function (d) {
                  var n = d.number_of_reviews, avg = +d.average_rating; if (!n || !avg) return;
                  var lc = row.querySelector('[data-pp-live-count]'); if (lc) lc.textContent = n + ' ';
                  row.querySelector('[data-pp-live-avg]').textContent = String(Math.round(avg * 10) / 10);
                  var h = ''; for (var i = 1; i <= 5; i++) { var f = Math.max(0, Math.min(1, avg - i + 1)); h += '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="ppls' + i + '"><stop offset="' + (f * 100) + '%" stop-color="var(--pp-star)"/><stop offset="' + (f * 100) + '%" stop-color="var(--pp-star-empty)"/></linearGradient></defs><path fill="url(#ppls' + i + ')" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.2 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>'; }
                  var st = row.querySelector('[data-pp-live-stars]'); st.innerHTML = h; st.setAttribute('aria-label', (Math.round(avg * 10) / 10) + ' out of 5 stars'); st.style.display = 'inline-flex'; st.style.gap = '2px';
                }).catch(function () {});
            })();
          </script>
        {%- endif -%}

        {%- if section.settings.pill_1 != blank or section.settings.pill_2 != blank -%}
          <ul class="mt-2 flex flex-wrap gap-1.5" role="list" aria-label="Formula credentials">
            {%- if section.settings.pill_1 != blank -%}<li class="pp-pill pp-pill--blush"><span aria-hidden="true">✦</span> {{ section.settings.pill_1 }}</li>{%- endif -%}
            {%- if section.settings.pill_2 != blank -%}<li class="pp-pill pp-pill--mint"><span aria-hidden="true">+</span> {{ section.settings.pill_2 }}</li>{%- endif -%}
          </ul>
        {%- endif -%}
        <h1 id="pp-title-{{ section.id }}" class="pp-title mt-2 font-display text-ink leading-[1.02]">
          {{- product.title -}}
          {%- if section.settings.sub_label != blank %}<span class="block mt-1 font-sans font-bold text-[15px] sm:text-[17px] text-muted tracking-normal">{{ section.settings.sub_label }}</span>{% endif -%}
        </h1>

        {%- if section.settings.show_hero_price -%}
          <p class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-1" data-pp-hero-price-row>
            {%- if hero_sub -%}
              <span class="font-display font-semibold text-[28px] leading-none" data-pp-hero-price>{{ hero_sub.price | money }}</span>
              <s class="text-muted text-[15px]" data-pp-hero-compare>{{ hero_v.price | money }}</s>
              {%- if hero_save > 0 %}<span class="px-2 py-0.5 rounded-full bg-berry text-white text-[11px] font-bold self-center" data-pp-hero-save>SAVE {{ hero_save }}%</span>{% endif -%}
              <span class="text-[13px] text-muted" data-pp-hero-note>with Subscribe &amp; save</span>
            {%- else -%}
              <span class="font-display font-semibold text-[28px] leading-none" data-pp-hero-price>{{ hero_v.price | money }}</span>
            {%- endif -%}
          </p>

        {%- endif -%}

        {%- if section.settings.authority != blank -%}
          {%- if section.settings.show_hero_price -%}
            <p class="mt-2.5 inline-flex items-center gap-1.5 rounded-full bg-mint text-primary-dark text-[13px] font-bold px-3 py-1">
              {%- render 'parapatrol-icon', name: 'shield', icon_size: 15 -%}
              <span>{{ section.settings.authority }}</span>
            </p>
          {%- else -%}
            {%- comment -%} Price hidden: the expert line takes its place as a fuller badge {%- endcomment -%}
            <div class="mt-3 inline-flex items-center gap-3 rounded-2xl bg-mint border border-line pl-2 pr-4 py-2">
              <span class="w-10 h-10 shrink-0 rounded-full bg-white text-primary inline-flex items-center justify-center shadow-soft" aria-hidden="true">{%- render 'parapatrol-icon', name: 'shield', icon_size: 20 -%}</span>
              <span class="leading-tight">
                <span class="block font-display font-bold text-[17px] sm:text-[18px] text-primary-dark">{{ section.settings.authority }}</span>
                {%- if section.settings.authority_note != blank -%}<span class="block text-[13px] font-semibold text-muted mt-0.5">{{ section.settings.authority_note }}</span>{%- endif -%}
              </span>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="order-2 mt-2.5">
        {%- liquid
          case section.settings.headline_default
            when 'b'
              assign headline = section.settings.headline_b
            when 'c'
              assign headline = section.settings.headline_c
            else
              assign headline = section.settings.headline_a
          endcase
        -%}
        {%- if section.settings.eyebrow != blank -%}<p class="mb-1.5 text-[12px] sm:text-[13px] font-extrabold uppercase tracking-[.14em] text-raspberry">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <p class="pp-headline font-display text-ink" data-pp-headline
           data-a="{{ section.settings.headline_a | escape }}" data-b="{{ section.settings.headline_b | escape }}" data-c="{{ section.settings.headline_c | escape }}">{%- assign hl_parts = headline | escape | split: '*' -%}{%- for part in hl_parts -%}{%- assign odd = forloop.index0 | modulo: 2 -%}{%- if odd == 1 -%}<em class="pp-accent">{{ part }}</em>{%- else -%}{{ part }}{%- endif -%}{%- endfor -%}</p>

        {%- if section.settings.subhead != blank -%}
          <p class="mt-2 text-[15px] sm:text-[17px] leading-relaxed text-ink/90 max-w-[544px]">{%- render 'parapatrol-claim', text: section.settings.subhead -%}</p>
        {%- endif -%}

        {%- if section.settings.benefit_list != blank -%}
          {%- assign bl_items = section.settings.benefit_list | newline_to_br | split: '<br />' -%}
          <ul class="mt-4 grid gap-2" role="list" aria-label="Product highlights">
            {%- for l in bl_items -%}{%- assign f = l | strip | split: '|' -%}{%- if f.size >= 1 and f[0] != blank -%}
              <li class="flex items-start gap-2 text-[13.5px] sm:text-[15px] leading-[1.4] text-ink">
                <span class="mt-px inline-flex w-[18px] h-[18px] shrink-0 rounded-full bg-raspberry text-white items-center justify-center" aria-hidden="true">{%- render 'parapatrol-icon', name: 'check', icon_size: 11 -%}</span>
                <span><strong class="font-extrabold">{{ f[0] | strip }}</strong>{%- if f.size >= 2 %} <span class="text-muted">· {{ f[1] | strip }}</span>{%- endif -%}</span>
              </li>
            {%- endif -%}{%- endfor -%}
          </ul>
        {%- elsif section.settings.benefit_grid != blank -%}
          {%- assign bg_items = section.settings.benefit_grid | newline_to_br | split: '<br />' -%}
          <ul class="mt-4 grid grid-cols-6 gap-2" aria-label="Product highlights">
            {%- for l in bg_items -%}{%- assign f = l | strip | split: '|' -%}{%- if f.size >= 2 -%}
              <li class="flex flex-col items-center justify-center gap-1.5 rounded-2xl bg-mint border border-line px-1.5 py-3 text-center {% if bg_items.size == 4 or bg_items.size == 2 %}col-span-3{% elsif bg_items.size == 5 and forloop.index > 3 %}col-span-3{% else %}col-span-2{% endif %}">
                <span class="w-10 h-10 rounded-full bg-white text-primary inline-flex items-center justify-center shadow-soft" aria-hidden="true">{%- assign pp_v = f[0] | strip -%}{%- render 'parapatrol-icon', name: pp_v, icon_size: 22 -%}</span>
                <span class="text-[12.5px] sm:text-[13px] font-extrabold leading-tight text-primary-dark">{{ f[1] | strip }}</span>
              </li>
            {%- endif -%}{%- endfor -%}
          </ul>
        {%- elsif badges.size > 0 -%}
          <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Product highlights">
            {%- for b in badges -%}
              <li class="px-2.5 py-1 rounded-full bg-mint text-primary-dark text-[12px] font-bold">{{ b | strip }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} Ticks sit under the buy box on mobile (keeps purchase near the fold), above it on desktop {%- endcomment -%}
      <ul class="order-3 mt-4 grid gap-2 text-[15px] font-medium">
        {%- for i in (1..3) -%}
          {%- assign key = 'tick_' | append: i -%}
          {%- assign tick = section.settings[key] -%}
          {%- if tick != blank -%}
            <li class="flex items-start gap-2.5">
              <span class="mt-0.5 inline-flex w-5 h-5 shrink-0 rounded-full bg-primary text-white items-center justify-center">{%- render 'parapatrol-icon', name: 'check', icon_size: 12 -%}</span>
              <span>{%- render 'parapatrol-claim', text: tick -%}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <div id="pp-buy" class="order-4 mt-4 scroll-mt-28" data-pp-hero-box>
        {%- if section.settings.show_stock -%}
          {%- capture pp_stock -%}{%- render 'parapatrol-stock', variant: product.selected_or_first_available_variant, manual: section.settings.stock_manual, threshold: section.settings.stock_threshold, label: section.settings.stock_label, suffix: section.settings.stock_suffix -%}{%- endcapture -%}
          {%- if pp_stock != blank -%}<div class="mb-3">{{ pp_stock }}</div>{%- endif -%}
        {%- endif -%}
        {%- if section.settings.sale_end_date != blank -%}
          <div class="mb-3">{%- render 'parapatrol-countdown', label: section.settings.sale_label, end_date: section.settings.sale_end_date, end_time: section.settings.sale_end_time, note: section.settings.sale_note -%}</div>
        {%- endif -%}
        {%- render 'parapatrol-buybox', product: product, uid: section.id, free_shipping: free_ship, guarantee: section.settings.guarantee, trust: section.settings.trust, payment_icons: section.settings.payment_icons, subscribe_note: section.settings.subscribe_note, delivery: section.settings.show_delivery, proc_min: section.settings.proc_min, proc_max: section.settings.proc_max, del_min: section.settings.del_min, del_max: section.settings.del_max, delivery_note: section.settings.delivery_note, tier_heading: section.settings.tier_heading, ship_note: section.settings.ship_note, gift_1_label: section.settings.gift_1_label, gift_2: section.settings.gift_2, gift_3: section.settings.gift_3, gift_short_2: section.settings.gift_short_2, gift_short_3: section.settings.gift_short_3, gift_unlock_2: section.settings.gift_unlock_2, gift_unlock_3: section.settings.gift_unlock_3, gifts_heading: section.settings.gifts_heading -%}

        {%- if section.settings.trust_chips != blank -%}
          {%- assign tc_items = section.settings.trust_chips | newline_to_br | split: '<br />' -%}
          <ul class="mt-3 flex flex-wrap justify-center gap-2" role="list" aria-label="Why parents trust Para Patrol">
            {%- for l in tc_items -%}{%- assign f = l | strip | split: '|' -%}{%- assign tc_icon = f[0] | strip -%}
              {%- if f.size >= 2 -%}{%- unless tc_icon == 'lab' and section.settings.coa_url == blank -%}
                <li class="inline-flex items-center gap-1.5 rounded-full bg-mint border border-line px-3 py-1.5 text-[13px] font-bold text-ink">
                  <span class="text-mintdeep" aria-hidden="true">{%- render 'parapatrol-icon', name: tc_icon, icon_size: 16 -%}</span>
                  {%- if tc_icon == 'lab' -%}<a href="{{ section.settings.coa_url }}" target="_blank" rel="noopener" {% render 'parapatrol-coa-attrs' %} class="underline underline-offset-2">{%- render 'parapatrol-claim', text: f[1] -%}</a>{%- else -%}<span>{{ f[1] | strip | replace: '[[', '<mark class="pp-ph">[[' | replace: ']]', ']]</mark>' }}</span>{%- endif -%}
                </li>
              {%- endunless -%}{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.gcard_title != blank -%}
          {%- assign gc_items = section.settings.gcard_items | newline_to_br | split: '<br />' -%}
          <div class="pp-gcard mt-4 rounded-3xl border-2 border-ink bg-white px-4 sm:px-6 py-5 text-center">
            <p class="font-display font-bold text-[22px] sm:text-[24px] leading-tight text-primary">{{ section.settings.gcard_title }}</p>
            {%- if section.settings.gcard_text != blank -%}<p class="mt-1 text-[15px] text-ink">{{ section.settings.gcard_text }}</p>{%- endif -%}
            {%- if section.settings.gcard_items != blank -%}
              <ul class="mt-4 pt-4 border-t border-ink grid grid-cols-3 gap-2" role="list">
                {%- for l in gc_items -%}{%- assign f = l | strip | split: '|' -%}{%- if f.size >= 2 -%}
                  <li class="flex flex-col items-center gap-1.5"><span class="text-primary" aria-hidden="true">{%- assign pp_v = f[0] | strip -%}{%- render 'parapatrol-icon', name: pp_v, icon_size: 24 -%}</span><span class="text-[13px] sm:text-[14px] font-extrabold leading-tight text-ink">{{ f[1] | strip }}</span></li>
                {%- endif -%}{%- endfor -%}
              </ul>
            {%- endif -%}
            {%- if shop.enabled_payment_types.size > 0 -%}
              <ul class="pp-payments mt-4 pt-4 border-t border-ink flex flex-wrap justify-center gap-1.5" role="list" aria-label="Payment methods">
                {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'pp-payment-icon' }}</li>{%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.mandatory != blank -%}<p class="mt-3 text-center text-[13px] font-bold text-ink">{{ section.settings.mandatory }}</p>{%- endif -%}

        {%- comment -%} Quick questions (mighty&co style): a plain list under the buy box. "question | answer" per line. {%- endcomment -%}
        {%- if section.settings.quick_list != blank -%}
          {%- assign ql = section.settings.quick_list | newline_to_br | split: '<br />' -%}
          {%- if section.settings.ing_tile_image != blank -%}{%- assign pp_zoom_src = section.settings.ing_tile_image | image_url: width: 2400 -%}{%- else -%}{%- assign pp_zoom_src = section.settings.ing_tile_asset | asset_url -%}{%- endif -%}
          {%- capture pp_label_zoom -%}
            <button type="button" class="disable-global-button-styling group relative mt-3 block w-full max-w-[420px] cursor-zoom-in rounded-2xl border border-line overflow-hidden" data-pp-zoom="{{ pp_zoom_src }}" data-pp-zoom-alt="Para Patrol Supplement Facts" aria-label="Expand the Supplement Facts label">
              {%- render 'parapatrol-media', image: section.settings.ing_tile_image, asset: section.settings.ing_tile_asset, alt: 'Para Patrol Supplement Facts: 1 dropper (1 mL) serving, about 30 servings. Proprietary blend of licorice root, anise seed, fennel seed, thyme leaf, whole clove, aloe vera, oregano leaf, black walnut hull, wormwood herb, pau d’arco bark and pumpkin seed extracts. Other ingredients: vegetable glycerin, purified water, natural raspberry flavor, bitter blocker. May contain tree nuts (walnuts).', label: 'Supplement Facts', class: 'aspect-square', fit: 'contain', sizes: '(min-width: 1024px) 420px, 92vw' -%}
              <span class="absolute right-2.5 bottom-2.5 inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1.5 text-[12px] font-extrabold text-ink shadow-soft" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M11 8v6M8 11h6"/></svg>Tap to expand</span>
            </button>
          {%- endcapture -%}
          <div class="mt-6" data-pp-accordion>
            {%- if section.settings.quick_heading != blank -%}<p class="pp-qq-label text-[12px] font-extrabold uppercase tracking-[.16em] text-raspberry">{{ section.settings.quick_heading }}</p>{%- endif -%}
            <div class="mt-1.5 pp-qq">
              {%- for l in ql -%}{%- assign f = l | strip | split: '|' -%}{%- if f.size >= 2 -%}
                {%- assign qid = section.id | append: '-ql' | append: forloop.index -%}
                {%- assign qa = l | strip | remove_first: f[0] | remove_first: '|' | strip -%}
                <div class="pp-qq__item">
                  <button type="button" class="disable-global-button-styling acc-btn w-full flex items-center justify-between gap-4 py-3.5 text-left" aria-expanded="false" aria-controls="pp-qa-p-{{ qid }}" id="pp-qa-b-{{ qid }}">
                    <span class="text-[15px] sm:text-[16px] font-semibold leading-snug text-ink">{{ f[0] | strip }}</span>
                    <span class="acc-icon shrink-0 text-raspberry text-[20px] leading-none font-semibold" aria-hidden="true">+</span>
                  </button>
                  <div id="pp-qa-p-{{ qid }}" role="region" aria-labelledby="pp-qa-b-{{ qid }}" class="pb-4 pr-8 text-[14.5px] leading-relaxed text-muted" hidden>
                    {%- if qa contains '{label}' -%}{%- assign qa_txt = qa | remove: '{label}' | strip -%}{%- render 'parapatrol-claim', text: qa_txt -%}{{ pp_label_zoom }}{%- else -%}{%- render 'parapatrol-claim', text: qa -%}{%- endif -%}
                  </div>
                </div>
              {%- endif -%}{%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Quick answers: the biggest objections (safety, taste, dosing and results, guarantee), for shoppers who never reach the full FAQ {%- endcomment -%}
        {%- if section.settings.ing_tile_label != blank or section.settings.quick_q1 != blank or section.settings.quick_q2 != blank or section.settings.quick_q3 != blank or section.settings.quick_q4 != blank -%}
          <div class="mt-5" data-pp-accordion>
            {%- if section.settings.quick_heading != blank -%}
              <p class="mb-2 text-[12px] font-bold uppercase tracking-[.14em] text-primary">{{ section.settings.quick_heading }}</p>
            {%- endif -%}
            <div class="grid gap-2">
              {%- if section.settings.ing_tile_label != blank -%}
                {%- assign iid = section.id | append: '-ing' -%}
                <div class="rounded-2xl bg-soft border border-line">
                  <button type="button" class="disable-global-button-styling acc-btn w-full flex items-center gap-3 px-3 py-3 text-left" aria-expanded="false" aria-controls="pp-qa-p-{{ iid }}" id="pp-qa-b-{{ iid }}">
                    <span class="w-9 h-9 shrink-0 rounded-full bg-white text-primary inline-flex items-center justify-center" aria-hidden="true">{%- render 'parapatrol-icon', name: 'leaf', icon_size: 18 -%}</span>
                    <span class="flex-1 min-w-0 font-display font-bold text-[16px] leading-snug text-ink">{{ section.settings.ing_tile_label }}</span>
                    <span class="acc-icon w-7 h-7 shrink-0 rounded-full bg-mint text-primary inline-flex items-center justify-center text-[18px] leading-none" aria-hidden="true">+</span>
                  </button>
                  <div id="pp-qa-p-{{ iid }}" role="region" aria-labelledby="pp-qa-b-{{ iid }}" class="px-3 pb-4 text-[14px] leading-relaxed text-ink" hidden>
                    {%- if section.settings.ing_tile_text != blank -%}<p class="px-1 mb-3">{{ section.settings.ing_tile_text }}</p>{%- endif -%}
                    {%- if section.settings.ing_tile_image != blank -%}{%- assign pp_zoom_src = section.settings.ing_tile_image | image_url: width: 2400 -%}{%- else -%}{%- assign pp_zoom_src = section.settings.ing_tile_asset | asset_url -%}{%- endif -%}
                    <button type="button" class="disable-global-button-styling group relative block w-full cursor-zoom-in rounded-2xl" data-pp-zoom="{{ pp_zoom_src }}" data-pp-zoom-alt="ParaPatrol Supplement Facts" aria-label="Zoom in on the Supplement Facts">
                      {%- render 'parapatrol-media', image: section.settings.ing_tile_image, asset: section.settings.ing_tile_asset, alt: 'ParaPatrol Supplement Facts: 1 dropper (1 mL) serving, about 30 servings. Proprietary blend of licorice root, anise seed, fennel seed, thyme leaf, whole clove, aloe vera, oregano leaf, black walnut hull, wormwood herb, pau d’arco bark and pumpkin seed extracts. Other ingredients: vegetable glycerin, purified water, natural raspberry flavor, bitter blocker. May contain tree nuts (walnuts).', label: 'Supplement Facts', class: 'aspect-square rounded-2xl', fit: 'contain', sizes: '(min-width: 1024px) 480px, 92vw' -%}
                      <span class="absolute right-2.5 bottom-2.5 inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1.5 text-[12px] font-extrabold text-primary-dark shadow-soft group-hover:bg-mint" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M11 8v6M8 11h6"/></svg>Tap to zoom</span>
                    </button>
                    {%- if section.settings.ing_tile_link_label != blank -%}
                      <a href="{{ section.settings.ing_tile_link | default: '/pages/parent-guide' }}" class="mt-3 mx-1 flex w-fit items-center gap-1 font-extrabold text-primary-dark underline underline-offset-4 hover:text-primary">{{ section.settings.ing_tile_link_label }}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
              {%- for i in (1..4) -%}
                {%- liquid
                  assign q_key = 'quick_q' | append: i
                  assign a_key = 'quick_a' | append: i
                  assign q = section.settings[q_key]
                  assign a = section.settings[a_key]
                  case i
                    when 1
                      assign q_icon = 'shield'
                    when 2
                      assign q_icon = 'heart'
                    when 3
                      assign q_icon = 'sun'
                    else
                      assign q_icon = 'reset'
                  endcase
                -%}
                {%- if q != blank and a != blank -%}
                  {%- assign qid = section.id | append: '-q' | append: i -%}
                  <div class="rounded-2xl bg-soft border border-line">
                    <button type="button" class="disable-global-button-styling acc-btn w-full flex items-center gap-3 px-3 py-3 text-left" aria-expanded="false" aria-controls="pp-qa-p-{{ qid }}" id="pp-qa-b-{{ qid }}">
                      <span class="w-9 h-9 shrink-0 rounded-full bg-white text-primary inline-flex items-center justify-center" aria-hidden="true">{%- render 'parapatrol-icon', name: q_icon, icon_size: 18 -%}</span>
                      <span class="flex-1 min-w-0 font-display font-bold text-[16px] leading-snug text-ink">{{ q }}</span>
                      <span class="acc-icon w-7 h-7 shrink-0 rounded-full bg-mint text-primary inline-flex items-center justify-center text-[18px] leading-none" aria-hidden="true">+</span>
                    </button>
                    <div id="pp-qa-p-{{ qid }}" role="region" aria-labelledby="pp-qa-b-{{ qid }}" class="px-4 pb-4 pl-[60px] text-[14px] leading-relaxed text-ink" hidden>
                      {%- render 'parapatrol-claim', text: a -%}
                      {%- if i == 1 and section.settings.quick_safety_link != blank -%}
                        <a href="#safety" data-pp-scroll class="mt-2 flex w-fit items-center gap-1 font-extrabold text-primary-dark underline underline-offset-4 hover:text-primary">{{ section.settings.quick_safety_link }}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12l7 7 7-7"/></svg></a>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.fda_text != blank -%}
        <p class="order-5 mt-5 text-[12px] leading-snug text-muted">{{ section.settings.fda_text }}</p>
      {%- endif -%}
    </div>
  </section>

  {%- if section.settings.show_sticky -%}
    <div class="pp-sticky fixed inset-x-0 bottom-0 z-50 bg-white border-t border-line shadow-lift translate-y-full" data-pp-sticky role="region" aria-label="Quick add to bag" inert>
      <div class="px-4 py-3 flex items-center gap-3 max-w-xl lg:max-w-6xl mx-auto">
        {%- if images.size > 0 -%}
          <div class="w-11 h-11 rounded-xl overflow-hidden shrink-0 bg-mint">{{ images.first.preview_image | image_url: width: 120 | image_tag: alt: '', loading: 'lazy', class: 'w-full h-full object-cover' }}</div>
        {%- else -%}
          <div class="ph w-11 h-11 rounded-xl !p-0 !text-[8px] shrink-0" aria-hidden="true">[IMG]</div>
        {%- endif -%}
        <div class="min-w-0 flex-1">
          <p class="font-display font-semibold text-[15px] lg:text-[18px] leading-tight truncate">{{ product.title }}</p>
          <p class="text-[13px] text-muted leading-tight" data-pp-sticky-meta></p>
        </div>
        <button type="button" data-pp-sticky-add class="disable-global-button-styling min-h-[46px] px-5 lg:min-h-[50px] lg:px-10 rounded-xl bg-raspberry hover:brightness-95 text-white font-bold text-[15px] lg:text-[16px] whitespace-nowrap">Buy Now</button>
      </div>
    </div>
  {%- endif -%}

  <div class="fixed inset-x-0 top-3 z-[60] flex justify-center pointer-events-none px-4">
    <p data-pp-toast role="status" aria-live="polite" class="opacity-0 -translate-y-2 transition-all duration-200 bg-ink text-white text-sm font-medium px-4 py-2.5 rounded-full shadow-lift"></p>
  </div>
</div>

{% schema %}
{
  "name": "ParaPatrol: product",
  "tag": "section",
  "class": "pp-section",
  "settings": [
    { "type": "header", "content": "Headline (A/B test with ?h=a, ?h=b or ?h=c)" },
    { "type": "text", "id": "sub_label", "label": "Sub-label", "default": "Gentle Gut Support for Kids" },
    { "type": "text", "id": "headline_a", "label": "Headline A", "default": "Get their tummy back on track." },
    { "type": "text", "id": "headline_b", "label": "Headline B", "default": "For the days their tummy just isn’t right." },
    { "type": "text", "id": "headline_c", "label": "Headline C", "default": "Back to normal, one drop at a time." },
    { "type": "select", "id": "headline_default", "label": "Default headline", "default": "a", "options": [ { "value": "a", "label": "A" }, { "value": "b", "label": "B" }, { "value": "c", "label": "C" } ] },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "info": "Every * links to the FDA disclaimer.", "default": "A gentle 11-herb drop made for kids, not adults. One dropper in juice or milk supports gut comfort, healthy digestion and regularity.*" },
    { "type": "text", "id": "badges", "label": "Badges (comma separated)", "default": "Kids 3+, Alcohol-free, Sugar-free, Third-party tested" },
    { "type": "checkbox", "id": "hide_tier_images", "label": "Don’t swap ParaPatrol bottle images into the bundle cards", "default": false },
    { "type": "text", "id": "rating_score_fallback", "label": "Star score when no reviews app data", "info": "e.g. 4.8. Used only if the product has no reviews.rating metafield. Must match your real reviews. Clear it to hide the rating line.", "default": "4.8" },
    { "type": "text", "id": "rating_count_fallback", "label": "Review count when no reviews app data", "info": "e.g. 237+. Must match your real reviews.", "default": "237+" },
    { "type": "text", "id": "rating_label", "label": "Rating label", "default": "parent reviews" },
    { "type": "text", "id": "eyebrow", "label": "Small line above the headline" },
    { "type": "text", "id": "rating_text", "label": "Text next to the stars", "info": "e.g. 500+ Trusted Parent reviews. Blank shows the live review count." },
    { "type": "text", "id": "pill_1", "label": "Credential pill 1 (blush)", "info": "e.g. Paediatrician Reviewed Formula. Blank hides it." },
    { "type": "text", "id": "pill_2", "label": "Credential pill 2 (mint)", "info": "e.g. 3rd-Party Lab Tested. Blank hides it." },
    { "type": "textarea", "id": "benefit_list", "label": "Benefit ticks", "info": "benefit outcome | feature, one per line. Replaces the icon grid." },
    { "type": "textarea", "id": "benefit_grid", "label": "Benefit icon grid", "info": "icon | text, one per line. Icons: kid, no-alcohol, no-sugar, berry, guarantee, leaf, heart, shield, check. Replaces the badge pills." },
    { "type": "text", "id": "mandatory", "label": "Statement under the buy box", "info": "e.g. Always read the label and follow directions for use." },
    { "type": "checkbox", "id": "judgeme_badge", "label": "Show Judge.me star rating under the title", "default": false },
    { "type": "text", "id": "rating_avatars", "label": "Customer photos beside the stars", "info": "Up to 3 built-in image files, comma separated. Blank hides them." },
    { "type": "text", "id": "gcard_title", "label": "Guarantee card under the buy box: title", "info": "Blank hides the card." },
    { "type": "text", "id": "gcard_text", "label": "Guarantee card: text" },
    { "type": "textarea", "id": "gcard_items", "label": "Guarantee card: icon row", "info": "icon | text, 3 lines. Payment icons show under it." },
    { "type": "checkbox", "id": "show_hero_price", "label": "Show price under the title", "info": "Off: the expert line below shows as a larger badge in its place. Prices still show in the buy box.", "default": true },
    { "type": "text", "id": "authority", "label": "Expert line under the price", "info": "Links to the Expert section. Only use if a real practitioner recommends it. Clear to hide.", "default": "Paediatrician recommended" },
    { "type": "text", "id": "authority_note", "label": "Small line under the expert badge", "info": "Shows when the price under the title is hidden.", "default": "Gentle, kid-dosed herbal blend for ages 3+" },
    { "type": "text", "id": "tick_1", "label": "Benefit 1", "default": "Settles tummies*" },
    { "type": "text", "id": "tick_2", "label": "Benefit 2", "default": "Supports a healthy appetite*" },
    { "type": "text", "id": "tick_3", "label": "Benefit 3", "default": "No fuss: mixes into any drink" },

    { "type": "header", "content": "Purchase box" },
    { "type": "textarea", "id": "quick_list", "label": "Quick questions", "info": "question | answer, one per line. Put {label} in an answer to show the zoomable Supplement Facts label there." },
    { "type": "header", "content": "Bundle gifts" },
    { "type": "text", "id": "gifts_heading", "label": "Gifts heading", "default": "Unlock free gifts with bundles" },
    { "type": "text", "id": "gift_1_label", "label": "Bundle 1 perk", "default": "Free shipping" },
    { "type": "product", "id": "gift_2", "label": "Free gift with bundle 2", "info": "Added to the cart with bundle 2. Needs an automatic discount that makes it free." },
    { "type": "text", "id": "gift_short_2", "label": "Bundle 2 gift short name" },
    { "type": "text", "id": "gift_unlock_2", "label": "Bundle 2 unlock line", "default": "With 2 bottles" },
    { "type": "product", "id": "gift_3", "label": "Free gift with bundle 3", "info": "Added to the cart with bundle 3. Needs an automatic discount that makes it free." },
    { "type": "text", "id": "gift_short_3", "label": "Bundle 3 gift short name" },
    { "type": "text", "id": "gift_unlock_3", "label": "Bundle 3 unlock line", "default": "With 4 bottles" },
    { "type": "text", "id": "ship_note", "label": "Line under the button", "info": "e.g. Ships in 1-3 Business Days. Blank shows the free-shipping line." },
    { "type": "textarea", "id": "trust_chips", "label": "Trust strip under the button", "info": "icon | text, one per line. Use the icon name 'lab' for the lab-tested chip: it links to the COA and stays hidden until a COA link is set." },
    { "type": "url", "id": "coa_url", "label": "Certificate of analysis (COA) link" },
    { "type": "text", "id": "tier_heading", "label": "Bundle cards heading", "default": "Free shipping on every bundle" },
    { "type": "text", "id": "subscribe_note", "label": "Subscribe note", "default": "Delivered on your schedule. Skip or cancel anytime." },
    { "type": "textarea", "id": "trust", "label": "Trust badges under the button", "info": "One per line as icon|text. Icons: lock, truck, shield, leaf, heart, check. Only claims you can back up. Clear to show the guarantee line instead.", "default": "lock|Secure checkout\ntruck|Free shipping\nshield|30-day money-back\nleaf|Alcohol & sugar-free" },
    { "type": "checkbox", "id": "payment_icons", "label": "Show payment icons", "info": "Shows the payment methods switched on in Shopify Payments / your checkout.", "default": true },
    { "type": "text", "id": "guarantee", "label": "Guarantee line", "default": "30-day money-back guarantee. Love it or your money back." },
    { "type": "number", "id": "free_shipping", "label": "Free shipping threshold ($)", "info": "0 = free shipping on every order (the buy box says so).", "default": 0 },
    { "type": "select", "id": "after_add", "label": "After adding to bag", "info": "If the theme has no cart drawer, a message is shown instead.", "default": "drawer", "options": [
      { "value": "drawer", "label": "Open the theme's cart drawer" },
      { "value": "message", "label": "Show a message" },
      { "value": "cart", "label": "Go to the cart page" }
    ] },
    { "type": "header", "content": "Delivery estimate" },
    { "type": "checkbox", "id": "show_delivery", "label": "Show delivery estimate under Add to Bag", "info": "Replaces the trust badges. Dates are worked out from today.", "default": true },
    { "type": "number", "id": "proc_min", "label": "Processing: fewest business days", "default": 1 },
    { "type": "number", "id": "proc_max", "label": "Processing: most business days", "default": 2 },
    { "type": "number", "id": "del_min", "label": "Delivery: fewest days from order", "default": 7 },
    { "type": "number", "id": "del_max", "label": "Delivery: most days from order", "default": 15 },
    { "type": "text", "id": "delivery_note", "label": "Small line under the estimate", "default": "Orders are processed within 1–2 business days. Most orders are shipped and delivered within 7–15 days." },
    { "type": "header", "content": "Quick answers under the buy box" },
    { "type": "text", "id": "quick_heading", "label": "Small heading", "default": "Quick answers" },
    { "type": "text", "id": "ing_tile_label", "label": "Ingredients tile: title", "info": "Shows first. Blank hides it.", "default": "Ingredients" },
    { "type": "text", "id": "ing_tile_text", "label": "Ingredients tile: intro", "default": "11 gentle herbs in one 1 mL serving. Alcohol-free, no sugar, gluten-free and vegan friendly." },
    { "type": "image_picker", "id": "ing_tile_image", "label": "Ingredients tile: image" },
    { "type": "text", "id": "ing_tile_asset", "label": "Ingredients tile: built-in image file", "default": "pp-supplement-facts.jpg" },
    { "type": "text", "id": "ing_tile_link_label", "label": "Ingredients tile: link text", "default": "See every ingredient in the Parent Guide" },
    { "type": "url", "id": "ing_tile_link", "label": "Ingredients tile: link", "info": "Defaults to /pages/parent-guide." },
    { "type": "text", "id": "quick_q1", "label": "Question 1", "default": "Is it safe for my child?" },
    { "type": "textarea", "id": "quick_a1", "label": "Answer 1", "default": "ParaPatrol is made and dosed for kids 3 and up: alcohol-free, sugar-free, made in the USA and third-party tested, with a simple 1 mL daily dose. Not for children under 3. If your child takes medication or has a health condition, check with your paediatrician first." },
    { "type": "text", "id": "quick_safety_link", "label": "Answer 1: link to the safety section", "info": "Blank hides the link.", "default": "Read the full safety profile" },
    { "type": "text", "id": "quick_q2", "label": "Question 2", "default": "Will my picky eater actually take it?" },
    { "type": "textarea", "id": "quick_a2", "label": "Answer 2", "default": "It has a natural raspberry flavour and mixes straight into orange juice, milk or a smoothie, so most kids drink it without a fuss. First time? Start with half a dropper for a few days." },
    { "type": "text", "id": "quick_q3", "label": "Question 3", "default": "How often do they take it, and when will we see results?" },
