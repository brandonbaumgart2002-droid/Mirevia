{%- comment -%}
  Scrolling announcement bar. Self-contained (inline CSS + a few lines of JS) so it can sit in the
  header group on every page without loading the PDP stylesheet or script.
  The items are repeated so the loop is seamless on wide screens; only the first copy is read by screen readers.
  It pauses on hover, on keyboard focus and with the pause button, and stays still when the visitor prefers reduced motion.
{%- endcomment -%}
{%- liquid
  assign items = section.settings.text | split: '|'
  assign copies = 4
  case section.settings.style
    when 'ink'
      assign bar_bg = '#1e2d4f'
      assign bar_fg = '#ffffff'
    when 'soft'
      assign bar_bg = '#ebf4ef'
      assign bar_fg = '#2c5a4a'
    else
      assign bar_bg = '#3b7560'
      assign bar_fg = '#ffffff'
  endcase
-%}
<style>
  .pp-bar { --pp-bar-bg: {{ bar_bg }}; --pp-bar-fg: {{ bar_fg }}; position: relative; display: flex; align-items: center; overflow: hidden; min-height: 38px; background: var(--pp-bar-bg); color: var(--pp-bar-fg); font-size: 13px; font-weight: 500; line-height: 1.35; letter-spacing: .01em; }
  @media (min-width: 640px) { .pp-bar { font-size: 14px; } }
  .pp-bar[hidden] { display: none; }
  .pp-bar__track { display: flex; width: max-content; animation: pp-bar var(--pp-bar-duration, 28s) linear infinite; will-change: transform; }
  .pp-bar__group { display: flex; flex-shrink: 0; align-items: center; margin: 0; padding: 0; list-style: none; }
  .pp-bar__item { display: inline-flex; align-items: center; margin: 0; padding: 9px 0; white-space: nowrap; }
  .pp-bar__item::after { content: ""; width: 5px; height: 5px; margin: 0 22px; border-radius: 50%; background: currentColor; opacity: .55; }
  .pp-bar__pill { display: inline-flex; align-items: center; padding: 3px 12px; border-radius: 999px; background: #f4c7d5; color: #1e2d4f; font-weight: 800; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  .pp-bar:hover .pp-bar__track, .pp-bar:focus-within .pp-bar__track, .pp-bar.is-paused .pp-bar__track { animation-play-state: paused; }
  .pp-bar__toggle { all: unset; box-sizing: border-box; position: absolute; top: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; width: 44px; cursor: pointer; color: inherit; background: var(--pp-bar-bg); box-shadow: -16px 0 16px 0 var(--pp-bar-bg); }
  .pp-bar__toggle:focus-visible { outline: 2px solid currentColor; outline-offset: -6px; border-radius: 8px; }
  .pp-bar__toggle svg { display: block; }
  .pp-bar__toggle .pp-bar__play, .pp-bar.is-paused .pp-bar__toggle .pp-bar__pause { display: none; }
  .pp-bar.is-paused .pp-bar__toggle .pp-bar__play { display: block; }
  @keyframes pp-bar { to { transform: translateX(calc(-100% / {{ copies }})); } }
  @media (prefers-reduced-motion: reduce) {
    .pp-bar { justify-content: center; }
    .pp-bar__track { animation: none; width: auto; max-width: 100%; justify-content: center; padding: 0 16px; }
    .pp-bar__group { flex-wrap: wrap; justify-content: center; flex-shrink: 1; }
    .pp-bar__group[aria-hidden="true"], .pp-bar__toggle { display: none; }
    .pp-bar__item { padding: 4px 0; }
    .pp-bar__item::after { margin: 0 12px; }
    .pp-bar__item:last-child::after { display: none; }
  }
</style>
{%- comment -%}
  Sale mode: when a sale end is set, a centred sale bar with a live countdown replaces the scrolling items.
  Once the end time passes the countdown bar hides itself and the scrolling items show instead.
{%- endcomment -%}
{%- liquid
  assign sale_on = false
  if section.settings.sale_title != blank and section.settings.sale_end_date != blank
    assign sale_on = true
    assign sale_end = section.settings.sale_end_date | append: 'T' | append: section.settings.sale_end_time | append: ':00' | append: section.settings.sale_utc_offset
  endif
-%}
{%- if sale_on -%}
<style>
  .pp-sale { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 4px 14px; padding: 8px 12px; background: #1F2A5A; color: #fff; font-family: 'Nunito Sans', system-ui, sans-serif; text-align: center; line-height: 1.25; }
  .pp-sale[hidden] { display: none; }
  .pp-sale__hd { font-family: 'Nunito', 'Nunito Sans', system-ui, sans-serif; font-weight: 900; font-size: 14px; letter-spacing: .08em; text-transform: uppercase; color: #9FE0C9; white-space: nowrap; }
  .pp-sale__msg { font-weight: 800; font-size: 13.5px; }
  .pp-sale__msg strong { color: #FFB8CC; font-weight: 900; }
  .pp-sale .pp-sale__hd { color: #9FE0C9 !important; font-family: 'Nunito', 'Nunito Sans', system-ui, sans-serif !important; font-weight: 900 !important; letter-spacing: .08em !important; margin: 0 !important; }
  .pp-sale .pp-sale__msg, .pp-sale .pp-sale__msg p { display: inline; margin: 0 !important; padding: 0 !important; color: #fff !important; font-size: inherit !important; line-height: inherit !important; }
  .pp-sale .pp-sale__msg strong { color: #FFB8CC !important; }
  .pp-sale__lead { display: inline-flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 2px 10px; }
  @media (max-width: 639px) { .pp-sale { padding: 7px 10px; gap: 5px 10px; } .pp-sale__hd { font-size: 12.5px; } .pp-sale__msg { font-size: 12.5px; } .pp-sale__unit { min-width: 30px; padding: 2px 5px; } .pp-sale__unit b { font-size: 13px; } }
  .pp-sale__timer { display: inline-flex; align-items: center; gap: 5px; font-weight: 800; font-size: 12px; white-space: nowrap; }
  .pp-sale__unit { display: inline-flex; align-items: baseline; gap: 1px; min-width: 34px; justify-content: center; padding: 3px 6px; border-radius: 6px; background: #C73862; color: #fff; font-variant-numeric: tabular-nums; }
  .pp-sale__unit b { font-size: 14px; font-weight: 900; }
  .pp-sale__unit i { font-style: normal; font-size: 10px; font-weight: 800; opacity: .9; }
  @media (min-width: 640px) { .pp-sale { gap: 6px 18px; padding: 9px 16px; } .pp-sale__hd { font-size: 15px; } .pp-sale__msg { font-size: 15px; } .pp-sale__unit b { font-size: 15px; } }
</style>
<div class="pp-sale" data-pp-sale data-end="{{ sale_end }}" role="region" aria-label="{{ section.settings.sale_title | escape }}">
  <span class="pp-sale__lead"><span class="pp-sale__hd">{{ section.settings.sale_title }}</span>
  <span class="pp-sale__msg">{{ section.settings.sale_message | remove: '<p>' | remove: '</p>' }}</span></span>
  <span class="pp-sale__timer" data-pp-sale-timer>{{ section.settings.sale_timer_label }}
    <span class="pp-sale__unit"><b data-d>--</b><i>d</i></span><span class="pp-sale__unit"><b data-h>--</b><i>h</i></span><span class="pp-sale__unit"><b data-m>--</b><i>m</i></span><span class="pp-sale__unit"><b data-s>--</b><i>s</i></span>
  </span>
</div>
<script>
  (function () {
    var bar = document.currentScript.previousElementSibling, end = Date.parse(bar.getAttribute('data-end'));
    var scroll = bar.parentNode.querySelector('[data-pp-bar]');
    if (isNaN(end)) return;
    var q = function (k) { return bar.querySelector('[data-' + k + ']'); }, pad = function (n) { return n < 10 ? '0' + n : '' + n; };
    function tick() {
      var t = Math.floor((end - Date.now()) / 1000);
      if (t <= 0) { bar.hidden = true; if (scroll) scroll.hidden = false; clearInterval(iv); return; }
      q('d').textContent = pad(Math.floor(t / 86400)); q('h').textContent = pad(Math.floor(t % 86400 / 3600));
      q('m').textContent = pad(Math.floor(t % 3600 / 60)); q('s').textContent = pad(t % 60);
      if (scroll) scroll.hidden = true;
    }
    var iv = setInterval(tick, 1000); tick();
  })();
</script>
{%- endif -%}
{%- if items.size > 0 -%}
  <div class="pp-bar" data-pp-bar role="region" aria-label="Offers" style="--pp-bar-duration: {{ section.settings.speed }}s;"{% if sale_on %} hidden{% endif %}>
    <div class="pp-bar__track">
      {%- for copy in (1..copies) -%}
        <ul class="pp-bar__group"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
          {%- for item in items -%}
            {%- assign t = item | strip -%}
            {%- if t != blank -%}
              {%- assign first = t | slice: 0 -%}
              {%- if first == '!' -%}
                <li class="pp-bar__item pp-bar__item--hi"><span class="pp-bar__pill">{{ t | remove_first: '!' | strip }}</span></li>
              {%- else -%}
                <li class="pp-bar__item">{{ t }}</li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
    <button type="button" class="disable-global-button-styling pp-bar__toggle" data-pp-bar-toggle aria-pressed="false" aria-label="Pause scrolling offers">
      <svg class="pp-bar__pause" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><rect x="2" y="1.5" width="2.5" height="9" rx="1" fill="currentColor"/><rect x="7.5" y="1.5" width="2.5" height="9" rx="1" fill="currentColor"/></svg>
      <svg class="pp-bar__play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M3 1.8v8.4a.6.6 0 0 0 .9.5l6.6-4.2a.6.6 0 0 0 0-1L3.9 1.3a.6.6 0 0 0-.9.5Z" fill="currentColor"/></svg>
    </button>
  </div>
  <script>
    (function () {
      if (window.__ppBar) return;
      window.__ppBar = true;
      document.addEventListener('click', function (e) {
        var btn = e.target.closest && e.target.closest('[data-pp-bar-toggle]');
        if (!btn) return;
        var paused = btn.closest('[data-pp-bar]').classList.toggle('is-paused');
        btn.setAttribute('aria-pressed', paused ? 'true' : 'false');
        btn.setAttribute('aria-label', paused ? 'Play scrolling offers' : 'Pause scrolling offers');
      });
    })();
  </script>
{%- endif -%}
{% schema %}
{
  "name": "ParaPatrol: announcement",
  "settings": [
    { "type": "header", "content": "Sale countdown" },
    { "type": "paragraph", "content": "With a title and an end date set, a sale bar with a live countdown replaces the scrolling text until the end time, then the scrolling text comes back." },
    { "type": "text", "id": "sale_title", "label": "Sale title", "info": "e.g. 🎉 Black Friday 🎉. Blank turns the sale bar off." },
    { "type": "richtext", "id": "sale_message", "label": "Sale message", "info": "Bold text shows in pink." },
    { "type": "text", "id": "sale_timer_label", "label": "Timer label", "default": "Ends in" },
    { "type": "text", "id": "sale_end_date", "label": "End date (YYYY-MM-DD)" },
    { "type": "text", "id": "sale_end_time", "label": "End time (HH:MM, 24-hour)", "default": "23:59" },
    { "type": "text", "id": "sale_utc_offset", "label": "Time zone offset", "default": "+11:00", "info": "+11:00 is AEDT (Sydney, Melbourne, Canberra, Hobart in summer)." },
    { "type": "header", "content": "Scrolling text" },
    { "type": "text", "id": "text", "label": "Text (separate items with |)", "info": "Start an item with ! to show it as a highlighted pill, e.g. !Back to School Sale", "default": "!Back to School Sale | Free shipping on all orders | 30-day money-back guarantee" },
    { "type": "range", "id": "speed", "label": "Seconds per loop", "info": "Higher is slower.", "min": 10, "max": 60, "step": 2, "unit": "s", "default": 28 },
    { "type": "select", "id": "style", "label": "Colour", "default": "primary", "options": [
      { "value": "primary", "label": "Brand green" },
      { "value": "ink", "label": "Navy" },
      { "value": "soft", "label": "Soft sage" }
    ] }
  ],
  "presets": [ { "name": "ParaPatrol: announcement" } ]
}
{% endschema %}
