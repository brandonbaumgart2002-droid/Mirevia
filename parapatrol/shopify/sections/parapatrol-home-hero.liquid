{%- comment -%}
  Home page hero for ParaPatrol: offer pill, one promise, rating, one action, three reassurances.
  Phones: photo first (square), words under it. Desktop: words left, photo right.
  The photo is the LCP image, so it loads eagerly with high priority.
  Any tummy or appetite claim in the text keeps its * so it links to the FDA disclaimer section on the page.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign hero_product = s.product
  assign hero_url = s.button_link | default: hero_product.url | default: routes.all_products_collection_url
  assign ticks = s.ticks | newline_to_br | split: '<br />'
-%}
{{ 'parapatrol.css' | asset_url | stylesheet_tag }}
<div class="pp">
  <section class="bg-soft" aria-labelledby="pp-home-{{ section.id }}">
    <div class="max-w-6xl mx-auto px-4 py-6 sm:py-10 lg:py-16 grid gap-6 lg:gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:items-center">
      <div class="order-1 lg:order-2 min-w-0">
        {%- render 'parapatrol-media', image: s.image, asset: s.asset, label: 'Hero photo', alt: s.alt, class: 'aspect-[16/11] sm:aspect-[4/3] lg:aspect-square rounded-3xl shadow-lift', sizes: '(min-width: 1152px) 560px, (min-width: 1024px) 50vw, 100vw', loading: 'eager', priority: true -%}
      </div>

      <div class="order-2 lg:order-1 min-w-0">
        {%- if s.badge != blank -%}
          <p class="inline-flex items-center rounded-full bg-accent px-3.5 py-1 text-[12px] sm:text-[13px] font-extrabold uppercase tracking-[.08em] text-ink">{{ s.badge }}</p>
        {%- endif -%}
        <h1 id="pp-home-{{ section.id }}" class="mt-3 font-display font-bold text-[38px] sm:text-[50px] lg:text-[58px] leading-[1.04] text-ink">{{ s.heading | newline_to_br }}</h1>
        {%- if s.text != blank -%}
          <p class="mt-3 text-[17px] sm:text-[19px] leading-relaxed text-ink/90 max-w-xl">{%- render 'parapatrol-claim', text: s.text -%}</p>
        {%- endif -%}

        {%- if s.rating_score != blank -%}
          <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-[15px]">
            {%- render 'parapatrol-stars', score: s.rating_score, size: 18 -%}
            <span class="font-bold text-ink">{{ s.rating_score }} out of 5</span>
            {%- if s.rating_note != blank -%}<span class="text-muted">· {{ s.rating_note }}</span>{%- endif -%}
          </p>
        {%- endif -%}

        <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2">
          <a href="{{ hero_url }}" class="inline-flex grow sm:grow-0 items-center justify-center gap-2 min-h-[56px] px-8 rounded-full bg-primary text-white font-extrabold text-[17px] shadow-lift hover:bg-primary-dark transition-colors">
            {{- s.button_label | default: 'Shop ParaPatrol' -}}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          {%- if s.link_label != blank -%}
            <a href="{{ s.link_url | default: routes.all_products_collection_url }}" class="inline-flex items-center justify-center min-h-[48px] px-4 font-bold text-[16px] text-primary-dark underline underline-offset-4 hover:text-primary">{{ s.link_label }}</a>
          {%- endif -%}
        </div>

        {%- if s.ticks != blank -%}
          <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-[14px] sm:text-[15px] text-ink" role="list">
            {%- for t in ticks -%}
              {%- assign tick = t | strip -%}
              {%- if tick != blank -%}
                <li class="inline-flex items-center gap-1.5"><span class="text-primary">{%- render 'parapatrol-icon', name: 'check', icon_size: 16 -%}</span>{%- render 'parapatrol-claim', text: tick -%}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "ParaPatrol: home hero",
  "settings": [
    { "type": "text", "id": "badge", "label": "Offer pill", "default": "Back to School Sale" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Happy tummies, made easy." },
    { "type": "textarea", "id": "text", "label": "Text", "info": "Keep a * on anything about tummy or appetite.", "default": "Gentle herbal drops for kids 3+. One easy drop in their morning juice keeps busy little tummies on track.*" },
    { "type": "text", "id": "rating_score", "label": "Star rating (out of 5)", "info": "Only your real average. Leave blank to hide.", "default": "4.8" },
    { "type": "text", "id": "rating_note", "label": "Rating note", "default": "237+ parent reviews" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop ParaPatrol" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Uses the product's page when empty." },
    { "type": "text", "id": "link_label", "label": "Second link label", "default": "Shop all" },
    { "type": "url", "id": "link_url", "label": "Second link" },
    { "type": "textarea", "id": "ticks", "label": "Reassurances (one per line)", "default": "Free shipping on all orders\n30-day money-back guarantee\nMade for kids 3+" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "asset", "label": "Built-in image file", "info": "Used when no image is chosen. A file in the theme's assets folder.", "default": "pp-school-door.jpg" },
    { "type": "text", "id": "alt", "label": "Image description (for screen readers)", "default": "A mum zips up her son's jacket before school, ParaPatrol and a lunchbox on the hall table" }
  ],
  "presets": [ { "name": "ParaPatrol: home hero" } ]
}
{% endschema %}
