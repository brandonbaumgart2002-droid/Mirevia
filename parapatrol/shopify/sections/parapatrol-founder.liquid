{%- comment -%} Founder trust strip + trust badges. {%- endcomment -%}
{{ 'parapatrol.css' | asset_url | stylesheet_tag }}
{%- assign badges = section.settings.badges | split: ',' -%}
<div class="pp">
  <section class="py-14 lg:py-20" aria-labelledby="pp-fdr-{{ section.id }}">
    <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-[minmax(0,0.9fr)_1.1fr] gap-8 items-center">
      {%- render 'parapatrol-media', image: section.settings.image, label: section.settings.image_label, alt: 'Jason and Tara Pratt, JoySpring founders, with their kids', class: 'aspect-[4/3] rounded-3xl', sizes: '(min-width: 768px) 480px, 100vw' -%}
      <div>
        <h2 id="pp-fdr-{{ section.id }}" class="font-display font-semibold text-[30px] sm:text-[38px] leading-[1.1]">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="mt-3 text-[17px] text-ink/90 max-w-lg">{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.badges_image != blank -%}
          {{ section.settings.badges_image | image_url: width: 1000 | image_tag: alt: section.settings.badges, class: 'mt-6 w-full max-w-lg', loading: 'lazy' }}
        {%- elsif badges.size > 0 -%}
          <ul class="mt-6 grid grid-cols-2 sm:grid-cols-3 gap-2.5" aria-label="Quality and trust">
            {%- for b in badges -%}
              <li class="flex items-center gap-2 rounded-xl border border-line px-3 py-2.5 text-[14px] font-bold"><span class="text-primary shrink-0">{%- render 'parapatrol-icon', name: 'check', icon_size: 18 -%}</span>{{ b | strip }}</li>
            {%- endfor -%}
          </ul>
          {%- if section.settings.badges_note != blank -%}<p class="mt-3 text-[12px] text-muted">{{ section.settings.badges_note }}</p>{%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "ParaPatrol: founder strip",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Founder photo" },
    { "type": "text", "id": "image_label", "label": "Image placeholder label", "default": "Jason & Tara Pratt with their kids" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made by parents, for parents." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Jason and Tara Pratt started JoySpring when they couldn’t find natural options they trusted for their own kids." },
    { "type": "text", "id": "badges", "label": "Trust badges (comma separated)", "default": "Made in USA, Third-party tested, Clean Label Project, Sugar-free, Gluten-free, cGMP facility" },
    { "type": "image_picker", "id": "badges_image", "label": "Official badge artwork (replaces text badges)" },
    { "type": "text", "id": "badges_note", "label": "Note under badges", "default": "[IMG: swap text badges for official Clean Label Project and Made in USA marks]" }
  ],
  "presets": [ { "name": "ParaPatrol: founder strip" } ]
}
{% endschema %}
