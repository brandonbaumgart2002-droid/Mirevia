  {%- when 'shield-alert' -%}<path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z"/><path d="M12 9v4M12 16v.5"/>
  {%- when 'check' -%}<path d="m5 12 5 5 9-10"/>
  {%- when 'lock' -%}<rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/><path d="M12 14.5v2.5"/>
  {%- when 'truck' -%}<path d="M3 6.5h11v9H3z"/><path d="M14 9.5h4l3 3.5v2.5h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
  {%- when 'info' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 16.5v.5"/>
  {%- when 'bulb' -%}<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.4 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3Z"/>
  {%- when 'heart' -%}<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"/>
  {%- else -%}<circle cx="12" cy="12" r="8"/>
{%- endcase -%}
</svg>
