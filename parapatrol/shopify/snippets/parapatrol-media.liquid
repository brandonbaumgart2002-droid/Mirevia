{%- comment -%}
  Image, or a clearly labelled placeholder box when no image is set.
  Params: image (image object, optional), label (placeholder text), alt, class, sizes, loading
{%- endcomment -%}
{%- liquid
  assign pp_alt = alt | default: label
  assign pp_loading = loading | default: 'lazy'
-%}
{%- if image != blank -%}
  <div class="media-fill overflow-hidden bg-mint {{ class }}">
    {{- image | image_url: width: 1600 | image_tag: alt: pp_alt, loading: pp_loading, sizes: sizes, widths: '375, 550, 750, 1100, 1500', class: 'w-full h-full object-cover' -}}
  </div>
{%- else -%}
  <div class="ph {{ class }}" role="img" aria-label="{{ pp_alt | escape }} (image placeholder)">[IMG: {{ label }}]</div>
{%- endif -%}
