{%- comment -%}
  Final CTA button: scrolls back up to the main buy box (#pp-buy) and moves focus to its Add to Bag.
  Params: label, note (small line under the button)
{%- endcomment -%}
<a href="#pp-buy" data-pp-to-buy class="mt-6 inline-flex w-full sm:w-auto items-center justify-center gap-2 min-h-[56px] px-8 rounded-full bg-white text-primary-dark font-bold text-[17px] shadow-lift hover:bg-soft transition-colors">
  {{- label | default: 'Shop ParaPatrol' -}}
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
</a>
{%- if note != blank -%}
  <p class="mt-3 text-[14px] leading-snug text-white/90"><span class="inline-block align-[-3px] mr-1.5">{%- render 'parapatrol-icon', name: 'shield', icon_size: 16 -%}</span>{{ note }}</p>
{%- endif -%}
